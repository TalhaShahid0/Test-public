SELECT YEAR(CONTACT_DATE) AS yr, COUNT(*) AS cnt
FROM ALLERGY_DELTA.TBL_ALLERGY_MEDS
WHERE IS_DELETED = 0
GROUP BY YEAR(CONTACT_DATE)
ORDER BY yr;

SELECT COALESCE(IS_ACTIVE_YN, 'NULL') AS a, COUNT(*) AS cnt
FROM ALLERGY_DELTA.TBL_ALLERGY_MEDS
WHERE IS_DELETED = 0
GROUP BY COALESCE(IS_ACTIVE_YN, 'NULL');
