pipeline_configs = [
    {
        "pipeline_name": "TBL_LAB_RESULT_MULTILINE_VALUES",
        "target_table": "ALLERGY_LH.ALLERGY_DELTA.TBL_LAB_RESULT_MULTILINE_VALUES",
        "batch_table": "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES",
        "source_query": """
            SELECT rdb.res_order_id                          AS order_proc_id,
                   rc.component_id,
                   COALESCE(cc.external_name, cc.name)       AS componentname,
                   REGEXP_REPLACE(
                       CONCAT_WS(' ',
                           TRANSFORM(
                               SORT_ARRAY(
                                   COLLECT_LIST(STRUCT(dta.group_line AS grp, dta.value_line AS val, dta.mult_ln_val_storage AS txt))
                               ),
                               x -> x.txt
                           )
                       ),
                       '<[/]?A>',
                       ''
                   ) AS result_text
            FROM   mv_allergy_labs_pop pp
                   INNER JOIN clarity_lh.clarity.res_db_main rdb
                           ON pp.order_proc_id = rdb.res_order_id
                   INNER JOIN clarity_lh.clarity.res_components rc
                           ON rdb.result_id = rc.result_id
                          AND pp.component_id = rc.component_id
                   INNER JOIN clarity_lh.clarity.clarity_component cc
                           ON rc.component_id = cc.component_id
                   INNER JOIN clarity_lh.clarity.res_val_ptr_rm ptr
                           ON rc.result_id = ptr.result_id
                          AND rc.line = ptr.group_line
                   INNER JOIN clarity_lh.clarity.res_val_data_rm dta
                           ON ptr.result_id = dta.result_id
                          AND ptr.cmp_multiline_value = dta.group_line
            GROUP BY rdb.res_order_id,
                     rc.component_id,
                     COALESCE(cc.external_name, cc.name)
        """,
        "primary_keys": "",
        "non_key_columns": "COMPONENTNAME, RESULT_TEXT",
        "identity_column": "ORDER_PROC_ID",
        "load_type": "FULL",
    }
]
