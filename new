# ============================================================================
# CHECK_PLANS (2026-11-13). READ ONLY: writes nothing, changes no table.
# Part 1 + 2 take about 1-3 minutes, part 3 (row counts) about 2-5 minutes.
#
# 1. For every pipeline it asks Spark only for the PLAN of the source query
#    (the query itself does not run), with the same Spark settings as a
#    pipeline run, and lists the big source tables (0.5 GB or more):
#      FULL shuffle   = the whole table is moved between the machines
#                       (this is what NOTES_C did with the note text before v4)
#      shuffled after a filter
#                     = it is first joined to a small list that is sent to
#                       every machine (broadcast), then only those rows move
#      broadcast      = the table itself is sent to every machine
#      not moved      = read and joined where it is
# 2. Whether the "max key in target" step can read the max from the Delta
#    statistics instead of reading the whole target table.
# 3. A few row counts that decide if a list is small enough to broadcast.
#
# HOW TO RUN (a new notebook in the same workspace, 3 cells):
#   CELL 1:  %run MERGE_NB      (the same MERGE notebook the pipeline uses)
#   CELL 2:  %run CONFIG_NB     (the same CONFIG notebook the pipeline uses)
#   CELL 3:  this file. Send the whole output (2-3 screenshots are fine).
# Run it in the daytime, not while the nightly pipeline runs.
# ============================================================================

import re
import time

BIG_GB = 0.5        # smaller tables are not listed
COUNTS = True       # part 3 (row counts)

configure_spark_for_efficiency()          # the same Spark settings as a pipeline run
_AQE = spark.conf.get("spark.sql.adaptive.enabled")


def _kids(n):
    c = n.children()
    return [c.apply(i) for i in range(c.size())]


_sizes = {}


def _scan_table(n):
    """(TABLE NAME, size in GB or None) of a scan node."""
    nn = n.nodeName()
    full = ""
    try:
        if n.tableIdentifier().isDefined():
            full = n.tableIdentifier().get().unquotedString()
    except Exception:
        pass
    if not full:
        parts = nn.split(" ")
        full = parts[-1] if len(parts) >= 3 and "." in parts[-1] else ""
    if not full:
        m = re.search(r"/Tables/(?:\w+/)?(\w+)", n.simpleString(1000))
        full = m.group(1) if m else nn
    full = full.replace("`", "")
    if full not in _sizes:
        gb = None
        try:
            gb = n.relation().sizeInBytes() / 1e9
        except Exception:
            try:
                gb = spark.sql(f"DESCRIBE DETAIL {full}").collect()[0]["sizeInBytes"] / 1e9
            except Exception:
                gb = None
        _sizes[full] = gb
    return full.split(".")[-1].upper(), _sizes[full]


def _is_scan(n):
    return "Scan" in n.nodeName() and not _kids(n)


def _tables_under(n, out):
    if _is_scan(n):
        out.append(_scan_table(n)[0])
    if n.nodeName() == "ReusedExchange":          # the same broadcast used a second time
        try:
            _tables_under(n.child(), out)
        except Exception:
            pass
    for k in _kids(n):
        _tables_under(k, out)
    return out


def _keys(exchange):
    s = exchange.simpleString(400)
    m = re.search(r"hashpartitioning\((.*), \d+\)", s)
    if m:
        k = re.sub(r"#\d+L?", "", m.group(1))
        return k if len(k) <= 60 else k[:57] + "..."
    m = re.search(r"Exchange (\w+)", s)
    return m.group(1) if m else "?"


def _walk(n, ctx, res, cnt):
    """ctx: None = no shuffle above (the query result side),
            {"bc": True} = inside a broadcast,
            {"keys": ..., "bhj": [[tables], ...]} = below a shuffle."""
    nn = n.nodeName()
    if nn in ("Exchange", "ShuffleExchange"):
        cnt["shuffles"] += 1
        for k in _kids(n):
            _walk(k, {"keys": _keys(n), "bhj": []}, res, cnt)
        return
    if nn == "BroadcastExchange":
        cnt["broadcasts"] += 1
        for k in _kids(n):
            _walk(k, {"bc": True}, res, cnt)
        return
    if nn == "ReusedExchange":
        return
    if _is_scan(n):
        t, gb = _scan_table(n)
        res.append((t, gb, ctx))
        return
    if nn == "BroadcastHashJoin":
        s = n.simpleString(400)
        kids = _kids(n)
        b = 0 if "BuildLeft" in s else 1
        jt = re.search(r"\], (\w+), Build", s)
        jt = jt.group(1) if jt else ""
        if ctx is not None and "keys" in ctx and jt in ("Inner", "LeftSemi", "LeftAnti", "RightSemi"):
            inner = dict(ctx, bhj=ctx["bhj"] + [sorted(set(_tables_under(kids[b], [])))])
        else:
            inner = ctx
        _walk(kids[1 - b], inner, res, cnt)
        _walk(kids[b], ctx, res, cnt)
        return
    for k in _kids(n):
        _walk(k, ctx, res, cnt)


def _fmt_gb(gb):
    return "?" if gb is None else f"{gb:.1f}"


def _plan_report(cfg):
    t0 = time.time()
    spark.conf.set("spark.sql.adaptive.enabled", "false")     # static plan only
    try:
        plan = spark.sql(cfg["source_query"])._jdf.queryExecution().executedPlan()
    finally:
        spark.conf.set("spark.sql.adaptive.enabled", _AQE)
    res, cnt = [], {"shuffles": 0, "broadcasts": 0}
    _walk(plan, None, res, cnt)
    full, filt, bcast, still = {}, {}, {}, {}
    for t, gb, ctx in res:
        if gb is not None and gb < BIG_GB:
            continue
        if ctx is None:
            still[t] = gb
        elif ctx.get("bc"):
            bcast[t] = gb
        elif not ctx["bhj"]:
            full.setdefault((t, gb), set()).add(ctx["keys"])
        else:
            filt.setdefault((t, gb), set()).update(x for b in ctx["bhj"] for x in b)
    lines = []
    if full:
        lines.append("   FULL shuffle  : " + ", ".join(
            f"{t} {_fmt_gb(gb)} GB (by {' / '.join(sorted(k))})"
            for (t, gb), k in sorted(full.items(), key=lambda x: -(x[0][1] or 0))))
    if filt:
        lines.append("   after a filter: " + ", ".join(
            f"{t} {_fmt_gb(gb)} GB (broadcast of {', '.join(sorted(l)[:4])}{', ...' if len(l) > 4 else ''})"
            for (t, gb), l in sorted(filt.items(), key=lambda x: -(x[0][1] or 0))))
    if bcast:
        lines.append("   broadcast     : " + ", ".join(
            f"{t} {_fmt_gb(gb)} GB" for t, gb in sorted(bcast.items(), key=lambda x: -(x[1] or 0))))
    if still:
        lines.append("   not moved     : " + ", ".join(
            f"{t} {_fmt_gb(gb)} GB" for t, gb in sorted(still.items(), key=lambda x: -(x[1] or 0))))
    head = (f"{cfg['pipeline_name']}  ({cnt['shuffles']} shuffles, {cnt['broadcasts']} broadcasts, "
            f"plan {time.time() - t0:.0f} s)")
    return head, lines


