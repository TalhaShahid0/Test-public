-- Oracle
SELECT COUNT(*) FROM ALLERGY.MV_ALLERGY_MEDS;
SELECT COUNT(DISTINCT pat_id) FROM ALLERGY.MV_PAT_ID;

-- Fabric
SELECT COUNT(*), COUNT(DISTINCT ROW_HASH)
FROM ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_MEDS WHERE IS_DELETED = 0;

SELECT COUNT(DISTINCT PAT_ID) FROM (
  SELECT PAT_ID, IS_DELETED, ROW_NUMBER() OVER (PARTITION BY ROW_HASH
         ORDER BY DW_UPDATED_AT DESC, BATCH_ID DESC) rn
  FROM ALLERGY_LH.ALLERGY_DELTA.TBL_PAT_ID) t
WHERE rn = 1 AND COALESCE(IS_DELETED, 0) = 0;
