# ---- 2. max key -------------------------------------------------------------
print("=" * 78)
print("2. MAX KEY: read from the Delta statistics (fast) or by reading the table")
print("=" * 78)
_fast, _slow = [], []
for _cfg in pipeline_configs:
    _idc, _tgt = _cfg.get("identity_column"), _cfg["target_table"]
    if not _idc:
        continue
    try:
        _cols = [f.name.upper() for f in spark.table(_tgt).schema.fields]
        if _idc.upper() not in _cols:
            continue
        _p = spark.sql(f"SELECT MAX({_idc}) FROM {_tgt}")._jdf.queryExecution().executedPlan().toString()
        _nm = _cfg["pipeline_name"].replace("TBL_ALLERGY_", "").replace("TBL_", "")
        if "LocalTableScan" in _p and "Scan" not in _p.replace("LocalTableScan", ""):
            _fast.append(_nm)
        else:
            _slow.append(f"{_nm} (key = column {_cols.index(_idc.upper()) + 1} of {len(_cols)})")
    except Exception as e:
        _slow.append(f"{_cfg['pipeline_name']} (error {str(e)[:60]})")
print(f"from statistics ({len(_fast)}): " + ", ".join(_fast))
print(f"reads the table ({len(_slow)}): " + ", ".join(_slow))

