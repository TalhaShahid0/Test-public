SELECT PIPELINE_NAME, BATCH_ID, STATUS, BATCH_START_DTTM, BATCH_END_DTTM,
       unix_timestamp(BATCH_END_DTTM) - unix_timestamp(BATCH_START_DTTM) AS DURATION_SEC,
       ROUND((unix_timestamp(BATCH_END_DTTM) - unix_timestamp(BATCH_START_DTTM)) / 60.0, 2) AS DURATION_MIN
FROM ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES
WHERE BATCH_END_DTTM IS NOT NULL
ORDER BY BATCH_START_DTTM DESC
