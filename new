print(f"1. PLANS (tables of {BIG_GB} GB or more)")
print("=" * 78)
_small = []
for _cfg in pipeline_configs:
    try:
        _head, _lines = _plan_report(_cfg)
    except Exception as e:
        print(f"{_cfg['pipeline_name']}: could not plan: {str(e)[:150]}")
        continue
    if _lines:
        print(_head)
        for _l in _lines:
            print(_l)
