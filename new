# One-time check (read only, ~1-3 min). Paste into a NEW notebook cell, run it,
# and send the whole output. It changes nothing.
# It shows how big one Spark session is (executors / cores) and how big the
# tables behind MEDS and NOTES_C are, so the next speed steps can be sized.

sc = spark.sparkContext
conf = sc.getConf()
n_exec = max(sc._jsc.sc().getExecutorMemoryStatus().size() - 1, 0)
print("== session")
print("spark version:", spark.version)
print("executors now:", n_exec, "| defaultParallelism (total cores):", sc.defaultParallelism)
for k in ["spark.executor.cores", "spark.executor.memory", "spark.driver.cores", "spark.driver.memory",
          "spark.dynamicAllocation.enabled", "spark.dynamicAllocation.minExecutors",
          "spark.dynamicAllocation.maxExecutors", "spark.sql.shuffle.partitions",
          "spark.sql.autoBroadcastJoinThreshold", "spark.sql.adaptive.enabled",
          "spark.native.enabled", "spark.gluten.enabled"]:
    print(f"{k} = {conf.get(k, spark.conf.get(k, 'not set'))}")

print("== tables (Delta metadata only, no full scan)")
tables = [
    "CLARITY_LH.CLARITY.HNO_NOTE_TEXT", "CLARITY_LH.CLARITY.HNO_INFO", "CLARITY_LH.CLARITY.NOTE_ENC_INFO",
    "CLARITY_LH.CLARITY.PAT_ENC_CURR_MEDS", "CLARITY_LH.CLARITY.PAT_ENC_IP_MEDS", "CLARITY_LH.CLARITY.ORDER_MED",
    "CLARITY_LH.CLARITY.MDL_MD_PRBLM_LIST", "CLARITY_LH.CLARITY.CLARITY_MEDICATION",
    "CLARITY_LH.CLARITY.PAT_ENC", "CLARITY_LH.CLARITY.PATIENT",
    "ALLERGY_LH.ALLERGY_DELTA.TBL_PAT_ID", "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_PAT_ENC",
    "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_MEDS", "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_NOTES_C",
]
for t in tables:
    try:
        d = spark.sql(f"DESCRIBE DETAIL {t}").collect()[0]
        print(f"{t}: {d['sizeInBytes'] / 2**30:.1f} GB in {d['numFiles']} files")
    except Exception as e:
        print(f"{t}: could not read ({str(e)[:120]})")

print("== cohort (small tables, quick)")
for name, q in [
    ("active cohort patients (TBL_PAT_ID)",
     """SELECT COUNT(DISTINCT PAT_ID) FROM (SELECT PAT_ID, IS_DELETED, ROW_NUMBER() OVER (PARTITION BY ROW_HASH
        ORDER BY DW_UPDATED_AT DESC, BATCH_ID DESC) rn FROM ALLERGY_LH.ALLERGY_DELTA.TBL_PAT_ID) t
        WHERE rn = 1 AND COALESCE(IS_DELETED, 0) = 0"""),
    ("active cohort encounters (TBL_ALLERGY_PAT_ENC)",
     """SELECT COUNT(DISTINCT PAT_ENC_CSN_ID) FROM (SELECT PAT_ENC_CSN_ID, IS_DELETED, ROW_NUMBER() OVER (PARTITION BY ROW_HASH
        ORDER BY DW_UPDATED_AT DESC, BATCH_ID DESC) rn FROM ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_PAT_ENC) t
        WHERE rn = 1 AND COALESCE(IS_DELETED, 0) = 0"""),
    ("notes in NOTES_C target (all versions)",
     "SELECT COUNT(DISTINCT NOTE_ID) FROM ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_NOTES_C"),
]:
    try:
        print(f"{name}: {spark.sql(q).collect()[0][0]:,}")
    except Exception as e:
        print(f"{name}: could not read ({str(e)[:120]})")
