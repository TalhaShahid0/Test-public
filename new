SELECT PIPELINE_NAME, BATCH_ID, STATUS, BATCH_START_DTTM, BATCH_END_DTTM,
       DATEDIFF(SECOND, BATCH_START_DTTM, BATCH_END_DTTM) AS DURATION_SEC,
       CAST(DATEDIFF(SECOND, BATCH_START_DTTM, BATCH_END_DTTM) / 60.0 AS DECIMAL(10,2)) AS DURATION_MIN
FROM ALLERGY_DELTA.ALLERGY_BATCHES
WHERE BATCH_END_DTTM IS NOT NULL
ORDER BY BATCH_START_DTTM DESC;
