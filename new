# ============================================================================
# CHECK_CLARITY_LOADS (2026-11-18). READ ONLY: reads only the Delta history
# (table metadata) and the small log tables. No table data is scanned, nothing
# is written. About 2-5 min.
#
# Question: on which days and at what time are the Clarity tables of the 25
# pipelines loaded, and how (whole table rewritten, or only changed rows)?
# The answer decides three ways to use less capacity:
#   1. On a day when no input table of a pipeline changed, running it gives
#      exactly the same result, so the run can be skipped (no CU at all).
#   2. The Data pipeline should start after the Clarity load has finished.
#   3. If Clarity is loaded as small changes, a "changed rows only" read is
#      possible later; if every table is rewritten every day, it is not.
#
# HOW TO RUN (a NEW notebook, 2 cells, any time of day):
#   CELL 1:  %run CONFIG_NB      (the same CONFIG notebook the pipeline uses)
#   CELL 2:  this file
# Send the whole output. It has table names, dates, times and row counts
# only, no patient data.
# ============================================================================

DAYS = 14          # how many days back
HISTORY_LIMIT = 60  # commits read per table (a table loaded once a day needs ~14-30)

import re
import time
from collections import defaultdict
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timedelta

if "pipeline_configs" not in globals():
    raise RuntimeError("'pipeline_configs' is not defined: run cell 1 (%run CONFIG_NB) "
                       "in this session first")

_t0 = time.time()
_OURS = "ALLERGY_LH.ALLERGY_DELTA."          # written by this pipeline
_CLARITY = "CLARITY_LH.CLARITY."
_BATCH_TABLE = pipeline_configs[0].get("batch_table", _OURS + "ALLERGY_BATCHES")
_RUN_TABLE = _OURS + "ALLERGY_ETL_RUN_LOG"
_NAME_RE = re.compile(r"\b(?:FROM|JOIN)\s+([A-Za-z_]\w*\.[A-Za-z_]\w*\.[A-Za-z_]\w*)\b", re.I)
# operations that do not change the rows of a table
_MAINT = {"OPTIMIZE", "VACUUM START", "VACUUM END", "SET TBLPROPERTIES", "UNSET TBLPROPERTIES",
          "UPGRADE PROTOCOL", "FSCK", "ADD CONSTRAINT", "DROP CONSTRAINT", "CHANGE COLUMN",
          "ADD COLUMNS", "REPLACE COLUMNS", "RENAME COLUMN", "DROP COLUMNS", "REORG",
          "COMPUTE STATS", "ANALYZE STATS", "ADD FEATURE", "DROP FEATURE", "CREATE TABLE"}


def _short(t):
    return t[len(_CLARITY):] if t.startswith(_CLARITY) else t


def _num(m, *keys):
    tot, seen = 0, False
    for k in keys:
        v = (m or {}).get(k)
        if v not in (None, ""):
            try:
                tot += int(float(v))
                seen = True
            except ValueError:
                pass
    return tot if seen else None


def _fmt_rows(n):
    if n is None:
        return "?"
    for unit, div in (("B", 10 ** 9), ("M", 10 ** 6), ("K", 10 ** 3)):
        if n >= div:
            return f"{n / div:.1f}{unit}"
    return str(n)


def _kind(op, params):
    op = (op or "").upper()
    if op in _MAINT:
        return "maint"
    if op.startswith("WRITE") or "AS SELECT" in op:
        mode = str((params or {}).get("mode", "")).lower()
        return "rewrite" if ("AS SELECT" in op or mode == "overwrite") else "append"
    if op == "STREAMING UPDATE":
        return "append"
    if op == "MERGE":
        return "merge"
    if op in ("DELETE", "UPDATE", "TRUNCATE"):
        return op.lower()
    return "other:" + op.lower()


def _rows_changed(kind, m):
    if kind in ("rewrite", "append"):
        return _num(m, "numOutputRows")
    if kind == "merge":
        return _num(m, "numTargetRowsInserted", "numTargetRowsUpdated", "numTargetRowsDeleted")
    if kind == "delete":
        return _num(m, "numDeletedRows")
    if kind == "update":
        return _num(m, "numUpdatedRows")
    return None


# ---- inputs of every pipeline (table names in FROM / JOIN of its query) ----
_inputs = {c["pipeline_name"]: sorted({m.group(1).upper() for m in _NAME_RE.finditer(c["source_query"])})
           for c in pipeline_configs}
_tables = sorted({t for ts in _inputs.values() for t in ts})
_users = defaultdict(list)
for _p, _ts in _inputs.items():
    for _t in _ts:
        _users[_t].append(_p)

_now = datetime.now()
_since = (_now - timedelta(days=DAYS - 1)).replace(hour=0, minute=0, second=0, microsecond=0)
_days = [(_since + timedelta(days=i)).date() for i in range(DAYS)]


def _history(t):
    try:
        rows = (spark.sql(f"DESCRIBE HISTORY {t} LIMIT {HISTORY_LIMIT}")
                .select("version", "timestamp", "operation", "operationParameters", "operationMetrics")
                .collect())
    except Exception as e:
        return t, None, str(e).split("\n")[0][:120], False
    out = []
    for r in rows:
        ts = r["timestamp"]
        if ts is None or ts < _since:
            continue
        kind = _kind(r["operation"], r["operationParameters"])
        out.append(dict(ts=ts, op=r["operation"], kind=kind,
                        rows=_rows_changed(kind, r["operationMetrics"])))
    cut = len(rows) == HISTORY_LIMIT and rows[-1]["timestamp"] is not None and rows[-1]["timestamp"] >= _since
    return t, out, None, cut


with ThreadPoolExecutor(max_workers=8) as _pool:
    _res = list(_pool.map(_history, _tables))
_hist = {t: h for t, h, err, cut in _res if h is not None}
_fail = {t: err for t, h, err, cut in _res if h is None}
_cut = {t for t, h, err, cut in _res if cut}

try:
    _tz = spark.conf.get("spark.sql.session.timeZone")
except Exception:
    _tz = "?"
print(f"CHECK_CLARITY_LOADS | {len(pipeline_configs)} pipelines, {len(_tables)} input tables | "
      f"days {_days[0]:%m-%d} .. {_days[-1]:%m-%d} | times in session time zone {_tz} | now {_now:%m-%d %H:%M}")
for t, err in _fail.items():
    print(f"   could not read history of {t}: {err}")

# ---- 1. per input table: data changes per day ----
_header = "".join(d.strftime("%a")[0] for d in _days)
print()
print("== 1. Data changes per day of every input table (not written by this pipeline)")
print("   one character per day: digit = number of data changes that day, m = only "
      "OPTIMIZE/VACUUM-type commits, . = nothing")
print("   'rewrite' = whole table written again, 'merge'/'append'/'delete'/'update' = only some rows")
print(f"   {'table (CLARITY_LH.CLARITY. left out)':<34} {'used by':>7}  {_header}  how, last {DAYS} days")
_ext = [t for t in _tables if not t.startswith(_OURS)]
_ext.sort(key=lambda t: (-len(_users[t]), t))
for t in _ext:
    if t not in _hist:
        continue
    h = _hist[t]
    per_day = defaultdict(lambda: [0, 0])
    for c in h:
        per_day[c["ts"].date()][0 if c["kind"] != "maint" else 1] += 1
    pat = ""
    for d in _days:
        n, mt = per_day.get(d, [0, 0])
        pat += (str(n) if n < 10 else "+") if n else ("m" if mt else ".")
    data = [c for c in h if c["kind"] != "maint"]
    kinds = defaultdict(list)
    for c in data:
        kinds[c["kind"]].append(c["rows"])
    how = ", ".join(
        f"{k} x{len(v)} (~{_fmt_rows(int(sum(x for x in v if x is not None) / max(1, sum(1 for x in v if x is not None))))} rows)"
        if any(x is not None for x in v) else f"{k} x{len(v)}"
        for k, v in sorted(kinds.items(), key=lambda kv: -len(kv[1]))) or "no data change"
    if data:
        mins = sorted(c["ts"].hour * 60 + c["ts"].minute for c in data)
        how += f", at {mins[0] // 60:02d}:{mins[0] % 60:02d}-{mins[-1] // 60:02d}:{mins[-1] % 60:02d}"
    if t in _cut:
        how += f" (only the last {HISTORY_LIMIT} commits read)"
    print(f"   {_short(t)[:34]:<34} {len(_users[t]):>3} pipe  {pat}  {how}")

# ---- 2. per day: when Clarity was loaded, and when this pipeline ran ----
print()
print("== 2. Per day: first and last data change of the Clarity tables, and this pipeline's rounds")
_runs = defaultdict(list)
try:
    for r in (spark.sql(f"SELECT RUN_ID, STATUS, COALESCE(SESSION_START_DTTM, RUN_START_DTTM) AS S, "
                        f"RUN_END_DTTM AS E FROM {_RUN_TABLE}").collect()):
        if r["S"] is not None and r["S"] >= _since:
            _runs[r["S"].date()].append(r)
except Exception as e:
    print(f"   (run log not readable: {str(e).splitlines()[0][:100]})")
_clar = [t for t in _ext if t.startswith(_CLARITY) and t in _hist]
for d in _days:
    ch = [(c["ts"], t) for t in _clar for c in _hist[t] if c["kind"] != "maint" and c["ts"].date() == d]
    if ch:
        ch.sort()
        load = (f"{ch[0][0]:%H:%M} - {ch[-1][0]:%H:%M}, {len({t for _, t in ch})} of {len(_clar)} "
                f"Clarity tables changed")
    else:
        load = f"NO Clarity table changed"
    rr = "; ".join(f"run {r['RUN_ID']} {r['S']:%H:%M}-{(r['E'].strftime('%H:%M') if r['E'] else '?')} "
                   f"{r['STATUS']}" for r in sorted(_runs.get(d, []), key=lambda r: r["S"]))
    print(f"   {d:%a %m-%d}: {load:<48} | this pipeline: {rr or '-'}")

# ---- 3. per pipeline: did any input change after its last successful sync? ----
print()
print("== 3. Per pipeline: inputs changed after its last successful sync (batch start)?")
_last_ok = {}
try:
    for r in (spark.sql(f"SELECT PIPELINE_NAME, MAX(BATCH_START_DTTM) AS S FROM {_BATCH_TABLE} "
                        f"WHERE STATUS = 'SUCCESS' GROUP BY PIPELINE_NAME").collect()):
        _last_ok[r["PIPELINE_NAME"]] = r["S"]
except Exception as e:
    print(f"   (batch table not readable: {str(e).splitlines()[0][:100]})")
_unchanged = []
for c in pipeline_configs:
    p = c["pipeline_name"]
    s = _last_ok.get(p)
    if s is None:
        print(f"   {p:<34} no successful sync yet")
        continue
    changed, unknown = [], []
    for t in _inputs[p]:
        if t not in _hist:
            unknown.append(_short(t))
            continue
        if any(x["kind"] != "maint" and x["ts"] >= s for x in _hist[t]):
            changed.append(_short(t))
        elif s < _since:
            unknown.append(_short(t))
    if changed:
        verdict = f"{len(changed)} of {len(_inputs[p])} inputs changed: {', '.join(changed)[:90]}"
    elif unknown:
        verdict = f"no change seen, but not sure for: {', '.join(unknown)[:80]}"
    else:
        verdict = "NO input changed -> a run now would give exactly the same result"
        _unchanged.append(p)
    print(f"   {p:<34} last sync {s:%m-%d %H:%M} | {verdict}")

# ---- 4. summary ----
print()
print("== 4. Summary")
_quiet = [d for d in _days
          if not any(c["kind"] != "maint" and c["ts"].date() == d for t in _clar for c in _hist[t])]
print(f"   days without any Clarity data change: "
      f"{', '.join(f'{d:%a %m-%d}' for d in _quiet) if _quiet else 'none'}")
_rew = [t for t in _clar if _hist[t] and all(c["kind"] in ("rewrite", "maint") for c in _hist[t])
        and any(c["kind"] == "rewrite" for c in _hist[t])]
print(f"   Clarity tables always rewritten in full: {len(_rew)} of {len(_clar)}"
      + (f" (e.g. {', '.join(_short(t) for t in _rew[:6])})" if _rew else ""))
print(f"   pipelines whose inputs did not change since their last sync: {len(_unchanged)} of "
      f"{len(pipeline_configs)}" + (f" ({', '.join(_unchanged)[:120]})" if _unchanged else ""))
if _cut:
    print(f"   NOTE: {len(_cut)} tables have more than {HISTORY_LIMIT} commits in {DAYS} days: set "
          f"HISTORY_LIMIT = 500 at the top and run this cell again")
print(f"   done in {time.time() - _t0:.0f} s")
