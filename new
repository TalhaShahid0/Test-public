# CONFIG_NB entry for ALLERGY.MV_ALLERGY_OR_REPORT -> ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_OR_REPORT
#
# Same result as the Oracle MV (inner SELECT DISTINCT "mst" and the outer
# LEFT JOIN to the OR_CASE / OR_CASE_ALL_PROC "cases" subquery are kept).
#
# Oracle (+) mapping:
#   l.pat_id = mvp.pat_id, l.log_id = proc.log_id      -> INNER (no (+))
#   l.log_id = surg.log_id(+) AND surg.panel = proc.all_procs_panel(+)
#       -> effectively INNER for both surg and proc. proc is the (+) side of the
#          panel condition but is also joined to l without (+), so null-extended
#          proc rows are removed; then surg.panel must equal a real panel, so
#          null-extended surg rows are removed too (Oracle "simple join" rule).
#          Written as: proc ON log_id, surg ON log_id AND panel. Same rows.
#   loc, zp, ser, pr, serv1, zrole, zos, pat, b          -> LEFT JOIN
#   ser.prov_id = sid.prov_id(+) AND sid.identity_type_id(+) = 50
#       -> LEFT JOIN sid ON sid.prov_id = ser.prov_id AND sid.identity_type_id = 50
#          (the = 50 stays in ON, not WHERE)
#   mst.log_id = cases.or_case_id(+) AND mst.or_proc_id = cases.or_proc_id(+)
#       -> LEFT JOIN cases ON both columns
#
# Performance changes (result unchanged):
#   1. MV_PAT_ID -> TBL_PAT_ID (active rows only: latest version per ROW_HASH,
#      IS_DELETED = 0, same rule MERGE_NB uses). It is only a filter on pat_id,
#      so it is a LEFT SEMI JOIN; the DISTINCT already removed any duplicates
#      the plain join could create. OR_LOG is cut to these patients FIRST.
#   2. IP_DATA_STORE (b) is a LEFT JOIN whose columns are never selected; under
#      SELECT DISTINCT it cannot add or remove rows, so it is dropped.
#   3. "cases": OR_CASE LEFT JOIN OR_CASE_ALL_PROC -> INNER JOIN. A case with no
#      proc row has or_proc_id NULL, which can never match mst.or_proc_id, so
#      those rows never matched the outer LEFT JOIN anyway. Output identical.
#   4. BROADCAST hints on the small ZC_* / CLARITY_LOC / OR_PROC lookups.
#
# primary_keys = "" (MV has no PK) -> MERGE_NB mode A (row_hash over whole row).
# TBL_PAT_ID must run before this entry (orchestrator runs sequentially).

pipeline_configs = [
    {
        "pipeline_name": "TBL_ALLERGY_OR_REPORT",
        "target_table": "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_OR_REPORT",
        "batch_table": "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES",
        "source_query": """
            WITH active_pat_ids AS (
                SELECT PAT_ID
                FROM (
                    SELECT PAT_ID, IS_DELETED,
                           ROW_NUMBER() OVER (
                               PARTITION BY ROW_HASH
                               ORDER BY DW_UPDATED_AT DESC, BATCH_ID DESC
                           ) AS rn
                    FROM ALLERGY_LH.ALLERGY_DELTA.TBL_PAT_ID
                ) t
                WHERE rn = 1 AND COALESCE(IS_DELETED, 0) = 0
            ),
            l AS (
                SELECT ol.log_id, ol.pat_id, ol.pat_type_c, ol.surgery_date,
                       ol.loc_id, ol.total_time_needed, ol.status_c,
                       ol.proc_not_perf_c
                FROM CLARITY_LH.CLARITY.OR_LOG ol
                LEFT SEMI JOIN active_pat_ids a ON ol.pat_id = a.PAT_ID
            ),
            mst AS (
                SELECT /*+ BROADCAST(loc, zp, pr, serv1, zrole, zos) */ DISTINCT
                    l.log_id             AS LOG_ID,
                    pat.pat_mrn_id       AS PAT_MRN_ID,
                    pat.pat_id           AS PAT_ID,
                    pat.pat_name         AS PAT_NAME,
                    l.pat_type_c         AS PAT_TYPE_C,
                    zp.name              AS PATCLASS,
                    l.surgery_date       AS SURGERY_DATE,
                    ser.prov_id          AS PROV_ID,
                    ser.prov_name        AS PROV_NAME,
                    sid.identity_id      AS ROV_IDENTITY_ID,
                    l.loc_id             AS LOC_ID,
                    loc.loc_name         AS LOC_NAME,
                    proc.or_proc_id      AS OR_PROC_ID,
                    pr.proc_name         AS PROC_NAME,
                    l.total_time_needed  AS TOTAL_TIME_NEEDED,
                    pr.primary_ext_id    AS PRIMARY_EXT_ID,
                    surg.surg_id         AS SURG_ID,
                    surg.role_c          AS ROLE_C,
                    zrole.name           AS ROLE,
                    serv1.name           AS SURGEONSERVICE,
                    l.status_c           AS STATUS_C,
                    zos.name             AS LOGSTATUS,
                    l.proc_not_perf_c    AS PROC_NOT_PERF_C
                FROM l
                INNER JOIN CLARITY_LH.CLARITY.OR_LOG_ALL_PROC proc
                    ON l.log_id = proc.log_id
                INNER JOIN CLARITY_LH.CLARITY.OR_LOG_ALL_SURG surg
                    ON l.log_id = surg.log_id
                   AND surg.panel = proc.all_procs_panel
                LEFT JOIN CLARITY_LH.CLARITY.CLARITY_LOC loc
                    ON l.loc_id = loc.loc_id
                LEFT JOIN CLARITY_LH.CLARITY.ZC_PAT_CLASS zp
                    ON l.pat_type_c = zp.adt_pat_class_c
                LEFT JOIN CLARITY_LH.CLARITY.CLARITY_SER ser
                    ON surg.surg_id = ser.prov_id
                LEFT JOIN CLARITY_LH.CLARITY.OR_PROC pr
                    ON proc.or_proc_id = pr.or_proc_id
                LEFT JOIN CLARITY_LH.CLARITY.ZC_OR_SERVICE serv1
                    ON surg.service_c = serv1.service_c
                LEFT JOIN CLARITY_LH.CLARITY.ZC_OR_PANEL_ROLE zrole
                    ON surg.role_c = zrole.role_c
                LEFT JOIN CLARITY_LH.CLARITY.ZC_OR_STATUS zos
                    ON l.status_c = zos.status_c
                LEFT JOIN CLARITY_LH.CLARITY.PATIENT pat
                    ON l.pat_id = pat.pat_id
                LEFT JOIN CLARITY_LH.CLARITY.IDENTITY_SER_ID sid
                    ON ser.prov_id = sid.prov_id
                   AND sid.identity_type_id = 50
            ),
            cases AS (
                SELECT c.or_case_id        AS OR_CASE_ID,
                       ap.or_proc_id       AS OR_PROC_ID,
                       c.setup_offset      AS SETUP_OFFSET,
                       c.cleanup_offset    AS CLEANUP_OFFSET,
                       ap.defaulted_length AS DEFAULTED_LENGTH,
                       ap.total_length     AS PROC_LENGTH
                FROM CLARITY_LH.CLARITY.OR_CASE c
                INNER JOIN CLARITY_LH.CLARITY.OR_CASE_ALL_PROC ap
                    ON ap.or_case_id = c.or_case_id
            )
            SELECT mst.LOG_ID, mst.PAT_MRN_ID, mst.PAT_ID, mst.PAT_NAME, mst.PAT_TYPE_C,
                   mst.PATCLASS, mst.SURGERY_DATE, mst.PROV_ID, mst.PROV_NAME,
                   mst.ROV_IDENTITY_ID, mst.LOC_ID, mst.LOC_NAME, mst.OR_PROC_ID,
                   mst.PROC_NAME, mst.TOTAL_TIME_NEEDED, mst.PRIMARY_EXT_ID, mst.SURG_ID,
                   mst.ROLE_C, mst.ROLE, mst.SURGEONSERVICE, mst.STATUS_C, mst.LOGSTATUS,
                   mst.PROC_NOT_PERF_C,
                   cases.SETUP_OFFSET, cases.CLEANUP_OFFSET, cases.DEFAULTED_LENGTH,
                   cases.PROC_LENGTH
            FROM mst
            LEFT JOIN cases
                ON mst.LOG_ID = cases.OR_CASE_ID
               AND mst.OR_PROC_ID = cases.OR_PROC_ID
        """,
        "primary_keys": "",
        "non_key_columns": "LOG_ID,PAT_MRN_ID,PAT_ID,PAT_NAME,PAT_TYPE_C,PATCLASS,SURGERY_DATE,PROV_ID,PROV_NAME,ROV_IDENTITY_ID,LOC_ID,LOC_NAME,OR_PROC_ID,PROC_NAME,TOTAL_TIME_NEEDED,PRIMARY_EXT_ID,SURG_ID,ROLE_C,ROLE,SURGEONSERVICE,STATUS_C,LOGSTATUS,PROC_NOT_PERF_C,SETUP_OFFSET,CLEANUP_OFFSET,DEFAULTED_LENGTH,PROC_LENGTH",
        "identity_column": "ALLERGY_OR_REPORT_KEY",
        "load_type": "FULL",
    },
]
