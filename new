# TBL_ALLERGY_SKINTEST -- same logic as the original query, only faster.
# Original CTEs, SELECT list, all joins (incl. PATIENT) and DISTINCT are unchanged.
# Only addition: NOTE_CONCEPT / NOTE_ENC_INFO / HNO_INFO / PAT_ENC are
# pre-filtered (LEFT SEMI JOIN) to rows the original inner joins keep anyway,
# and the missing ON for filtered_concepts is written out (nc.concept_id =
# fc.concept_id, which the original already implied via cc and nc).
pipeline_configs = [
    {
        "pipeline_name": "TBL_ALLERGY_SKINTEST",
        "target_table": "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_SKINTEST",
        "batch_table": "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES",
        "source_query": """
            WITH latest_form_date AS (
                SELECT form_id, MAX(contact_date_real) AS max_contact_date_real
                FROM CLARITY_LH.CLARITY.SMARTFORM_CONCEPT
                WHERE form_id IN ('7','8','9','10','11','12','13','6','110')
                GROUP BY form_id
            ),
            filtered_concepts AS (
                SELECT sc.form_id, sc.concept_id
                FROM CLARITY_LH.CLARITY.SMARTFORM_CONCEPT sc
                INNER JOIN latest_form_date lfd
                    ON sc.form_id = lfd.form_id
                    AND sc.contact_date_real = lfd.max_contact_date_real
                INNER JOIN CLARITY_LH.CLARITY.CLARITY_CONCEPT cc
                    ON sc.concept_id = cc.concept_id
                    AND cc.concept_id LIKE '%AMB%'
                WHERE sc.form_id IN ('7','8','9','10','11','12','13','6','110')
            ),
            -- ---- pruning only: these CTEs just pre-filter the big tables to rows that
            -- ---- the original joins would keep anyway (semi join = inner join filter)
            concept_ids AS (
                SELECT DISTINCT concept_id FROM filtered_concepts
            ),
            nc_f AS (
                SELECT /*+ BROADCAST(c) */ nc.*
                FROM CLARITY_LH.CLARITY.NOTE_CONCEPT nc
                LEFT SEMI JOIN concept_ids c
                    ON nc.concept_id = c.concept_id
            ),
            note_ids AS (
                SELECT DISTINCT hno_id AS note_id FROM nc_f
            ),
            eni_f AS (
                SELECT eni.*
                FROM CLARITY_LH.CLARITY.NOTE_ENC_INFO eni
                LEFT SEMI JOIN note_ids n
                    ON eni.note_id = n.note_id
            ),
            hn_f AS (
                SELECT hn.*
                FROM CLARITY_LH.CLARITY.HNO_INFO hn
                LEFT SEMI JOIN note_ids n
                    ON hn.note_id = n.note_id
            ),
            csn_ids AS (
                SELECT DISTINCT pat_enc_csn_id FROM hn_f
            ),
            pe_f AS (
                SELECT pe.*
                FROM CLARITY_LH.CLARITY.PAT_ENC pe
                LEFT SEMI JOIN csn_ids c
                    ON pe.pat_enc_csn_id = c.pat_enc_csn_id
            )
            SELECT /*+ BROADCAST(fc, cq, dep) */ DISTINCT
                pat.pat_id               AS pat_id,
                pe.pat_enc_csn_id        AS pat_enc_csn_id,
                cq.form_name             AS form_name,
                cq.form_id               AS form_id,
                cc.name                  AS concept_name,
                cc.abbreviation          AS abbreviation,
                nc.concept_value         AS concept_value,
                cc.concept_id            AS concept_id,
                nc.concept_source        AS concept_source,
                dep.department_id        AS department_id,
                dep.department_name      AS department_name,
                eni.note_id              AS note_encounter_note_id,
                eni.author_user_id       AS note_author_id,
                emp.name                 AS note_author_name,
                eni.entry_instant_dttm   AS note_created
            FROM CLARITY_LH.CLARITY.PATIENT AS pat
            INNER JOIN pe_f AS pe
                ON pe.pat_id = pat.pat_id
            INNER JOIN hn_f AS hn
                ON pe.pat_enc_csn_id = hn.pat_enc_csn_id
            INNER JOIN eni_f AS eni
                ON hn.note_id = eni.note_id
            INNER JOIN CLARITY_LH.CLARITY.CLARITY_DEP AS dep
                ON pe.department_id = dep.department_id
            INNER JOIN CLARITY_LH.CLARITY.CLARITY_EMP AS emp
                ON eni.author_user_id = emp.user_id
            INNER JOIN nc_f AS nc
                ON nc.hno_id = eni.note_id
            INNER JOIN filtered_concepts AS fc
                ON nc.concept_id = fc.concept_id
            INNER JOIN CLARITY_LH.CLARITY.CLARITY_CONCEPT AS cc
                ON cc.concept_id = fc.concept_id
            INNER JOIN CLARITY_LH.CLARITY.CL_QFORM AS cq
                ON fc.form_id = cq.form_id
        """,
        "primary_keys": "",
        "non_key_columns": "PAT_ID,PAT_ENC_CSN_ID,FORM_NAME,FORM_ID,CONCEPT_NAME,ABBREVIATION,CONCEPT_VALUE,CONCEPT_ID,CONCEPT_SOURCE,DEPARTMENT_ID,DEPARTMENT_NAME,NOTE_ENCOUNTER_NOTE_ID,NOTE_AUTHOR_ID,NOTE_AUTHOR_NAME,NOTE_CREATED",
        "identity_column": "ALLERGY_SKINTEST_KEY",
        "load_type": "FULL",
    },
]
