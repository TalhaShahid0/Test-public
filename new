# ============================================================
# ORCHESTRATOR NOTEBOOK  (resource-aware)
#
# Requires the updated MERGE_NB (%run it first) -- it uses
# run_batch_tracked_merge() and configure_spark_for_efficiency().
#
# Runs all pipeline_configs sequentially through
# run_batch_tracked_merge(), with retry, and logs run-level and
# attempt-level monitoring rows.
#
# Changes vs. the previous orchestrator (behaviour of the sync and
# the log schemas is unchanged):
#   1. BATCH_ID for the attempt row comes straight from the
#      run_batch_tracked_merge() return value instead of re-querying
#      the batch table for "max SUCCESS batch" (one less query per
#      pipeline, and correct even if another run wrote in between).
#   2. Non-transient failures are NOT retried. A ValueError (guard /
#      PK validation), a RuntimeError (stale-batch guard) or an
#      AnalysisException (bad SQL) fails identically every time, and
#      retrying a multi-hour load just doubles the capacity spent.
#      Override with retry_non_transient=True.
#   3. Spark cache is cleared between pipelines and between retries,
#      and Spark tuning is applied once at the start.
#   4. inter_pipeline_wait_seconds now defaults to 0. time.sleep() does
#      NOT disconnect or free the session -- it's one continuous session
#      for the whole run, and a sleep just idles the driver thread while
#      the executors stay allocated. Dynamic allocation's idle timeout
#      (60s+ by default) is normally longer than a short wait anyway, so
#      a 30s gap bought nothing but idle-capacity cost. Pass a nonzero
#      value only for a real reason (e.g. giving the source database a
#      breather between heavy queries) -- ideally paired with a shorter
#      spark.dynamicAllocation.executorIdleTimeout so the wait actually
#      releases executors instead of just holding them idle.
#      inter_attempt_wait_seconds (retry backoff) is kept, since a real
#      transient failure often needs a few seconds to clear.
#   5. Optional stale_after_hours: a hard-killed session (capacity
#      throttling, cancelled notebook) leaves a RUNNING row that would
#      trip the stale-run guard forever. With this set, RUNNING rows
#      older than N hours are closed as ABANDONED. Off by default.
#   6. raise_on_failure (default True): if any pipeline failed, the
#      notebook raises at the end so the Fabric pipeline / schedule
#      shows a failed activity instead of a green run with a
#      PARTIAL_FAILURE hidden in the log table.
#   7. Run row is closed out even if the cell is interrupted
#      (BaseException), not just on Exception.
#
# SPEED PASS (optimized/ copy, 2026-10-02) -- needs optimized/MERGE_NB:
#   8. PARALLEL RUNS in this one Spark session (max_parallel, default 4).
#      Independent configs run at the same time; most of a pipeline's wall
#      time is waiting on Delta commits, small jobs and the driver, so the
#      cluster sits half idle when they run one by one.
#   9. DEPENDENCY ORDER IS AUTOMATIC. For two configs A (listed first) and B:
#      B waits for A to finish if B's source_query reads A's target table,
#      if A's source_query reads B's target table, or if both write the same
#      target. So every pipeline reads exactly the data it read in the old
#      one-by-one run (e.g. TBL_PAT_ID finishes before TBL_ALLERGY_MEDS starts,
#      as long as TBL_PAT_ID is listed first, as it is today).
#      Hidden dependencies (through a view, or a table name built at runtime)
#      can be added by hand: "depends_on": ["TBL_PAT_ID"] in that config.
#  10. In parallel mode spark.catalog.clearCache() is NOT called between
#      pipelines (it would wipe the cache of pipelines still running); each
#      pipeline already unpersists its own cached data when it ends.
#  11. Log-table writes (RUN / STEP log) are serialised with a lock. Same
#      rows, same values; only the order of STEP rows follows finish time.
#
#   max_parallel=1 gives back the exact old one-by-one behaviour.
#
#   For a fair share of the cluster between parallel pipelines, add this to
#   the %%configure "conf" block (session start only):
#       "spark.scheduler.mode": "FAIR"
#   Without it everything still works, just FIFO.
# ============================================================

import re
import time
import threading
from concurrent.futures import ThreadPoolExecutor, wait, FIRST_COMPLETED
from datetime import datetime, timedelta
from delta.tables import DeltaTable
from pyspark.sql.types import (
    StructType, StructField, LongType, StringType,
    TimestampType, IntegerType, DoubleType,
)
from pyspark.sql.functions import coalesce, max as spark_max, col, lit

try:
    from pyspark.errors import AnalysisException
except Exception:  # older runtimes
    from pyspark.sql.utils import AnalysisException

# Errors that will fail the same way on a retry.
NON_TRANSIENT_ERRORS = (ValueError, RuntimeError, AnalysisException)


# ============================================================
# Monitoring table schemas
# ============================================================

ORCHESTRATION_RUN_SCHEMA = StructType([
    StructField("RUN_ID", LongType(), True),
    StructField("RUN_START_DTTM", TimestampType(), True),
    StructField("RUN_END_DTTM", TimestampType(), True),
    StructField("STATUS", StringType(), True),    # RUNNING / SUCCESS / PARTIAL_FAILURE / FAILED / ABANDONED
    StructField("TOTAL_PIPELINES", LongType(), True),
    StructField("SUCCEEDED_COUNT", LongType(), True),
    StructField("FAILED_COUNT", LongType(), True),
    StructField("FAILED_PIPELINE_NAMES", StringType(), True),     # comma-joined
    StructField("TRIGGERED_BY", StringType(), True),
])

ORCHESTRATION_ATTEMPT_SCHEMA = StructType([
    StructField("RUN_ID", LongType(), True),                      # FK -> RUN_TABLE.RUN_ID
    StructField("PIPELINE_NAME", StringType(), True),
    StructField("ATTEMPT_NUMBER", IntegerType(), True),
    StructField("ATTEMPT_START_DTTM", TimestampType(), True),
    StructField("ATTEMPT_END_DTTM", TimestampType(), True),
    StructField("STATUS", StringType(), True),                    # SUCCESS / FAILED
    StructField("ERROR_MESSAGE", StringType(), True),
    StructField("DURATION_SECONDS", DoubleType(), True),
    StructField("BATCH_ID", LongType(), True),                    # FK -> <batch_table>.BATCH_ID, set only on SUCCESS
])

RUN_TABLE = "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_ETL_RUN_LOG"
ATTEMPT_TABLE = "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_ETL_STEP_LOG"

# Serialises commits to the two monitoring tables when pipelines run in parallel.
_LOG_LOCK = threading.RLock()


# ============================================================
# Small table helpers
# ============================================================

def _ensure_table(table, schema):
    if not spark.catalog.tableExists(table):
        print("Monitoring table does not exist. Creating:", table)
        spark.createDataFrame([], schema) \
            .write.format("delta").mode("overwrite").saveAsTable(table)
        print("Monitoring table created successfully.")
        return

    existing_cols = {f.name for f in spark.table(table).schema.fields}
    missing_fields = [f for f in schema.fields if f.name not in existing_cols]
    if missing_fields:
        add_cols_ddl = ", ".join(
            f"{f.name} {f.dataType.simpleString()}" for f in missing_fields
        )
        print(f"Monitoring table is missing columns [{add_cols_ddl}]. Altering:", table)
        spark.sql(f"ALTER TABLE {table} ADD COLUMNS ({add_cols_ddl})")


def _append_row(table, schema, row_values):
    df = spark.createDataFrame([row_values], schema=schema)
    with _LOG_LOCK:
        df.write.format("delta").mode("append") \
            .option("mergeSchema", "true").saveAsTable(table)


def _update_run_row(run_id, updates: dict):
    """MERGE-based update of one RUN_TABLE row; schema built in the same
    order as the dict keys so values never zip against wrong-typed fields."""
    updates_with_id = dict(updates)
    updates_with_id["RUN_ID"] = run_id
    cols = list(updates_with_id.keys())

    field_lookup = {f.name: f for f in ORCHESTRATION_RUN_SCHEMA.fields}
    row_schema = StructType([field_lookup[c] for c in cols])

    row = spark.createDataFrame(
        [[updates_with_id[c] for c in cols]],
        schema=row_schema,
    )
    set_clause = {c: f"S.{c}" for c in cols if c != "RUN_ID"}
    with _LOG_LOCK:
        (
            DeltaTable.forName(spark, RUN_TABLE)
            .alias("T")
            .merge(row.alias("S"), "T.RUN_ID = S.RUN_ID")
            .whenMatchedUpdate(set=set_clause)
            .execute()
        )


def _next_run_id():
    if not spark.catalog.tableExists(RUN_TABLE):
        return 1
    return (
        spark.table(RUN_TABLE)
        .agg(coalesce(spark_max("RUN_ID"), lit(0)).alias("m"))
        .collect()[0]["m"] + 1
    )


def _abandon_stale_runs(stale_after_hours):
    """Close RUNNING rows older than the cutoff as ABANDONED (hard-killed runs)."""
    cutoff = datetime.now() - timedelta(hours=stale_after_hours)
    cutoff_lit = cutoff.strftime("%Y-%m-%d %H:%M:%S")
    DeltaTable.forName(spark, RUN_TABLE).update(
        condition=f"STATUS = 'RUNNING' AND RUN_START_DTTM < TIMESTAMP'{cutoff_lit}'",
        set={"STATUS": lit("ABANDONED"), "RUN_END_DTTM": lit(datetime.now())},
    )


# ============================================================
# Dependency graph (which config must finish before which)
# ============================================================

def _reads_table(source_query, table):
    """True if source_query mentions `table` (matched on its last name part,
    whole word, any case -- so ALLERGY_LH.ALLERGY_DELTA.TBL_PAT_ID, tbl_pat_id
    and ALLERGY_DELTA.TBL_PAT_ID all match, TBL_PAT_ID_HIST does not).
    A false match only costs parallelism, never correctness."""
    short = table.strip().strip("`").split(".")[-1].strip("`")
    pattern = r"(?<![A-Za-z0-9_])" + re.escape(short) + r"(?![A-Za-z0-9_])"
    return re.search(pattern, source_query or "", flags=re.IGNORECASE) is not None


def _build_dependencies(pipeline_configs):
    """
    Returns {index: set(indexes that must finish first)}.

    For configs i listed before j, j waits for i when:
      - j reads i's target  (j needs i's fresh data, as in the sequential run)
      - i reads j's target  (i must read j's target before j changes it)
      - both write the same target
    Plus any explicit cfg["depends_on"] = ["PIPELINE_NAME", ...].
    This reproduces exactly what each pipeline saw in the one-by-one run.
    """
    names = [c["pipeline_name"] for c in pipeline_configs]
    dupes = sorted({n for n in names if names.count(n) > 1})
    if dupes:
        raise ValueError(f"Duplicate pipeline_name in pipeline_configs: {dupes}")
    index_of = {n: i for i, n in enumerate(names)}

    deps = {i: set() for i in range(len(pipeline_configs))}
    for j, cj in enumerate(pipeline_configs):
        for i in range(j):
            ci = pipeline_configs[i]
            same_target = (ci["target_table"].strip().lower()
                           == cj["target_table"].strip().lower())
            if (same_target
                    or _reads_table(cj.get("source_query"), ci["target_table"])
                    or _reads_table(ci.get("source_query"), cj["target_table"])):
                deps[j].add(i)
        for d in cj.get("depends_on", []) or []:
            if d not in index_of:
                raise ValueError(
                    f"{cj['pipeline_name']}: depends_on '{d}' is not a "
                    f"pipeline_name in pipeline_configs."
                )
            deps[j].add(index_of[d])

    # Cycle check (only possible through a hand-written depends_on).
    remaining = {k: set(v) for k, v in deps.items()}
    while remaining:
        free = [k for k, v in remaining.items() if not v]
        if not free:
            raise ValueError(
                "depends_on creates a cycle between: "
                f"{sorted(names[k] for k in remaining)}"
            )
        for k in free:
            del remaining[k]
        for v in remaining.values():
            v.difference_update(free)
    return deps


def _merge_args(cfg):
    """Config without orchestrator-only keys, ready for run_batch_tracked_merge."""
    return {k: v for k, v in cfg.items() if k != "depends_on"}


# ============================================================
# One pipeline, with retry (same rules as before)
# ============================================================

def _run_pipeline_with_retry(cfg, run_id, max_attempts, inter_attempt_wait_seconds,
                             retry_non_transient, parallel, stop_event):
    """Returns (succeeded: bool, result dict or None)."""
    name = cfg["pipeline_name"]
    merge_args = _merge_args(cfg)
    if parallel:
        # Own FAIR-scheduler pool per pipeline (no effect in FIFO mode).
        spark.sparkContext.setLocalProperty("spark.scheduler.pool", name)

    attempt = 1
    while attempt <= max_attempts:
        attempt_start = datetime.now()
        try:
            res = run_batch_tracked_merge(**merge_args)
            attempt_end = datetime.now()

            _append_row(ATTEMPT_TABLE, ORCHESTRATION_ATTEMPT_SCHEMA, [
                run_id, name, attempt, attempt_start, attempt_end,
                "SUCCESS", None,
                (attempt_end - attempt_start).total_seconds(),
                res.get("batch_id"),
            ])
            return True, res

        except Exception as e:
            attempt_end = datetime.now()
            _append_row(ATTEMPT_TABLE, ORCHESTRATION_ATTEMPT_SCHEMA, [
                run_id, name, attempt, attempt_start, attempt_end,
                "FAILED", str(e),
                (attempt_end - attempt_start).total_seconds(),
                None,
            ])

            # Release anything the failed attempt left cached. In parallel
            # mode run_batch_tracked_merge already unpersisted its own data,
            # and clearCache() would also wipe the other running pipelines.
            if not parallel:
                spark.catalog.clearCache()

            non_transient = isinstance(e, NON_TRANSIENT_ERRORS)
            can_retry = attempt < max_attempts and (
                retry_non_transient or not non_transient
            ) and not stop_event.is_set()

            if can_retry:
                print(f"Attempt {attempt} failed for {name}: {e}")
                print(f"Waiting {inter_attempt_wait_seconds} seconds before retry...")
                time.sleep(inter_attempt_wait_seconds)
                attempt += 1
            else:
                why = ("non-transient error, not retrying"
                       if non_transient and attempt < max_attempts
                       else "giving up on this pipeline")
                print(f"Attempt {attempt} failed for {name}: {e} -- {why}")
                return False, None
    return False, None


# ============================================================
# Orchestrator entry point
# ============================================================

def run_orchestrator(
    pipeline_configs,
    triggered_by="Scheduled",
    max_attempts=2,
    inter_attempt_wait_seconds=15,
    inter_pipeline_wait_seconds=0,
    allow_run_with_stale_running_run=False,
    retry_non_transient=False,
    stale_after_hours=None,
    raise_on_failure=True,
    tune_spark=True,
    max_parallel=4,
):
    """
    Runs every config through run_batch_tracked_merge(), one at a time, with
    retry, logging:
      - one RUN_TABLE row for the whole notebook execution
      - one ATTEMPT_TABLE row per attempt per pipeline, linked to the
        pipeline's own batch_table.BATCH_ID on success

    STALE-RUN GUARD: refuses to start if another RUN_TABLE row is still
    STATUS = 'RUNNING' (run-level analogue of the per-pipeline guard in
    run_batch_tracked_merge). Override with allow_run_with_stale_running_run=True,
    or set stale_after_hours to auto-close runs that were hard-killed.

    retry_non_transient=False: guard / validation / SQL-analysis errors are
    not retried, since they cannot succeed on a second attempt and each retry
    of a long load spends capacity for nothing.

    inter_pipeline_wait_seconds=0 by default: the session stays open and
    executors stay allocated for the whole run regardless of this value, so a
    wait here does not free capacity -- it only idles it. Set it only if you
    need to pace requests against the source database. (One-by-one mode only.)

    max_parallel: how many pipelines run at the same time (default 4).
    Dependencies are worked out from the configs -- see _build_dependencies.
    1 = the old strictly sequential run.
    """
    max_parallel = max(1, int(max_parallel or 1))
    parallel = max_parallel > 1
    deps = _build_dependencies(pipeline_configs)   # fails fast on bad configs
    if tune_spark:
        configure_spark_for_efficiency()   # defined in MERGE_NB

    _ensure_table(RUN_TABLE, ORCHESTRATION_RUN_SCHEMA)
    _ensure_table(ATTEMPT_TABLE, ORCHESTRATION_ATTEMPT_SCHEMA)

    # ---- Stale-run guard ----
    if stale_after_hours is not None:
        _abandon_stale_runs(stale_after_hours)

    stale_running = (
        spark.table(RUN_TABLE)
        .filter(col("STATUS") == "RUNNING")
        .count()
    )
    if stale_running > 0 and not allow_run_with_stale_running_run:
        raise RuntimeError(
            f"Found {stale_running} orchestrator run(s) already RUNNING in "
            f"{RUN_TABLE}. Refusing to start a new run to avoid a RUN_ID "
            f"collision / interleaved attempt rows with that run. "
            f"Investigate {RUN_TABLE}, pass stale_after_hours=N to auto-close "
            f"old runs, or pass allow_run_with_stale_running_run=True."
        )

    run_id = _next_run_id()
    run_start = datetime.now()

    print("=============================================")
    print("STARTING ORCHESTRATOR RUN")
    print("Run ID       :", run_id)
    print("Run Start    :", run_start)
    print("Pipelines    :", len(pipeline_configs))
    print("Max parallel :", max_parallel)
    for k, cfg in enumerate(pipeline_configs):
        if deps[k]:
            waits_for = ", ".join(pipeline_configs[d]["pipeline_name"] for d in sorted(deps[k]))
            print(f"  {cfg['pipeline_name']} waits for: {waits_for}")
    print("=============================================")

    _append_row(RUN_TABLE, ORCHESTRATION_RUN_SCHEMA, [
        run_id, run_start, None, "RUNNING",
        len(pipeline_configs), 0, 0, None,
        triggered_by,
    ])

    results = {}
    failed_pipelines = []
    stop_event = threading.Event()

    try:
        outcomes = {}           # index -> (succeeded, result)

        if not parallel:
            # ---- One by one: same as the old loop -----------------------
            for i, cfg in enumerate(pipeline_configs):
                outcomes[i] = _run_pipeline_with_retry(
                    cfg, run_id, max_attempts, inter_attempt_wait_seconds,
                    retry_non_transient, False, stop_event,
                )
                if outcomes[i][0]:
                    results[cfg["pipeline_name"]] = outcomes[i][1]
                else:
                    failed_pipelines.append(cfg["pipeline_name"])

                # Free cached DataFrames before the next pipeline starts.
                spark.catalog.clearCache()

                if i < len(pipeline_configs) - 1 and inter_pipeline_wait_seconds:
                    # Executors stay allocated during this pause -- it does not
                    # free capacity, only paces the next request.
                    print(f"Pausing {inter_pipeline_wait_seconds}s before next pipeline "
                          f"(session stays active; capacity remains allocated)...")
                    time.sleep(inter_pipeline_wait_seconds)
        else:
            # ---- Parallel, dependency-ordered -------------------------------
            # A pipeline starts once everything it waits for has FINISHED
            # (success or failure -- the old loop also moved on after a
            # failure). Ready pipelines start in list order.
            pending = list(range(len(pipeline_configs)))
            finished = set()
            running = {}
            pool = ThreadPoolExecutor(max_workers=max_parallel,
                                      thread_name_prefix="pipeline")
            try:
                while pending or running:
                    for k in [k for k in pending if deps[k] <= finished]:
                        if len(running) >= max_parallel:
                            break
                        pending.remove(k)
                        cfg = pipeline_configs[k]
                        print(f"\n>>> START {cfg['pipeline_name']} "
                              f"({len(finished)}/{len(pipeline_configs)} done)")
                        running[pool.submit(
                            _run_pipeline_with_retry, cfg, run_id, max_attempts,
                            inter_attempt_wait_seconds, retry_non_transient,
                            True, stop_event,
                        )] = k

                    done, _ = wait(list(running), return_when=FIRST_COMPLETED)
                    for f in done:
                        k = running.pop(f)
                        try:
                            outcomes[k] = f.result()
                        except BaseException as e:   # should not happen; be safe
                            print(f"{pipeline_configs[k]['pipeline_name']} crashed: {e}")
                            outcomes[k] = (False, None)
                        finished.add(k)
                        print(f"<<< END {pipeline_configs[k]['pipeline_name']}: "
                              f"{'SUCCESS' if outcomes[k][0] else 'FAILED'}")
            except BaseException:
                # Interrupted: start nothing new, cancel running Spark jobs so
                # their pipelines close out as FAILED, then wait for them.
                stop_event.set()
                spark.sparkContext.cancelAllJobs()
                for f, k in list(running.items()):
                    try:
                        outcomes[k] = f.result()
                    except BaseException:
                        outcomes[k] = (False, None)
                for k in sorted(outcomes):
                    name = pipeline_configs[k]["pipeline_name"]
                    if outcomes[k][0]:
                        results[name] = outcomes[k][1]
                    else:
                        failed_pipelines.append(name)
                raise
            finally:
                pool.shutdown(wait=True)

            # Report in config order, like the one-by-one run.
            for k in range(len(pipeline_configs)):
                name = pipeline_configs[k]["pipeline_name"]
                if outcomes[k][0]:
                    results[name] = outcomes[k][1]
                else:
                    failed_pipelines.append(name)

        run_end = datetime.now()
        status = "SUCCESS" if not failed_pipelines else ("PARTIAL_FAILURE" if results else "FAILED")

        _update_run_row(run_id, {
            "RUN_END_DTTM": run_end,
            "STATUS": status,
            "SUCCEEDED_COUNT": len(results),
            "FAILED_COUNT": len(failed_pipelines),
            "FAILED_PIPELINE_NAMES": ",".join(failed_pipelines) if failed_pipelines else None,
        })

        print("=============================================")
        print(f"Run ID: {run_id} | Completed: {len(results)}/{len(pipeline_configs)}")
        if failed_pipelines:
            print("FAILED:", failed_pipelines)
        print("=============================================")

        outcome = {
            "run_id": run_id,
            "status": status,
            "results": results,
            "failed_pipelines": failed_pipelines,
        }

        if failed_pipelines and raise_on_failure:
            # Run row is already closed above; this only surfaces the failure
            # to the Fabric schedule / pipeline activity.
            raise RuntimeError(
                f"Orchestrator run {run_id} finished with status {status}. "
                f"Failed pipelines: {failed_pipelines}"
            )

        return outcome

    except BaseException as e:
        # Only close the run row here if it is still RUNNING (i.e. the failure
        # came from outside the normal completion path, or the cell was
        # interrupted) -- otherwise keep the accurate status written above.
        still_running = (
            spark.table(RUN_TABLE)
            .filter((col("RUN_ID") == run_id) & (col("STATUS") == "RUNNING"))
            .count() > 0
        )
        if still_running:
            _update_run_row(run_id, {
                "RUN_END_DTTM": datetime.now(),
                "STATUS": "FAILED",
                "SUCCEEDED_COUNT": len(results),
                "FAILED_COUNT": len(pipeline_configs) - len(results),
                "FAILED_PIPELINE_NAMES": (
                    ",".join(failed_pipelines) if failed_pipelines else str(e)[:1000]
                ),
            })
        raise


# ============================================================
# Run it
# ============================================================

if __name__ == "__main__":
    outcome = run_orchestrator(pipeline_configs)
