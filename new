-- Oracle
SELECT last_refresh_date FROM all_mviews WHERE mview_name = 'MV_ALLERGY_MEDS';
SELECT EXTRACT(YEAR FROM contact_date) yr, COUNT(*) FROM ALLERGY.MV_ALLERGY_MEDS GROUP BY EXTRACT(YEAR FROM contact_date) ORDER BY 1;
SELECT NVL(is_active_yn,'NULL') a, COUNT(*) FROM ALLERGY.MV_ALLERGY_MEDS GROUP BY NVL(is_active_yn,'NULL');

-- Fabric
SELECT year(CONTACT_DATE) yr, COUNT(*) FROM ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_MEDS WHERE IS_DELETED = 0 GROUP BY 1 ORDER BY 1;
SELECT COALESCE(IS_ACTIVE_YN,'NULL') a, COUNT(*) FROM ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_MEDS WHERE IS_DELETED = 0 GROUP BY 1;
