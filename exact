WITH note_dates AS (
    SELECT NOTE_ID,
           CONTACT_DATE,
           CONTACT_DATE_REAL,
           LINE,
           NOTE_TEXT
    FROM CLARITY.HNO_NOTE_TEXT
    WHERE CONTACT_DATE >= TO_DATE('06/15/2026','mm/dd/yyyy')
    AND   CONTACT_DATE <= TO_DATE('06/30/2026','mm/dd/yyyy')
),
smartphrase_notes AS (
    SELECT DISTINCT NOTE_ID
    FROM CLARITY.NOTE_SMARTPHRASE_IDS
    WHERE SMARTPHRASES_ID IN (592203,592204,481086,573124)
),
matched_lines AS (
    SELECT ND.*
    FROM note_dates ND
    LEFT JOIN smartphrase_notes SP
        ON SP.NOTE_ID = ND.NOTE_ID
    WHERE SP.NOTE_ID IS NOT NULL
       OR UPPER(ND.NOTE_TEXT) LIKE '%SBIRT%'
),
ranked AS (
    SELECT DISTINCT
           PT.PAT_MRN_ID        AS mrn,
           TBL.PERSON_ID        AS personid,
           ENC.PAT_ENC_CSN_ID   AS encounter_id,
           EMP.NAME             AS author_name,
           ML.CONTACT_DATE      AS interviewdate,
           ML.LINE              AS line,
           ML.NOTE_TEXT         AS note_text,
           ROW_NUMBER() OVER (
               PARTITION BY HNO.NOTE_ID
               ORDER BY ML.CONTACT_DATE_REAL DESC, ML.LINE DESC
           ) AS rn
    FROM TBL_PERSON_ID_1585 TBL
    JOIN CLARITY.PATIENT PT
        ON PT.PAT_ID = TBL.PAT_ID
    JOIN CLARITY.PAT_ENC ENC
        ON ENC.PAT_ID = PT.PAT_ID
    JOIN CLARITY.HNO_INFO HN
        ON HN.PAT_ENC_CSN_ID = ENC.PAT_ENC_CSN_ID
    JOIN matched_lines ML
        ON ML.NOTE_ID = HN.NOTE_ID
    JOIN CLARITY.NOTE_ENC_INFO HNO
        ON HNO.NOTE_ID = HN.NOTE_ID
--      AND HNO.SENSITIVE_STAT_C = 1
    LEFT JOIN CLARITY.CLARITY_EMP EMP
        ON EMP.USER_ID = HNO.AUTHOR_USER_ID
--  WHERE ENC.PAT_ENC_CSN_ID = '607886466'
)
SELECT mrn, personid, encounter_id, author_name, interviewdate, line, note_text
FROM ranked
WHERE rn = 1
ORDER BY mrn, encounter_id, line;
