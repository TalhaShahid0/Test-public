                PE.DEPARTMENT_ID AS VISIT_PROVIDER_DEPARTMENT_ID,
                DEP.DEPARTMENT_NAME AS VISIT_PROVIDER_DEPARTMENT,
                SER2.PROV_ID AS VISIT_PROVIDER_ID,
                SER2.PROV_NAME AS VISIT_PROVIDER,
                OPN.OTHER_PROVIDER_NAME AS OTHER_PROVIDER_NAME,
                OPD.OTHER_DEPARTMENT_NAME AS OTHER_DEPARTMENT_NAME,
                APN.APPOINTMENT_NOTES AS APPOINTMENT_NOTES
            FROM {ACTIVE_TBL_PAT_ID} MVP
            INNER JOIN CLARITY_LH.CLARITY.PATIENT PAT
                ON PAT.PAT_ID = MVP.PAT_ID
            INNER JOIN CLARITY_LH.CLARITY.PAT_ENC PE
