                PAT.DEATH_DATE AS DEATH_DATE,
                SER.PROV_NAME AS PROV_NAME
            -- v2: TBL_PAT_ID and PAT_ENC only decide WHICH patients (no column is
            -- selected from them, result is GROUP BY + MAX) -> LEFT SEMI JOIN.
            -- Same rows, without one copy of each patient per encounter.
            FROM CLARITY_LH.CLARITY.PATIENT PAT
            LEFT SEMI JOIN {ACTIVE_TBL_PAT_ID} CCED
                ON PAT.PAT_ID = CCED.PAT_ID
            LEFT SEMI JOIN CLARITY_LH.CLARITY.PAT_ENC PE
                ON PAT.PAT_ID = PE.PAT_ID
            LEFT JOIN CLARITY_LH.CLARITY.ZC_SEX ZSEX
                ON PAT.SEX_C = ZSEX.RCPT_MEM_SEX_C
            LEFT JOIN CLARITY_LH.CLARITY.ZC_STATE ZST
                ON PAT.STATE_C = ZST.STATE_C
            LEFT JOIN CLARITY_LH.CLARITY.ZC_COUNTRY ZCTRY
                ON PAT.COUNTRY_C = ZCTRY.COUNTRY_C
            LEFT JOIN CLARITY_LH.CLARITY.ZC_COUNTY ZCNTY
                ON PAT.COUNTY_C = ZCNTY.COUNTY_C
            LEFT JOIN CLARITY_LH.CLARITY.ZC_ETHNIC_GROUP ZEG
                ON PAT.ETHNIC_GROUP_C = ZEG.ETHNIC_GROUP_C
            LEFT JOIN CLARITY_LH.CLARITY.ZC_MARITAL_STATUS ZMS
                ON PAT.MARITAL_STATUS_C = ZMS.MARITAL_STATUS_C
            LEFT JOIN CLARITY_LH.CLARITY.EMERGENCY_CONTACTS EC
                ON PAT.PAT_ID = EC.PAT_ID
            LEFT JOIN CLARITY_LH.CLARITY.CLARITY_SER SER
                ON PAT.CUR_PCP_PROV_ID = SER.PROV_ID
            LEFT JOIN CLARITY_LH.CLARITY.ZC_PATIENT_STATUS ZPS
                ON PAT.PAT_STATUS_C = ZPS.PATIENT_STATUS_C
            LEFT JOIN RACE_AGG
                ON RACE_AGG.PAT_ID = PAT.PAT_ID
            GROUP BY
                PAT.PAT_MRN_ID,
