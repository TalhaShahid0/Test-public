    {
        "pipeline_name": "TBL_ALLERGY_SKINTEST",
        "target_table": "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_SKINTEST",
        "batch_table": "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES",
        "source_query": """
            WITH latest_form_date AS (
                SELECT form_id, MAX(contact_date_real) AS max_contact_date_real
                FROM CLARITY_LH.CLARITY.SMARTFORM_CONCEPT
                WHERE form_id IN ('7','8','9','10','11','12','13','6','110')
                GROUP BY form_id
            ),
            filtered_concepts AS (
                SELECT sc.form_id, sc.concept_id
                FROM CLARITY_LH.CLARITY.SMARTFORM_CONCEPT sc
                INNER JOIN latest_form_date lfd
                    ON sc.form_id = lfd.form_id
                    AND sc.contact_date_real = lfd.max_contact_date_real
                INNER JOIN CLARITY_LH.CLARITY.CLARITY_CONCEPT cc
                    ON sc.concept_id = cc.concept_id
                    AND cc.concept_id LIKE '%AMB%'
                WHERE sc.form_id IN ('7','8','9','10','11','12','13','6','110')
            ),
            -- ---- pruning only: these CTEs just pre-filter the big tables to rows that
            -- ---- the original joins would keep anyway (semi join = inner join filter)
            concept_ids AS (
                SELECT DISTINCT concept_id FROM filtered_concepts
            ),
            nc_f AS (
                SELECT /*+ BROADCAST(c) */ nc.*
                FROM CLARITY_LH.CLARITY.NOTE_CONCEPT nc
                LEFT SEMI JOIN concept_ids c
                    ON nc.concept_id = c.concept_id
            ),
            note_ids AS (
                SELECT DISTINCT hno_id AS note_id FROM nc_f
            ),
            eni_f AS (
                SELECT eni.*
                FROM CLARITY_LH.CLARITY.NOTE_ENC_INFO eni
                LEFT SEMI JOIN note_ids n
                    ON eni.note_id = n.note_id
            ),
            hn_f AS (
                SELECT hn.*
                FROM CLARITY_LH.CLARITY.HNO_INFO hn
                LEFT SEMI JOIN note_ids n
                    ON hn.note_id = n.note_id
            ),
            csn_ids AS (
                SELECT DISTINCT pat_enc_csn_id FROM hn_f
            ),
            pe_f AS (
                SELECT pe.*
                FROM CLARITY_LH.CLARITY.PAT_ENC pe
                LEFT SEMI JOIN csn_ids c
                    ON pe.pat_enc_csn_id = c.pat_enc_csn_id
            )
            SELECT /*+ BROADCAST(fc, cq, dep) */ DISTINCT
                pat.pat_id               AS pat_id,
                pe.pat_enc_csn_id        AS pat_enc_csn_id,
                cq.form_name             AS form_name,
                cq.form_id               AS form_id,
                cc.name                  AS concept_name,
                cc.abbreviation          AS abbreviation,
                nc.concept_value         AS concept_value,
                cc.concept_id            AS concept_id,
                nc.concept_source        AS concept_source,
                dep.department_id        AS department_id,
                dep.department_name      AS department_name,
                eni.note_id              AS note_encounter_note_id,
                eni.author_user_id       AS note_author_id,
                emp.name                 AS note_author_name,
                eni.entry_instant_dttm   AS note_created
            FROM CLARITY_LH.CLARITY.PATIENT AS pat
            INNER JOIN pe_f AS pe
                ON pe.pat_id = pat.pat_id
            INNER JOIN hn_f AS hn
                ON pe.pat_enc_csn_id = hn.pat_enc_csn_id
            INNER JOIN eni_f AS eni
                ON hn.note_id = eni.note_id
            INNER JOIN CLARITY_LH.CLARITY.CLARITY_DEP AS dep
                ON pe.department_id = dep.department_id
            INNER JOIN CLARITY_LH.CLARITY.CLARITY_EMP AS emp
                ON eni.author_user_id = emp.user_id
            INNER JOIN nc_f AS nc
                ON nc.hno_id = eni.note_id
            INNER JOIN filtered_concepts AS fc
                ON nc.concept_id = fc.concept_id
            INNER JOIN CLARITY_LH.CLARITY.CLARITY_CONCEPT AS cc
                ON cc.concept_id = fc.concept_id
            INNER JOIN CLARITY_LH.CLARITY.CL_QFORM AS cq
                ON fc.form_id = cq.form_id
        """,
        "primary_keys": "",
        "non_key_columns": "PAT_ID,PAT_ENC_CSN_ID,FORM_NAME,FORM_ID,CONCEPT_NAME,ABBREVIATION,CONCEPT_VALUE,CONCEPT_ID,CONCEPT_SOURCE,DEPARTMENT_ID,DEPARTMENT_NAME,NOTE_ENCOUNTER_NOTE_ID,NOTE_AUTHOR_ID,NOTE_AUTHOR_NAME,NOTE_CREATED",
        "identity_column": "ALLERGY_SKINTEST_KEY",
        "load_type": "FULL",
    },



    {
        "pipeline_name": "TBL_ALLERGY_VISITS",
        "target_table": "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_VISITS",
        "batch_table": "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES",
        "source_query": f"""

        WITH flowsheet_active AS (
            SELECT *
            FROM (
                SELECT *,
                       ROW_NUMBER() OVER (PARTITION BY row_hash ORDER BY dw_updated_at DESC) AS rn
                FROM ALLERGY_LH.ALLERGY_DELTA.TBL_VISITS_FLOWSHEET_MEASURE
            )
            WHERE rn = 1 AND is_deleted = 0
        )
        SELECT
            pt.pat_mrn_id AS pat_mrn_id,
            pt.pat_name AS pat_name,
            pt.pat_first_name AS pat_first_name,
            pt.pat_last_name AS pat_last_name,
            pt.pat_middle_name AS pat_middle_name,
            pt.pat_id AS pat_id,
            en.pat_enc_csn_id AS pat_enc_csn_id,
            en.contact_date AS contact_date,
            en.enc_close_date AS enc_close_date,
            pcp.prov_id AS pcp_provider_id,
            pcp.prov_name AS pcp_provider,
            vst.prov_id AS visit_provider_id,
            vst.prov_name AS visit_provider,
            prc.prc_name AS prc_name,
            zdet.name AS enc_type_title,
            ROUND ( ( CAST (SUBSTR (en.height, 1, INSTR (en.height, "'") - 1) AS DOUBLE) * 30.48), 4)
          + ROUND ( ( CAST (SUBSTR (en.height, INSTR (en.height, "'") + 1,
                        (INSTR (en.height, '"') - INSTR (en.height, "'")) - 1) AS DOUBLE) * 2.54), 4)
              AS height_in_cms,
            en.height AS height,
            hgt.percentile_value AS ht_age_perc,
            wgt.percentile_value AS wt_age_perc,
            bmi.percentile_value AS bmi_age_perc,
            len.percentile_value AS wt_length_perc,
            ROUND ( (CAST (en.weight AS DOUBLE) * 0.02835), 4) AS weight_in_kgs,
            en.weight AS weight,
            en.bmi AS bmi,
            en.bp_systolic AS bp_systolic,
            en.bp_diastolic AS bp_diastolic,
            en.temperature AS temperature,
            en.pulse AS pulse,
            en.respirations AS respirations,
            en.department_id AS deparment_id,
            dep.department_name AS department_name,
            en.checkin_time AS checkin_time,
            en.appt_made_date AS appt_made_date,
            en.appt_time AS appt_time,
            en.arvl_lst_dl_time AS remove_arrival_time,
            en.los_proc_code AS los_proc_code,
            eap.proc_name AS los_proc_name,
            en.los_prime_proc_id AS los_prime_proc_id,
            en.hosp_admsn_time AS hosp_admsn_time,
            en.hosp_dischrg_time AS hosp_dischrg_time
        FROM {ACTIVE_TBL_PAT_ID} mvp
        JOIN CLARITY_LH.CLARITY.PATIENT pt
          ON pt.pat_id = mvp.pat_id
        JOIN CLARITY_LH.CLARITY.PAT_ENC en
          ON en.pat_id = pt.pat_id
        LEFT JOIN CLARITY_LH.CLARITY.CLARITY_PRC prc
          ON en.appt_prc_id = prc.prc_id
        LEFT JOIN CLARITY_LH.CLARITY.CLARITY_DEP dep
          ON en.department_id = dep.department_id
        LEFT JOIN CLARITY_LH.CLARITY.CLARITY_EAP eap
          ON en.los_prime_proc_id = eap.proc_id
        LEFT JOIN CLARITY_LH.CLARITY.CLARITY_SER pcp
          ON pt.cur_pcp_prov_id = pcp.prov_id
        LEFT JOIN CLARITY_LH.CLARITY.CLARITY_SER vst
          ON en.visit_prov_id = vst.prov_id
        LEFT JOIN CLARITY_LH.CLARITY.ZC_DISP_ENC_TYPE zdet
          ON en.enc_type_c = zdet.disp_enc_type_c
        -- Weight
        LEFT JOIN flowsheet_active wgt
          ON en.pat_enc_csn_id = wgt.pat_enc_csn_id
         AND en.pat_id = wgt.pat_id
         AND wgt.template_id = '103'
         AND wgt.row_meas_id = '3478'
        -- Height
        LEFT JOIN flowsheet_active hgt
          ON en.pat_enc_csn_id = hgt.pat_enc_csn_id
         AND en.pat_id = hgt.pat_id
         AND hgt.template_id = '103'
         AND hgt.row_meas_id = '3480'
        -- BMI
        LEFT JOIN flowsheet_active bmi
          ON en.pat_enc_csn_id = bmi.pat_enc_csn_id
         AND en.pat_id = bmi.pat_id
         AND bmi.template_id = '103'
         AND bmi.row_meas_id = '3481'
        -- Length
        LEFT JOIN flowsheet_active len
          ON en.pat_enc_csn_id = len.pat_enc_csn_id
         AND en.pat_id = len.pat_id
         AND len.template_id = '103'
         AND len.row_meas_id = '3488'

        """,
        "primary_keys": "",
        "non_key_columns": "PAT_ID, PAT_ENC_CSN_ID, PAT_MRN_ID, PAT_NAME, PAT_FIRST_NAME, PAT_LAST_NAME, PAT_MIDDLE_NAME, "
                           "CONTACT_DATE, ENC_CLOSE_DATE, PCP_PROVIDER_ID, PCP_PROVIDER, "
                           "VISIT_PROVIDER_ID, VISIT_PROVIDER, PRC_NAME, ENC_TYPE_TITLE, "
                           "HEIGHT_IN_CMS, HEIGHT, HT_AGE_PERC, WT_AGE_PERC, BMI_AGE_PERC, "
                           "WT_LENGTH_PERC, WEIGHT_IN_KGS, WEIGHT, BMI, BP_SYSTOLIC, BP_DIASTOLIC, "
                           "TEMPERATURE, PULSE, RESPIRATIONS, DEPARMENT_ID, DEPARTMENT_NAME, "
                           "CHECKIN_TIME, APPT_MADE_DATE, APPT_TIME, REMOVE_ARRIVAL_TIME, "
                           "LOS_PROC_CODE, LOS_PROC_NAME, LOS_PRIME_PROC_ID, HOSP_ADMSN_TIME, "
                           "HOSP_DISCHRG_TIME",
        "identity_column": "ALLERGY_VISITS_KEY",
        "load_type": "FULL",
    },



    {
        "pipeline_name": "TBL_ALLERGY_NOTES_C",
        "target_table": "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_NOTES_C",
        "batch_table": "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES",
        "source_query": r"""
            WITH cced AS (
                SELECT PAT_ENC_CSN_ID
                FROM (
                    SELECT PAT_ENC_CSN_ID, IS_DELETED,
                           ROW_NUMBER() OVER (
                               PARTITION BY ROW_HASH
                               ORDER BY DW_UPDATED_AT DESC, BATCH_ID DESC
                           ) AS rn
                    FROM ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_PAT_ENC
                ) t
                WHERE rn = 1 AND COALESCE(IS_DELETED, 0) = 0
            ),
            notes AS (
                SELECT /*+ BROADCAST(nti) */
                    hno.PAT_ENC_CSN_ID,
                    hno.IP_NOTE_TYPE_C,
                    nti.NAME AS IP_NOTE_TYPE,
                    hno.CM_PHY_OWNER_ID,
                    hno.CM_LOG_OWNER_ID,
                    hno.NOTE_DESC,
                    hno.NOTE_ID
                FROM cced
                INNER JOIN CLARITY_LH.CLARITY.HNO_INFO hno
                    ON cced.PAT_ENC_CSN_ID = hno.PAT_ENC_CSN_ID
                   AND (hno.DELETE_USER_ID IS NULL OR hno.DELETE_INSTANT_DTTM IS NULL)
                LEFT JOIN CLARITY_LH.CLARITY.ZC_NOTE_TYPE_IP nti
                    ON hno.IP_NOTE_TYPE_C = nti.TYPE_IP_C
            ),
            note_ids AS (
                SELECT DISTINCT NOTE_ID FROM notes
            ),
            nei AS (
                SELECT /*+ BROADCAST(ztt, ztas, zss, znf, ns) */
                    e.NOTE_ID,
                    e.CONTACT_SERIAL_NUM,
                    e.AUTHOR_USER_ID          AS NOTE_AUTHOR_USR_ID,
                    e.UPDATE_USER_ID          AS NOTE_EDITOR_USR_ID,
                    e.UPD_AUTHOR_INS_DTTM     AS EDIT_INST,
                    e.NOTE_FILE_TIME_DTTM     AS FILING_DATE,
                    e.NOTE_STATUS_C           AS NOTE_STAT_C,
                    ns.NAME                   AS NOTE_STATUS,
                    ztt.NAME                  AS TRANSCRIPTION_TYPE,
                    e.TRN_DOC_AVAIL_STA_C,
                    ztas.NAME                 AS TRANSCRIPTION_STATUS,
                    e.SENSITIVE_STAT_C,
                    zss.NAME                  AS SENSITIVE_STAT,
                    e.NOTE_FORMAT_C,
                    znf.NAME                  AS NOTE_FORMAT,
                    e.SPEC_NOTE_TIME_DTTM     AS SPECIFIED_DATETIME
                FROM (
                    SELECT *
                    FROM CLARITY_LH.CLARITY.NOTE_ENC_INFO x
                    LEFT SEMI JOIN note_ids n ON x.NOTE_ID = n.NOTE_ID
                ) e
                LEFT JOIN CLARITY_LH.CLARITY.ZC_TRANS_TYPE ztt
                    ON e.TRN_DOC_TYPE_C = ztt.TRANS_TYPE_C
                LEFT JOIN CLARITY_LH.CLARITY.ZC_TRANS_AVAIL_STS ztas
                    ON e.TRN_DOC_AVAIL_STA_C = ztas.TRANS_AVAIL_STS_C
                LEFT JOIN CLARITY_LH.CLARITY.ZC_SENSITIVE_ST zss
                    ON e.SENSITIVE_STAT_C = zss.SENSITIVE_ST_C
                LEFT JOIN CLARITY_LH.CLARITY.ZC_NOTE_FORMAT znf
                    ON e.NOTE_FORMAT_C = znf.NOTE_FORMAT_C
                LEFT JOIN CLARITY_LH.CLARITY.ZC_NOTE_STATUS ns
                    ON e.NOTE_STATUS_C = ns.NOTE_STATUS_C
            ),
            hnt AS (
                SELECT h.NOTE_ID, h.NOTE_CSN_ID, h.CONTACT_DATE_REAL, h.LINE, h.NOTE_TEXT
                FROM CLARITY_LH.CLARITY.HNO_NOTE_TEXT h
                LEFT SEMI JOIN note_ids n ON h.NOTE_ID = n.NOTE_ID
                WHERE length(trim(h.NOTE_TEXT)) > 0
            ),
            note_data AS (
                SELECT
                    notes.PAT_ENC_CSN_ID,
                    notes.IP_NOTE_TYPE_C,
                    notes.IP_NOTE_TYPE,
                    notes.CM_PHY_OWNER_ID,
                    notes.CM_LOG_OWNER_ID,
                    notes.NOTE_DESC,
                    notes.NOTE_ID,
                    hnt.NOTE_CSN_ID,
                    hnt.CONTACT_DATE_REAL,
                    nei.NOTE_AUTHOR_USR_ID,
                    nei.NOTE_EDITOR_USR_ID,
                    nei.EDIT_INST,
                    nei.FILING_DATE,
                    nei.NOTE_STAT_C,
                    nei.NOTE_STATUS,
                    nei.TRANSCRIPTION_TYPE,
                    nei.TRN_DOC_AVAIL_STA_C,
                    nei.TRANSCRIPTION_STATUS,
                    CAST(NULL AS STRING) AS TRN_DOC_DESCENDANTS,
                    nei.SENSITIVE_STAT_C,
                    nei.SENSITIVE_STAT,
                    nei.NOTE_FORMAT_C,
                    nei.NOTE_FORMAT,
                    nei.SPECIFIED_DATETIME,
                    hnt.LINE,
                    hnt.NOTE_TEXT,
                    RANK() OVER (
                        PARTITION BY notes.NOTE_ID
                        ORDER BY hnt.CONTACT_DATE_REAL DESC NULLS FIRST
                    ) AS RN
                FROM notes
                INNER JOIN nei
                    ON notes.NOTE_ID = nei.NOTE_ID
                INNER JOIN hnt
                    ON nei.NOTE_ID = hnt.NOTE_ID
                   AND nei.CONTACT_SERIAL_NUM = hnt.NOTE_CSN_ID
            ),
            latest AS (
                -- Keep only most recent per NOTE_ID; build each XMLELEMENT(e, ...) piece
                SELECT
                    d.*,
                    concat(
                        '<E>',
                        replace(replace(replace(replace(replace(
                            regexp_replace(upper(trim(d.NOTE_TEXT)), '[\\p{Cc}]', ''),
                            '&', '&amp;'), '<', '&lt;'), '>', '&gt;'),
                            '"', '&quot;'), "'", '&apos;'),
                        char(13),
                        '</E>'
                    ) AS XML_PIECE
                FROM note_data d
                WHERE d.RN = 1
            )
            SELECT
                PAT_ENC_CSN_ID,
                IP_NOTE_TYPE_C,
                IP_NOTE_TYPE,
                CM_PHY_OWNER_ID,
                CM_LOG_OWNER_ID,
                NOTE_DESC,
                NOTE_ID,
                NOTE_CSN_ID,
                CONTACT_DATE_REAL,
                NOTE_AUTHOR_USR_ID,
                NOTE_EDITOR_USR_ID,
                EDIT_INST,
                FILING_DATE,
                NOTE_STAT_C,
                NOTE_STATUS,
                TRANSCRIPTION_TYPE,
                TRN_DOC_AVAIL_STA_C,
                TRANSCRIPTION_STATUS,
                TRN_DOC_DESCENDANTS,
                SENSITIVE_STAT_C,
                SENSITIVE_STAT,
                NOTE_FORMAT_C,
                NOTE_FORMAT,
                SPECIFIED_DATETIME,
                array_join(
                    transform(
                        array_sort(collect_list(named_struct('line', LINE, 'txt', XML_PIECE))),
                        x -> x.txt
                    ),
                    ''
                ) AS NOTE_TEXT
            FROM latest
            GROUP BY
                PAT_ENC_CSN_ID,
                IP_NOTE_TYPE_C,
                IP_NOTE_TYPE,
                CM_PHY_OWNER_ID,
                CM_LOG_OWNER_ID,
                NOTE_DESC,
                NOTE_ID,
                NOTE_CSN_ID,
                CONTACT_DATE_REAL,
                NOTE_AUTHOR_USR_ID,
                NOTE_EDITOR_USR_ID,
                EDIT_INST,
                FILING_DATE,
                NOTE_STAT_C,
                NOTE_STATUS,
                TRANSCRIPTION_TYPE,
                TRN_DOC_AVAIL_STA_C,
                TRANSCRIPTION_STATUS,
                TRN_DOC_DESCENDANTS,
                SENSITIVE_STAT_C,
                SENSITIVE_STAT,
                NOTE_FORMAT_C,
                NOTE_FORMAT,
                SPECIFIED_DATETIME
        """,

        "primary_keys": "",
        "non_key_columns": "PAT_ENC_CSN_ID,IP_NOTE_TYPE_C,IP_NOTE_TYPE,CM_PHY_OWNER_ID,CM_LOG_OWNER_ID,NOTE_DESC,NOTE_ID,NOTE_CSN_ID,CONTACT_DATE_REAL,NOTE_AUTHOR_USR_ID,NOTE_EDITOR_USR_ID,EDIT_INST,FILING_DATE,NOTE_STAT_C,NOTE_STATUS,TRANSCRIPTION_TYPE,TRN_DOC_AVAIL_STA_C,TRANSCRIPTION_STATUS,TRN_DOC_DESCENDANTS,SENSITIVE_STAT_C,SENSITIVE_STAT,NOTE_FORMAT_C,NOTE_FORMAT,SPECIFIED_DATETIME,NOTE_TEXT",
        "identity_column": "ALLERGY_NOTES_C_KEY",
        "load_type": "FULL",
    },


    {
        "pipeline_name": "TBL_MRN_HIST",
        "target_table": "ALLERGY_LH.ALLERGY_DELTA.TBL_MRN_HIST",
        "batch_table": "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES",
        "source_query": f"""
            SELECT
                id_hist.PAT_ID,
                id_hist.LINE,
                id_hist.OLD_PAT_ID,
                id_hist.ID_HX,
                id_hist.IDENTITY_NEW_ID,
                ct.NAME AS CHANGE_TYPE,
                id_hist.ID_CHG_DATE

            FROM CLARITY_LH.CLARITY.IDENTITY_ID_HX id_hist

            INNER JOIN {ACTIVE_TBL_PAT_ID} mv
                ON mv.PAT_ID = id_hist.PAT_ID

            LEFT JOIN CLARITY_LH.CLARITY.ZC_ID_CHG_TYPE ct
                ON ct.ID_CHG_TYPE_C = id_hist.ID_CHG_TYPE_C
        """,
        "primary_keys": "PAT_ID,LINE",
        "non_key_columns": "OLD_PAT_ID,ID_HX,IDENTITY_NEW_ID,CHANGE_TYPE,ID_CHG_DATE",
        "identity_column": "MRN_HIST_KEY",
        "load_type": "FULL",
    }

]
