        "primary_keys": "",
        "non_key_columns": "PAT_MRN_ID, PAT_ID, PAT_NAME, PAT_FIRST_NAME, PAT_MIDDLE_NAME, PAT_LAST_NAME, BIRTH_DATE, SEX, RACE, ETHNICITY, MARITAL_STATUS, FATHER_NAME, MOTHER_NAME, GUARDIAN_NAME, ADD_LINE_1, ADD_LINE_2, CITY, STATE, ZIP, COUNTRY, COUNTY, HOME_PHONE, WORK_PHONE, EMAIL_ADDRESS, PAT_STATUS, DEATH_DATE, PROV_NAME",
