                PAT.PAT_NAME AS PAT_NAME,
                SEX.NAME AS SEX,
                PAT.BIRTH_DATE AS BIRTH_DATE,
                PAT.PAT_MRN_ID AS PAT_MRN_ID,
                PE.PAT_ID AS PAT_ID,
                PE.PAT_ENC_CSN_ID AS PAT_ENC_CSN_ID,
                PE.APPT_TIME AS APPT_TIME,
                PE.APPT_MADE_DATE AS APPT_MADE_DATE,
                PE.APPT_LENGTH AS APPT_LENGTH,
                PE.APPT_STATUS_C AS APPT_STATUS_C,
                PE.REFERRAL_SOURCE_ID AS REFERRAL_SOURCE_ID,
                RS.REFERRING_PROV_NAM AS REFERRING_PROV_NAME,
                ZAS.NAME AS APPT_STATUS,
                ZDET.NAME AS ENC_TYPE_TITLE,
