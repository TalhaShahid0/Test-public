# ============================================================================
# CONFIG_NB (latest active version)
#
# Same as optimized_v2/CONFIG_NB.py, except: a query that joins one of OUR
# target tables (TBL_PAT_ID, TBL_APP_NOTE, TBL_ALLERGY_FLWSHT,
# TBL_ALLERGY_LABS_POP / _RESULTS / _PATHOLOGY) now reads only its LATEST
# ACTIVE rows, not the whole history. Those tables are append-only: every
# change adds a new version and a delete adds a soft-deleted version, so
# joining the raw table also picked up old and deleted versions (duplicate or
# stale rows). MEDS, OR_REPORT, NOTES_C and VISITS (flowsheet) already did this.
#
# Latest active = newest version per ROW_HASH (DW_UPDATED_AT, then BATCH_ID),
# and that version is not soft-deleted. This is the same rule MERGE_NB uses.
# The table name stays in the query text, so the orchestrator still sees
# which pipeline depends on which.
# ============================================================================

def latest_active(table):
    return f"""(
                SELECT * FROM (
                    SELECT LA.*,
                           ROW_NUMBER() OVER (
                               PARTITION BY LA.ROW_HASH
                               ORDER BY LA.DW_UPDATED_AT DESC, LA.BATCH_ID DESC
                           ) AS LATEST_RN
                    FROM {table} LA
                ) LA_V
                WHERE LA_V.LATEST_RN = 1 AND COALESCE(LA_V.IS_DELETED, 0) = 0
            )"""


