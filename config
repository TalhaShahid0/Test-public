                LEFT SEMI JOIN {ACTIVE_TBL_PAT_ID} M0
                    ON PE0.PAT_ID = M0.PAT_ID
            ),
            OPN AS (
                SELECT
                    APT.PAT_ENC_CSN_ID,
                    ARRAY_JOIN(
                        ARRAY_DISTINCT(
                            TRANSFORM(
                                SORT_ARRAY(
                                    COLLECT_LIST(STRUCT(APT.LINE AS LINE, LTRIM(SER1.PROV_NAME) AS PROV_NAME))
                                ),
                                X -> X.PROV_NAME
                            )
                        ),
                        ','
                    ) AS OTHER_PROVIDER_NAME
                FROM CLARITY_LH.CLARITY.PAT_ENC_APPT APT
                LEFT SEMI JOIN ENC_CSN ON ENC_CSN.PAT_ENC_CSN_ID = APT.PAT_ENC_CSN_ID
                INNER JOIN CLARITY_LH.CLARITY.CLARITY_SER SER1
