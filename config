    {
        "pipeline_name": "TBL_ALLERGY_PFT",
        "target_table": "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_PFT",
        "batch_table": "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES",
        "source_query": f"""
            WITH concat_values AS (
                SELECT
                    PAT_ID,
                    PAT_ENC_CSN_ID,
                    ORDER_PROC_ID,
                    COMPONENT_ID,
                    CONCAT_WS(
                        ',',
                        ARRAY_DISTINCT(
                            TRANSFORM(
                                SORT_ARRAY(COLLECT_LIST(STRUCT(LINE AS LINE, LTRIM(ORD_VALUE) AS ORD_VALUE))),
                                X -> X.ORD_VALUE
                            )
                        )
                    ) AS CONCAT_VALUE
                FROM CLARITY_LH.CLARITY.ORDER_RESULTS
                WHERE COMPONENT_ID IN (16, 17, 19, 802494, 802495, 802496, 802497)
                GROUP BY PAT_ID, PAT_ENC_CSN_ID, ORDER_PROC_ID, COMPONENT_ID
            ),
            -- v2: the 7 components side by side, one row per order, so ORDER_RESULTS
            -- is read and joined once instead of 7 times. CVnnn = the old CVnnn.CONCAT_VALUE.
            cv AS (
                SELECT
                    PAT_ID,
                    PAT_ENC_CSN_ID,
                    ORDER_PROC_ID,
                    MAX(CASE WHEN COMPONENT_ID = 16 THEN CONCAT_VALUE END) AS CV16,
                    MAX(CASE WHEN COMPONENT_ID = 17 THEN CONCAT_VALUE END) AS CV17,
                    MAX(CASE WHEN COMPONENT_ID = 19 THEN CONCAT_VALUE END) AS CV19,
                    MAX(CASE WHEN COMPONENT_ID = 802494 THEN CONCAT_VALUE END) AS CV802494,
                    MAX(CASE WHEN COMPONENT_ID = 802495 THEN CONCAT_VALUE END) AS CV802495,
                    MAX(CASE WHEN COMPONENT_ID = 802496 THEN CONCAT_VALUE END) AS CV802496,
                    MAX(CASE WHEN COMPONENT_ID = 802497 THEN CONCAT_VALUE END) AS CV802497
                FROM concat_values
                GROUP BY PAT_ID, PAT_ENC_CSN_ID, ORDER_PROC_ID
            )
            SELECT
                PT.PAT_MRN_ID AS PAT_MRN_ID,
                PT.PAT_NAME AS PAT_NAME,
                OP.PAT_ID AS PAT_ID,
                OP.PAT_ENC_CSN_ID AS PAT_ENC_CSN_ID,
                OP.ORDER_PROC_ID AS ORDER_PROC_ID,
                ZDET.NAME AS ENC_TYPE_TITLE,
                R.RESULT_TIME AS RESULT_TIME,
                R.RESULT_DATE AS RESULT_DATE,
                R.LAB_STATUS_C AS LAB_STATUS_C,
                R.ORD_DATE_REAL AS ORD_DATE_REAL,
                R.ORD_END_DATE_REAL AS ORD_END_DATE_REAL,
                DEP.DEPARTMENT_ID AS DEPARTMENT_ID,
                DEP.DEPARTMENT_NAME AS DEPARTMENT_NAME,
                CASE
                    WHEN R.RESULT_STATUS_C = 2 THEN 'Preliminary'
                    WHEN R.RESULT_STATUS_C = 3 THEN 'Final'
                    WHEN R.RESULT_STATUS_C = 4 THEN 'Corrected'
                    WHEN R.RESULT_STATUS_C = 5 THEN 'Incomplete'
                    ELSE 'Unknown'
                END AS RESULT_STATUS,
                MAX(CASE WHEN R.COMPONENT_ID = 3 THEN R.ORD_VALUE END) AS LAST_NAME,
                MAX(CASE WHEN R.COMPONENT_ID = 4 THEN R.ORD_VALUE END) AS FIRST_NAME,
                MAX(CASE WHEN R.COMPONENT_ID = 5 THEN R.ORD_VALUE END) AS AGE,
                MAX(CASE WHEN R.COMPONENT_ID = 6 THEN R.ORD_VALUE END) AS GENDER,
                MAX(CASE WHEN R.COMPONENT_ID = 7 THEN R.ORD_VALUE END) AS RACE,
                MAX(CASE WHEN R.COMPONENT_ID = 9 THEN R.ORD_VALUE END) AS HEIGHT,
                MAX(CASE WHEN R.COMPONENT_ID = 10 THEN R.ORD_VALUE END) AS WEIGHT_DAILY,
                MAX(CASE WHEN R.COMPONENT_ID = 11 THEN R.ORD_VALUE END) AS BODY_MASS_INDEX,
                MAX(CASE WHEN R.COMPONENT_ID = 15 THEN R.ORD_VALUE END) AS TEST_DATE,
                MAX(CV.CV16) AS PHYSICIAN,
                MAX(CV.CV17) AS TECHNICIAN,
                MAX(CASE WHEN R.COMPONENT_ID = 18 THEN R.ORD_VALUE END) AS DIAGNOSIS,
                MAX(CV.CV19) AS PDF_FILE_LOCATION,
                MAX(CASE WHEN R.COMPONENT_ID = 31 THEN R.ORD_VALUE END) AS ISOFEF_25_75_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 32 THEN R.ORD_VALUE END) AS ISOFEF_25_75_MEASURED,
                MAX(CASE WHEN R.COMPONENT_ID = 33 THEN R.ORD_VALUE END) AS ISOFEF_25_75_PCT_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 802462 THEN R.ORD_VALUE END) AS FVC_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 802463 THEN R.ORD_VALUE END) AS FVC_MEASURED,
                MAX(CASE WHEN R.COMPONENT_ID = 802464 THEN R.ORD_VALUE END) AS FVC_PCT_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 802465 THEN R.ORD_VALUE END) AS FEV1_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 802466 THEN R.ORD_VALUE END) AS FEV1_MEASURED,
                MAX(CASE WHEN R.COMPONENT_ID = 802467 THEN R.ORD_VALUE END) AS FEV1_PCT_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 802468 THEN R.ORD_VALUE END) AS FEV1_FVC_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 802469 THEN R.ORD_VALUE END) AS FEV1_FVC_MEASURED,
                MAX(CASE WHEN R.COMPONENT_ID = 802470 THEN R.ORD_VALUE END) AS FEF_25_75_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 802471 THEN R.ORD_VALUE END) AS FEF_25_75_MEASURED,
                MAX(CASE WHEN R.COMPONENT_ID = 802472 THEN R.ORD_VALUE END) AS FEF_25_75_PCT_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 802473 THEN R.ORD_VALUE END) AS MVV_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 802474 THEN R.ORD_VALUE END) AS MVV_MEASURED,
                MAX(CASE WHEN R.COMPONENT_ID = 802475 THEN R.ORD_VALUE END) AS PI_MAX_REFERENCE,
                MAX(CASE WHEN R.COMPONENT_ID = 802476 THEN R.ORD_VALUE END) AS PI_MAX_MEASURED,
                MAX(CASE WHEN R.COMPONENT_ID = 802477 THEN R.ORD_VALUE END) AS PE_MAX_REFERENCE,
