    {
        "pipeline_name": "TBL_ALLERGY_FLWSHT",
        "target_table": "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_FLWSHT",
        "batch_table": "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES",
        "source_query": f"""
            WITH FM AS (
                SELECT ID AS FLO_MEAS_ID, MEASUREMENT_ID AS GRP_FLO_MEAS_ID
                FROM (
                    SELECT
                        ID,
                        LINE,
                        MEASUREMENT_ID,
                        CONTACT_DATE_REAL,
                        RANK() OVER (PARTITION BY ID ORDER BY CONTACT_DATE_REAL DESC) AS R
                    FROM CLARITY_LH.CLARITY.IP_FLO_MEASUREMNTS
                )
                WHERE R = 1
            )
            SELECT DISTINCT
                FD.TEMPLATE_ID AS TEMPLATE_ID,
                FD.TEMPLATE_NAME AS TEMPLATE_NAME,
                FD.DISPLAY_NAME AS DISPLAY_NAME,
                FD.TIME_INTERVAL AS TIME_INTERVAL,
                GPD1.FLO_MEAS_ID AS FLO_MEAS_ID,
                GPD1.ABBREVIATION AS GRP_ABB,
                GPD1.DISP_NAME AS DISP_NAME,
                PE.PAT_ID AS PAT_ID,
                PE.PAT_ENC_CSN_ID AS PAT_ENC_CSN_ID,
                PE.CONTACT_DATE AS CONTACT_DATE,
                FLM.FLO_MEAS_ID AS MEAS_ID,
                GPD2.DISP_NAME AS FLO_DIS_NAME,
                FLM.MEAS_VALUE AS MEAS_VALUE,
                CASE
                    WHEN UPPER(ZVT.NAME) = 'DATE'
                    THEN CAST(DATE_ADD(TO_DATE('1840-12-31'), CAST(FLM.MEAS_VALUE AS INT)) AS STRING)
                    ELSE FLM.MEAS_VALUE
                END AS MEAS_VALUE_CVERT,
                FLM.MEAS_COMMENT AS MEAS_COMMENT,
                FLM.LINE AS LINE,
                DATE(FLM.RECORDED_TIME) AS RECORDED_DATE,
                PAT.PAT_MRN_ID AS PAT_MRN_ID,
                PE.DEPARTMENT_ID AS DEPARTMENT_ID,
                CDEPT.DEPARTMENT_NAME AS DEPARTMENT_NAME,
                FLM.RECORDED_TIME AS RECORDED_TIME,
                FLM.ENTRY_TIME AS ENTRY_TIME,
                FLM.ENTRY_USER_ID AS ENTRY_USER_ID
            FROM CLARITY_LH.CLARITY.IP_FLT_DATA FD
            INNER JOIN CLARITY_LH.CLARITY.IP_FLT_COMPS CM
                ON CM.TEMPLATE_ID = FD.TEMPLATE_ID
            INNER JOIN CLARITY_LH.CLARITY.IP_FLO_GP_DATA GPD1
                ON GPD1.FLO_MEAS_ID = CM.FLO_MEAS_ID
            INNER JOIN FM
                ON FM.FLO_MEAS_ID = CM.FLO_MEAS_ID
            INNER JOIN CLARITY_LH.CLARITY.IP_FLO_GP_DATA GPD2
                ON GPD2.FLO_MEAS_ID = FM.GRP_FLO_MEAS_ID
            INNER JOIN CLARITY_LH.CLARITY.IP_FLWSHT_MEAS FLM
                ON FLM.FLO_MEAS_ID = FM.GRP_FLO_MEAS_ID
            INNER JOIN CLARITY_LH.CLARITY.IP_FLWSHT_REC FR
                ON FR.FSD_ID = FLM.FSD_ID
            INNER JOIN CLARITY_LH.CLARITY.PAT_ENC PE
                ON PE.INPATIENT_DATA_ID = FR.INPATIENT_DATA_ID
            INNER JOIN {ACTIVE_TBL_PAT_ID} PAT
                ON PAT.PAT_ID = PE.PAT_ID
            LEFT JOIN CLARITY_LH.CLARITY.CLARITY_DEP CDEPT
                ON CDEPT.DEPARTMENT_ID = PE.DEPARTMENT_ID
            LEFT JOIN CLARITY_LH.CLARITY.ZC_VAL_TYPE ZVT
                ON ZVT.VAL_TYPE_C = GPD2.VAL_TYPE_C
            WHERE FD.TEMPLATE_ID IN (
                '312','360','361','364','365','362',
                '210401435','210400957','210401586','210401477','210401451','210401563',
                '2100200032','2100200000','2100200222','2100200110','2100200166','2100200071',
                '702','703','210101378','210100046',
                '270','279','280',
                '210001486','210001591','210001597'
            )
        """,
        "primary_keys": "",
        "non_key_columns": "TEMPLATE_ID, TEMPLATE_NAME, DISPLAY_NAME, TIME_INTERVAL, FLO_MEAS_ID, GRP_ABB, DISP_NAME, PAT_ID, PAT_ENC_CSN_ID, CONTACT_DATE, MEAS_ID, FLO_DIS_NAME, MEAS_VALUE, MEAS_VALUE_CVERT, MEAS_COMMENT, LINE, RECORDED_DATE, PAT_MRN_ID, DEPARTMENT_ID, DEPARTMENT_NAME, RECORDED_TIME, ENTRY_TIME, ENTRY_USER_ID",
        "identity_column": "ALLERGY_FLWSHT_KEY",
        "load_type": "FULL",
    },

    {
        "pipeline_name": "TBL_ALLERGY_FLWSHT_LKP",
        "target_table": "ALLERGY_LH.ALLERGY_DELTA.TBL_ALLERGY_FLWSHT_LKP",
        "batch_table": "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_BATCHES",
        "source_query": f"""
            WITH B AS (
                SELECT ID AS FLO_MEAS_ID, LINE AS LINE, MEASUREMENT_ID AS GRP_FLO_MEAS_ID
                FROM (
                    SELECT
                        ID,
                        LINE,
                        MEASUREMENT_ID,
                        CONTACT_DATE_REAL,
                        RANK() OVER (PARTITION BY ID ORDER BY CONTACT_DATE_REAL DESC) AS R
                    FROM CLARITY_LH.CLARITY.IP_FLO_MEASUREMNTS
                )
                WHERE R = 1
            ),
            CUST_LIST AS (
                SELECT
                    C.TEMPLATE_ID AS TEMPLATE_ID,
                    IFD.DISPLAY_NAME AS TEMPLATE_NAME,
                    C.LINE AS GRP_LINE,
                    IFGD.FLO_DIS_NAME AS GRP_NAME,
                    B.LINE AS MEAS_LINE,
                    IFGD2.FLO_DIS_NAME AS MEAS_NAME,
                    ZVT.NAME AS MEASURE_TYPE_NAME,
                    C.FLO_MEAS_ID AS FLO_MEAS_ID,
                    CONCAT('M_', B.GRP_FLO_MEAS_ID) AS MEAS_ID,
                    A.LINE AS LIST_LINE,
                    A.CUST_LIST AS CUST_LIST
                FROM CLARITY_LH.CLARITY.IP_FLT_COMPS C
                LEFT JOIN B
                    ON B.FLO_MEAS_ID = C.FLO_MEAS_ID
                LEFT JOIN CLARITY_LH.CLARITY.IP_FLO_CUSTOM_LIST A
                    ON A.ID = B.GRP_FLO_MEAS_ID
                LEFT JOIN CLARITY_LH.CLARITY.IP_FLT_DATA IFD
                    ON IFD.TEMPLATE_ID = C.TEMPLATE_ID
                LEFT JOIN CLARITY_LH.CLARITY.IP_FLO_GP_DATA IFGD
                    ON IFGD.FLO_MEAS_ID = C.FLO_MEAS_ID
                LEFT JOIN CLARITY_LH.CLARITY.IP_FLO_GP_DATA IFGD2
                    ON IFGD2.FLO_MEAS_ID = B.GRP_FLO_MEAS_ID
                LEFT JOIN CLARITY_LH.CLARITY.ZC_VAL_TYPE ZVT
                    ON ZVT.VAL_TYPE_C = IFGD2.VAL_TYPE_C

                UNION

                SELECT
                    C.TEMPLATE_ID AS TEMPLATE_ID,
                    IFD.DISPLAY_NAME AS TEMPLATE_NAME,
                    C.LINE AS GRP_LINE,
                    IFGD.FLO_DIS_NAME AS GRP_NAME,
                    B.LINE AS MEAS_LINE,
                    IFGD2.FLO_DIS_NAME AS MEAS_NAME,
                    ZVT.NAME AS MEASURE_TYPE_NAME,
                    C.FLO_MEAS_ID AS FLO_MEAS_ID,
                    CONCAT('M_', B.GRP_FLO_MEAS_ID) AS MEAS_ID,
                    A.LINE AS LIST_LINE,
                    A.CUST_LIST AS CUST_LIST
                FROM CLARITY_LH.CLARITY.IP_FLO_CUSTOM_LIST A
                LEFT JOIN B
                    ON B.GRP_FLO_MEAS_ID = A.ID
                LEFT JOIN CLARITY_LH.CLARITY.IP_FLT_COMPS C
                    ON C.FLO_MEAS_ID = B.FLO_MEAS_ID
                LEFT JOIN CLARITY_LH.CLARITY.IP_FLT_DATA IFD
                    ON IFD.TEMPLATE_ID = C.TEMPLATE_ID
                LEFT JOIN CLARITY_LH.CLARITY.IP_FLO_GP_DATA IFGD
                    ON IFGD.FLO_MEAS_ID = C.FLO_MEAS_ID
                LEFT JOIN CLARITY_LH.CLARITY.IP_FLO_GP_DATA IFGD2
                    ON IFGD2.FLO_MEAS_ID = B.GRP_FLO_MEAS_ID
                LEFT JOIN CLARITY_LH.CLARITY.ZC_VAL_TYPE ZVT
                    ON ZVT.VAL_TYPE_C = IFGD2.VAL_TYPE_C
            )
            SELECT DISTINCT
                CUST_LIST.TEMPLATE_ID AS TEMPLATE_ID,
                CUST_LIST.TEMPLATE_NAME AS TEMPLATE_NAME,
                CUST_LIST.GRP_LINE AS GRP_LINE,
                CUST_LIST.GRP_NAME AS GRP_NAME,
                CUST_LIST.MEAS_LINE AS MEAS_LINE,
                CUST_LIST.MEAS_NAME AS MEAS_NAME,
                CUST_LIST.MEASURE_TYPE_NAME AS MEASURE_TYPE_NAME,
                CUST_LIST.FLO_MEAS_ID AS FLO_MEAS_ID,
                CUST_LIST.MEAS_ID AS MEAS_ID,
                CUST_LIST.LIST_LINE AS LIST_LINE,
                CUST_LIST.CUST_LIST AS CUST_LIST
            -- v2: TBL_ALLERGY_FLWSHT only filters templates (no column selected,
            -- SELECT DISTINCT) -> semi join on its distinct TEMPLATE_IDs. Same rows,
            -- without joining every list row to every flowsheet row of its template.
            FROM CUST_LIST
            LEFT SEMI JOIN (
                SELECT DISTINCT TEMPLATE_ID
                FROM {ACTIVE_TBL_ALLERGY_FLWSHT} F
            ) MAF
                ON CUST_LIST.TEMPLATE_ID = MAF.TEMPLATE_ID
        """,
        "primary_keys": "",
        "non_key_columns": "TEMPLATE_ID, TEMPLATE_NAME, GRP_LINE, GRP_NAME, MEAS_LINE, MEAS_NAME, MEASURE_TYPE_NAME, FLO_MEAS_ID, MEAS_ID, LIST_LINE, CUST_LIST",
        "identity_column": "ALLERGY_FLWSHT_LKP_KEY",
        "load_type": "FULL",
    },


