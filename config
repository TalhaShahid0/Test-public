            -- v2: OPN / OPD aggregate PAT_ENC_APPT only for encounters of patients in
            -- TBL_PAT_ID (ENC_CSN) instead of all of Clarity. They are per-CSN
            -- aggregates and are only LEFT JOINed on those CSNs -> same values.
            WITH ENC_CSN AS (
                SELECT PE0.PAT_ENC_CSN_ID
