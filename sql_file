WITH 
-- Step 1: Get eligible patients (small set)
eligible_patients AS (
    SELECT /*+ MATERIALIZE */
        PAT_ID, PERSON_ID
    FROM TBL_PERSON_ID_1585
),

-- Step 2: Pre-filter notes by date (most selective filter)
notes_date_range AS (
    SELECT /*+ MATERIALIZE PARALLEL(8) */
        NOTE_ID,
        CONTACT_DATE,
        CONTACT_DATE_REAL,
        LINE,
        NOTE_TEXT,
        CASE 
            WHEN UPPER(NOTE_TEXT) LIKE '%BIRT%' THEN 1 
            ELSE 0 
        END AS has_birt_flag
    FROM CLARITY.HNO_NOTE_TEXT
    WHERE CONTACT_DATE >= DATE '2026-06-15'
      AND CONTACT_DATE <= DATE '2026-06-30'
),

-- Step 3: Get notes meeting criteria (smartphrase OR BIRT text)
qualified_note_ids AS (
    SELECT /*+ MATERIALIZE */
        NOTE_ID
    FROM (
        SELECT NOTE_ID 
        FROM CLARITY.NOTE_SMARTPHRASE_IDS
        WHERE SMARTPHRASES_ID IN (592203, 592204, 481086, 573124)
        UNION ALL
        SELECT NOTE_ID
        FROM notes_date_range
        WHERE has_birt_flag = 1
    )
    GROUP BY NOTE_ID
),

-- Step 4: Combine all data with minimal joins
final_result AS (
    SELECT /*+ PARALLEL(4) */
        PT.PAT_MRN_ID AS mrn,
        EP.PERSON_ID AS personid,
        ENC.PAT_ENC_CSN_ID AS encounter_id,
        EMP.NAME AS author_name,
        NDR.CONTACT_DATE AS interviewdate,
        NDR.LINE,
        NDR.NOTE_TEXT,
        ROW_NUMBER() OVER (
            PARTITION BY NDR.NOTE_ID 
            ORDER BY NDR.CONTACT_DATE_REAL DESC
        ) AS rn
    FROM qualified_note_ids QNI
    INNER JOIN notes_date_range NDR
        ON QNI.NOTE_ID = NDR.NOTE_ID
    INNER JOIN CLARITY.HNO_INFO HN
        ON NDR.NOTE_ID = HN.NOTE_ID
    INNER JOIN CLARITY.PAT_ENC ENC
        ON HN.PAT_ENC_CSN_ID = ENC.PAT_ENC_CSN_ID
    INNER JOIN eligible_patients EP
        ON ENC.PAT_ID = EP.PAT_ID
    INNER JOIN CLARITY.PATIENT PT
        ON EP.PAT_ID = PT.PAT_ID
    LEFT JOIN CLARITY.NOTE_ENC_INFO HNO
        ON NDR.NOTE_ID = HNO.NOTE_ID
    LEFT JOIN CLARITY.CLARITY_EMP EMP
        ON HNO.AUTHOR_USER_ID = EMP.USER_ID
)

SELECT 
    mrn,
    personid,
    encounter_id,
    author_name,
    interviewdate,
    line,
    note_text
FROM final_result
WHERE rn = 1
ORDER BY mrn, encounter_id, line;
