SELECT "mrn",
        "personid",
        "encounter_id",
        "author_name",
        "interviewdate",
        "line",
        "note_text"
FROM (
SELECT  DISTINCT
        PT.PAT_MRN_ID "mrn",
        TBL.PERSON_ID "personid",
        ENC.PAT_ENC_CSN_ID "encounter_id",
        EMP.NAME "author_name",
        HNT.CONTACT_DATE "interviewdate",
        HNT.LINE "line",
        HNT.NOTE_TEXT "note_text",
        RANK ()OVER (PARTITION BY HNT.NOTE_ID ORDER BY HNT.CONTACT_DATE_REAL DESC) RN
FROM TBL_PERSON_ID_1585 TBL
JOIN CLARITY.PATIENT PT
    ON PT.PAT_ID = TBL.PAT_ID
JOIN CLARITY.PAT_ENC ENC
    ON ENC.PAT_ID = PT.PAT_ID
JOIN CLARITY.HNO_INFO HN
    ON ENC.PAT_ENC_CSN_ID = HN.PAT_ENC_CSN_ID
JOIN CLARITY.NOTE_ENC_INFO HNO
    ON HN.NOTE_ID = HNO.NOTE_ID
JOIN CLARITY.HNO_NOTE_TEXT HNT
    ON HNT.NOTE_ID = HNO.NOTE_ID
LEFT JOIN CLARITY.CLARITY_EMP EMP
    ON HNO.AUTHOR_USER_ID = EMP.USER_ID
LEFT JOIN CLARITY.NOTE_SMARTPHRASE_IDS SMRT
    ON HNO.NOTE_ID = SMRT.NOTE_ID
WHERE (SMARTPHRASES_ID IN(592203,592204,481086,573124)
    OR UPPER(HNT.NOTE_TEXT) LIKE '%BIRT%')
AND HNT.CONTACT_DATE >= TO_DATE('06/15/2026','mm/dd/yyyy')
AND HNT.CONTACT_DATE <= TO_DATE('06/30/2026','mm/dd/yyyy')
)
WHERE RN = 1
ORDER BY "mrn", "encounter_id", "line";
