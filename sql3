WITH CTE AS
(
select
DISTINCT
Note_ID,
CONTACT_DATE_REAL,
NOTE_TEXT ,
LINE,
CONTACT_DATE,
Row_Number ()OVER (PARTITION BY NOTE_ID ORDER BY CONTACT_DATE_REAL DESC) RN
from HNO_NOTE_TEXT
WHERE CONTACT_DATE >= TO_DATE('06/15/2026','mm/dd/yyyy')
  AND CONTACT_DATE <= TO_DATE('06/30/2026','mm/dd/yyyy')
  AND UPPER(NOTE_TEXT) LIKE '%$BIRT%'
 GROUP BY CONTACT_DATE_REAL, Note_id, NOTE_TEXT,LINE,CONTACT_DATE
)
SELECT
PT.PAT_MRN_ID "mrn",
TBL.PERSON_ID "personid",
NT.Note_ID,
EMP.NAME "author_name",
NT.CONTACT_DATE_REAL,
NT.NOTE_TEXT,
ENC.PAT_ENC_CSN_ID "encounter_id",
NT.CONTACT_DATE "interviewdate",
NT.LINE "line"
FROM cte NT
JOIN HNO_INFO HNI      ON HNI.Note_Id = NT.Note_Id
Join PAT_ENC   ENC        ON ENC.PAT_ENC_CSN_ID = HNI.PAT_ENC_CSN_ID
JOIN NOTE_ENC_INFO HNO ON HNI.NOTE_ID = HNO.NOTE_ID
JOIN NOTE_SMARTPHRASE_IDS SMRT ON  SMRT.NOTE_ID  = HNO.NOTE_ID
join CLARITY_EMP   EMP ON EMP.USER_ID = HNO.AUTHOR_USER_ID
JOIN PAT_ENC  PTC        ON PTC.PAT_ENC_CSN_ID =  HNO.PAT_ENC_CSN_ID
JOIN PATIENT PT         ON PT.PAT_ID   = PTC.PAT_ID
JOIN  TBL_PERSON_ID_1585 TBL ON TBL.PAT_ID = PT.PAT_ID
WHERE RN = 1 AND SMRT.SMARTPHRASES_ID IN(592203,592204,481086,573124)

order by CONTACT_DATE_REAL desc
