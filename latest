try:
    from pyspark import InheritableThread as _WorkerThread   # pinned-thread safe
except Exception:
    _WorkerThread = threading.Thread

# One lock for every write to the batch / log tables (MERGE_NB defines it;
# fallback if this notebook runs without the v2 MERGE_NB).
try:
    _CONTROL_LOCK
except NameError:
    _CONTROL_LOCK = threading.RLock()

try:
    from pyspark.errors import AnalysisException
except Exception:  # older runtimes
    from pyspark.sql.utils import AnalysisException

# Errors that will fail the same way on a retry.
NON_TRANSIENT_ERRORS = (ValueError, RuntimeError, AnalysisException)

# ERROR_MESSAGE prefix of batch rows closed because their session was killed.
# For these rows BATCH_END_DTTM - BATCH_START_DTTM = how long the pipeline had
# run when it was killed (a lower bound of its real duration).
KILLED_BATCH_PREFIX = "SESSION_KILLED:"


# ============================================================
# Monitoring table schemas
# ============================================================

ORCHESTRATION_RUN_SCHEMA = StructType([
    StructField("RUN_ID", LongType(), True),
    StructField("RUN_START_DTTM", TimestampType(), True),
    StructField("RUN_END_DTTM", TimestampType(), True),
    StructField("STATUS", StringType(), True),    # RUNNING / SUCCESS / PARTIAL_FAILURE / FAILED / ABANDONED / STOPPED_TIME_LIMIT
    StructField("TOTAL_PIPELINES", LongType(), True),
    StructField("SUCCEEDED_COUNT", LongType(), True),
    StructField("FAILED_COUNT", LongType(), True),
    StructField("FAILED_PIPELINE_NAMES", StringType(), True),     # comma-joined
    StructField("TRIGGERED_BY", StringType(), True),
    StructField("PENDING_PIPELINE_NAMES", StringType(), True),    # not run because of the time limit
    StructField("SKIPPED_DONE_PIPELINE_NAMES", StringType(), True),  # skipped by resume (already done)
    StructField("SESSION_START_DTTM", TimestampType(), True),     # NEW (v3): when this run's Spark session started
    StructField("RUN_NOTE", StringType(), True),                  # NEW (v4): e.g. PARALLEL_STALL: <names>
])

ORCHESTRATION_ATTEMPT_SCHEMA = StructType([
    StructField("RUN_ID", LongType(), True),                      # FK -> RUN_TABLE.RUN_ID
    StructField("PIPELINE_NAME", StringType(), True),
    StructField("ATTEMPT_NUMBER", IntegerType(), True),
    StructField("ATTEMPT_START_DTTM", TimestampType(), True),
    StructField("ATTEMPT_END_DTTM", TimestampType(), True),
    StructField("STATUS", StringType(), True),                    # SUCCESS / FAILED
    StructField("ERROR_MESSAGE", StringType(), True),
    StructField("DURATION_SECONDS", DoubleType(), True),
    StructField("BATCH_ID", LongType(), True),                    # FK -> <batch_table>.BATCH_ID, set only on SUCCESS
])

RUN_TABLE = "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_ETL_RUN_LOG"
ATTEMPT_TABLE = "ALLERGY_LH.ALLERGY_DELTA.ALLERGY_ETL_STEP_LOG"


# ============================================================
# Small table helpers
# ============================================================

def _ensure_table(table, schema):
    if not spark.catalog.tableExists(table):
        print("Monitoring table does not exist. Creating:", table)
        spark.createDataFrame([], schema) \
            .write.format("delta").mode("overwrite").saveAsTable(table)
        print("Monitoring table created successfully.")
        return

    existing_cols = {f.name for f in spark.table(table).schema.fields}
    missing_fields = [f for f in schema.fields if f.name not in existing_cols]
    if missing_fields:
        add_cols_ddl = ", ".join(
            f"{f.name} {f.dataType.simpleString()}" for f in missing_fields
        )
        print(f"Monitoring table is missing columns [{add_cols_ddl}]. Altering:", table)
        spark.sql(f"ALTER TABLE {table} ADD COLUMNS ({add_cols_ddl})")


def _append_row(table, schema, row_values):
    with _CONTROL_LOCK:
        spark.createDataFrame([row_values], schema=schema) \
            .write.format("delta").mode("append") \
            .option("mergeSchema", "true").saveAsTable(table)


def _update_run_row(run_id, updates: dict, lock_timeout=None):
    """Update of one RUN_TABLE row (same effect as the old single-row MERGE):
    a Delta UPDATE on RUN_ID, values cast to the schema types.
    lock_timeout (seconds) is only used after a stall, so a stuck pipeline
    thread holding the lock cannot block the run row from being closed."""
    field_lookup = {f.name: f for f in ORCHESTRATION_RUN_SCHEMA.fields}
    set_clause = {
        c: lit(v).cast(field_lookup[c].dataType) for c, v in updates.items()
    }
    got = _CONTROL_LOCK.acquire(timeout=-1 if lock_timeout is None else lock_timeout)
    try:
        DeltaTable.forName(spark, RUN_TABLE).update(
            condition=col("RUN_ID") == lit(int(run_id)).cast("long"),
            set=set_clause,
        )
    finally:
        if got:
            _CONTROL_LOCK.release()


def _next_run_id():
    if not spark.catalog.tableExists(RUN_TABLE):
        return 1
    return (
        spark.table(RUN_TABLE)
        .agg(coalesce(spark_max("RUN_ID"), lit(0)).alias("m"))
        .collect()[0]["m"] + 1
    )


def _recent_runs(limit=200):
    """Latest run rows, newest first, as plain dicts."""
    return [
        r.asDict()
        for r in (
            spark.table(RUN_TABLE)
            .select("RUN_ID", "RUN_START_DTTM", "RUN_END_DTTM", "STATUS",
                    "SESSION_START_DTTM", "RUN_NOTE")
            .orderBy(col("RUN_ID").desc())
            .limit(limit)
            .collect()
        )
    ]


def _session_death(run, dead_after_hours):
    """Latest moment the session of `run` can have been alive."""
    start = run["SESSION_START_DTTM"] or run["RUN_START_DTTM"]
    return None if start is None else start + timedelta(hours=dead_after_hours)


def _close_dead_runs(dead_after_hours):
    """RUNNING run rows whose Spark session cannot be alive any more
    (session older than its max lifetime) -> ABANDONED."""
    now = datetime.now()
    # lit(<python datetime>) is converted exactly like the stored values
    # (no dependency on spark.sql.session.timeZone, unlike a TIMESTAMP'..' literal).
    cut = now - timedelta(hours=dead_after_hours)
    DeltaTable.forName(spark, RUN_TABLE).update(
        condition=(
            (col("STATUS") == "RUNNING")
            & (coalesce(col("SESSION_START_DTTM"), col("RUN_START_DTTM")) < lit(cut))
        ),
        set={"STATUS": lit("ABANDONED"), "RUN_END_DTTM": lit(now)},
    )


def _orch_tag(run_id):
    return f"ORCH_RUN_ID={run_id}"


def _close_dead_batches(batch_tables, pipeline_names, dead_after_hours):
    """Close RUNNING batch rows of these pipelines that no live session owns:
      - row written by this orchestrator (CREATED_BY carries ORCH_RUN_ID=<n>):
        closed when run <n> is no longer RUNNING (it was killed / interrupted);
      - any other row (older runs, manual run_batch_tracked_merge calls):
        closed only when it is older than dead_after_hours (no session lives
        that long).
    If the owning run was killed with its session (ABANDONED), the row gets
    KILLED_BATCH_PREFIX and BATCH_END_DTTM = when that session died, so
    END - START is how long the pipeline had run when it was killed (used as a
    lower bound of its duration). Otherwise it gets 'LEFT_RUNNING:' and is not
    used for duration estimates."""
    now = datetime.now()
    runs = _recent_runs(limit=500)
    by_id = {r["RUN_ID"]: r for r in runs}
    by_start = sorted(
        (r for r in runs if r["RUN_START_DTTM"] is not None),
        key=lambda r: r["RUN_START_DTTM"],
    )
    age_cut = now - timedelta(hours=dead_after_hours)

    for bt in batch_tables:
        if not spark.catalog.tableExists(bt):
            continue
        running = (
            spark.table(bt)
            .filter((col("STATUS") == "RUNNING")
                    & col("PIPELINE_NAME").isin(list(pipeline_names)))
            .select("BATCH_ID", "PIPELINE_NAME", "BATCH_START_DTTM", "CREATED_BY")
            .collect()
        )

        fixes = []
        for d in running:
            bs = d["BATCH_START_DTTM"]
            m = re.search(r"ORCH_RUN_ID=(\d+)", d["CREATED_BY"] or "")
            if m:
                owner = by_id.get(int(m.group(1)))
                if owner is not None and owner["STATUS"] == "RUNNING":
                    continue                      # its run may still be alive
            if not m or owner is None:
                if bs is None or bs >= age_cut:
                    continue                      # not provably dead
                if not m:
                    cands = [r for r in by_start if r["RUN_START_DTTM"] <= bs]
                    owner = cands[-1] if cands else None   # best guess, estimate only

            died, prefix = now, "LEFT_RUNNING:"
            if owner is not None and owner["STATUS"] == "ABANDONED" and bs is not None:
                death = _session_death(owner, dead_after_hours)
                if death is not None and bs <= death <= now:
                    died, prefix = death, KILLED_BATCH_PREFIX
            elif (owner is not None and m and owner["RUN_END_DTTM"] is not None
                  and bs is not None and bs <= owner["RUN_END_DTTM"] <= now):
                died = owner["RUN_END_DTTM"]

            if prefix == KILLED_BATCH_PREFIX:
                msg = (f"{prefix} still RUNNING when its Spark session was killed "
                       f"(had run about {(died - bs).total_seconds() / 60:.0f} min); "
                       f"closed by orchestrator cleanup")
            else:
                msg = (f"{prefix} still RUNNING after its run ended; "
                       f"closed by orchestrator cleanup")
            fixes.append((d["BATCH_ID"], died, msg))
            print(f"Cleanup: {bt} BATCH_ID {d['BATCH_ID']} ({d['PIPELINE_NAME']}) "
                  f"RUNNING -> FAILED [{prefix}]")

        if not fixes:
            continue
        src = spark.createDataFrame(
            fixes, "BATCH_ID long, END_DTTM timestamp, MSG string")
        (
            DeltaTable.forName(spark, bt)
            .alias("T")
            .merge(src.alias("S"), "T.BATCH_ID = S.BATCH_ID AND T.STATUS = 'RUNNING'")
            .whenMatchedUpdate(set={
                "STATUS": lit("FAILED"),
                "BATCH_END_DTTM": col("S.END_DTTM"),
                "ERROR_MESSAGE": col("S.MSG"),
            })
            .execute()
        )


def _already_done_pipelines(resume_gap_minutes, resume_window_hours,
                            dead_after_hours, now):
    """Pipelines whose LATEST attempt in the chain of runs just before this one
    is a SUCCESS, as {name: (start, end) of that attempt}.
    Walking back from the newest run, a run joins the chain while it is not a
    full SUCCESS and it ended at most resume_gap_minutes before the next run
    started. (An ABANDONED run 'ended' when its session died.)"""
    if not spark.catalog.tableExists(RUN_TABLE):
        return {}, []

    since = now - timedelta(hours=resume_window_hours)
    gap = timedelta(minutes=resume_gap_minutes)

    chain = []
    next_start = now
    for r in _recent_runs(limit=50):
        if r["STATUS"] in ("RUNNING", "SUCCESS"):
            break
        if r["RUN_START_DTTM"] is None or r["RUN_START_DTTM"] < since:
            break
        end = r["RUN_END_DTTM"]
        if r["STATUS"] == "ABANDONED":
            death = _session_death(r, dead_after_hours) if dead_after_hours else None
            if death is not None and (end is None or death < end):
                end = death
        if end is None or next_start - end > gap:
            break
        chain.append(r["RUN_ID"])
        next_start = r["RUN_START_DTTM"]

    if not chain:
        return {}, []

    latest = {}
    for r in (
        spark.table(ATTEMPT_TABLE)
        .filter(col("RUN_ID").isin(chain))
        .select("PIPELINE_NAME", "STATUS", "ATTEMPT_START_DTTM", "ATTEMPT_END_DTTM")
        .collect()
    ):
        k, st = r["PIPELINE_NAME"], r["ATTEMPT_START_DTTM"]
        if st is not None and (k not in latest or st > latest[k]["ATTEMPT_START_DTTM"]):
            latest[k] = r
    done = {
        k: (r["ATTEMPT_START_DTTM"], r["ATTEMPT_END_DTTM"])
        for k, r in latest.items()
        if r["STATUS"] == "SUCCESS" and r["ATTEMPT_END_DTTM"] is not None
    }
    return done, chain


def _recent_durations(names, batch_tables, history=3):
    """Longest recent run time (seconds) per pipeline, from:
      - its last `history` SUCCESS attempts in ATTEMPT_TABLE,
      - its last `history` SUCCESS batches in the batch tables, and its
        session-killed batches that came AFTER its latest SUCCESS batch (a
        killed batch counts with the time it had run when killed; once the
        pipeline has succeeded again it no longer counts).
    Pipelines with no history are missing from the result."""
    names = list(names)
    out = {}

    def take(rows):
        for r in rows:
            if r["d"] is not None:
                out[r["PIPELINE_NAME"]] = max(out.get(r["PIPELINE_NAME"], 0.0),
                                              float(r["d"]))

    w = Window.partitionBy("PIPELINE_NAME").orderBy(col("ATTEMPT_END_DTTM").desc())
    take(
        spark.table(ATTEMPT_TABLE)
        .filter((col("STATUS") == "SUCCESS") & col("PIPELINE_NAME").isin(names))
        .withColumn("rn", row_number().over(w))
        .filter(col("rn") <= history)
        .groupBy("PIPELINE_NAME")
        .agg(spark_max("DURATION_SECONDS").alias("d"))
        .collect()
    )

    wb = Window.partitionBy("PIPELINE_NAME").orderBy(col("BATCH_ID").desc())
    for bt in batch_tables:
        if not spark.catalog.tableExists(bt):
            continue
        rows = (
            spark.table(bt)
            .filter(
                col("PIPELINE_NAME").isin(names)
                & col("BATCH_START_DTTM").isNotNull()
                & col("BATCH_END_DTTM").isNotNull()
                & (
                    (col("STATUS") == "SUCCESS")
                    | ((col("STATUS") == "FAILED")
                       & col("ERROR_MESSAGE").startswith(KILLED_BATCH_PREFIX))
                )
            )
            .select("PIPELINE_NAME", "BATCH_ID", "STATUS",
                    "BATCH_START_DTTM", "BATCH_END_DTTM")
        )
        last_ok = (
            rows.filter(col("STATUS") == "SUCCESS")
            .groupBy("PIPELINE_NAME")
            .agg(spark_max("BATCH_ID").alias("LAST_OK_BATCH_ID"))
        )
        take(
            rows.join(last_ok, "PIPELINE_NAME", "left")
            .filter(
                (col("STATUS") == "SUCCESS")
                | col("LAST_OK_BATCH_ID").isNull()
                | (col("BATCH_ID") > col("LAST_OK_BATCH_ID"))
            )
            .withColumn("rn", row_number().over(wb))
            .filter(col("rn") <= history)
            .withColumn("d", unix_timestamp("BATCH_END_DTTM")
                        - unix_timestamp("BATCH_START_DTTM"))
            .groupBy("PIPELINE_NAME")
            .agg(spark_max("d").alias("d"))
            .collect()
        )
    return out


def _reads_table(source_query, table):
    """True if source_query mentions `table` (last name part, whole word, any
    case). Same rule as optimized/ORCHESTRATOR_NB.py."""
    short = table.strip().strip("`").split(".")[-1].strip("`")
    pattern = r"(?<![A-Za-z0-9_])" + re.escape(short) + r"(?![A-Za-z0-9_])"
    return re.search(pattern, source_query or "", flags=re.IGNORECASE) is not None


def _depends_on_earlier(pipeline_configs):
    """{j: set(i < j)} -- config j is tied to an earlier config i when one reads
    the other's target, both write the same target, or cfg["depends_on"] names
    it. Used so that when i runs again, j runs again after it (as in one
    uninterrupted run)."""
    index_of = {c["pipeline_name"]: k for k, c in enumerate(pipeline_configs)}
    deps = {}
    for j, cj in enumerate(pipeline_configs):
        deps[j] = set()
        for i in range(j):
            ci = pipeline_configs[i]
            if (ci["target_table"].strip().lower() == cj["target_table"].strip().lower()
                    or _reads_table(cj.get("source_query"), ci["target_table"])
                    or _reads_table(ci.get("source_query"), cj["target_table"])):
                deps[j].add(i)
        for dname in cj.get("depends_on", []) or []:
            if dname in index_of and index_of[dname] < j:
                deps[j].add(index_of[dname])
    return deps


def _merge_args(cfg, run_id):
    """Config for run_batch_tracked_merge: orchestrator-only keys removed and
    the run id added to CREATED_BY, so cleanup knows which run owns a batch."""
    args = {k: v for k, v in cfg.items() if k != "depends_on"}
    args["created_by"] = f"{args.get('created_by', 'Fabric Notebook')} | {_orch_tag(run_id)}"
    return args


def _fmt_min(seconds):
    return "unknown" if seconds is None else f"{seconds / 60:.0f} min"


def _dump_threads(max_frames=40):
    """Print where every Python thread and every relevant JVM thread is, plus
    the JVM's own deadlock check and driver heap use (for a parallel stall)."""
    print("=================== THREAD DUMP (send this for diagnosis) ===================")
    frames = sys._current_frames()
    for th in threading.enumerate():
        print(f"--- PYTHON {th.name} (daemon={th.daemon})")
        f = frames.get(th.ident)
        if f is not None:
            print("".join(traceback.format_stack(f)[-max_frames:]))
    try:
        jvm = spark.sparkContext._jvm
        mx = jvm.java.lang.management.ManagementFactory.getThreadMXBean()
        dead = mx.findDeadlockedThreads()
        print("JVM deadlocked threads:", "none" if dead is None else list(dead))
        traces = jvm.java.lang.Thread.getAllStackTraces()
        for t in traces.keySet().toArray():
            state = str(t.getState())
            lines = [str(x) for x in traces.get(t)][:max_frames]
            txt = "\n    ".join(lines)
            if state == "BLOCKED" or any(k in txt for k in ("spark", "delta", "py4j")):
                print(f"--- JVM {t.getName()} [{state}]\n    {txt}")
        rt = jvm.java.lang.Runtime.getRuntime()
        print(f"Driver JVM heap: used {(rt.totalMemory() - rt.freeMemory()) / 2**30:.1f} GB "
              f"of max {rt.maxMemory() / 2**30:.1f} GB")
    except Exception as e:
        print("JVM thread dump failed:", e)
    print("=============================================================================")


# ============================================================
# Round runner with watchdog (max_parallel >= 1) -- headers F / G / I
# ============================================================

# Storage throttling ("server busy"): worth a longer wait before the retry.
_BUSY_ERROR = re.compile(
    r"ServerBusy|Status code 503|TooManyRequests|Status code 429|throttl", re.I
)


def _run_round(to_run, expected, run_id, results, failed_pipelines,
               stop_flag, fits, elapsed, max_parallel, max_attempts,
               inter_attempt_wait_seconds, retry_non_transient,
               fresh_session_minutes, stall_minutes, heartbeat_minutes,
               cutoff_seconds, budget_seconds, overrun_cap, exempt,
               busy_retry_wait_seconds, inter_pipeline_wait_seconds,
               cancel_wait_seconds=120, heavy=frozenset()):
    """Runs to_run with up to max_parallel pipelines at once (1 = one after
    the other, in config order). Each pipeline runs in a worker thread; this
    thread keeps the time box and the watchdog. A pipeline starts when every
    earlier pipeline it is tied to (_depends_on_earlier) has finished, success
    or failure (the sequential loop also moves on after a failure). Fills
    results / failed_pipelines like the sequential loop.

    Watchdog (headers G / I): the round stops when
      - STALL: a pipeline is running but no Spark job has run for
        stall_minutes, or
      - OVERRUN: a pipeline's current attempt runs longer than its cap
        (overrun_cap(name, first_in_fresh_session); None = no cap).
    Pipelines in `exempt` never trigger it. Its Spark jobs are cancelled and
    the stopped pipelines are pending (not failed): the next round runs them.

    Returns (pending, stopped, kind):
      pending = pipelines not run (time limit) or stopped by the watchdog,
      stopped = pipelines that were running when the watchdog fired,
      kind    = None, 'STALL' or 'OVERRUN'."""
    deps = _depends_on_earlier(to_run)
    waiting = list(range(len(to_run)))
    running = {}                  # idx -> start time of the pipeline
    attempt_started = {}          # idx -> start time of its current attempt
    caps = {}                     # idx -> overrun cap in seconds (None = no cap)
    finished = set()
    events = []                   # (idx, ok, res) posted by workers
    sleeping = set()              # workers in their retry wait
    state = threading.Lock()
    last_event = [time.time()]
    last_end = [None]
    stop_new = False
    first_start = True
    time_skipped = []             # parallel: did not fit the time box (header M)
    # Parallel start priority (header M): own expected time + the longest
    # chain of pipelines that wait for it. deps only point to earlier configs.
    prio = {}
    for i in reversed(range(len(to_run))):
        tail = [prio[j] for j in range(i + 1, len(to_run)) if i in deps[j]]
        prio[i] = expected[to_run[i]["pipeline_name"]] + (max(tail) if tail else 0)
    stopped, kind = [], None
    sc = spark.sparkContext
    sequential = max_parallel == 1

    def worker(idx):
        cfg = to_run[idx]
        name = cfg["pipeline_name"]
        exp = expected[name]
        ok, res = False, None
        try:
            try:
                sc.setJobGroup(f"orch_{run_id}_{name}", name, interruptOnCancel=True)
                sc.setLocalProperty("spark.scheduler.pool", name)
            except Exception:
                pass
            attempt = 1
            while attempt <= max_attempts:
                attempt_start = datetime.now()
                with state:
                    attempt_started[idx] = time.time()
                try:
                    res = run_batch_tracked_merge(**_merge_args(cfg, run_id))
                    attempt_end = datetime.now()
                    _append_row(ATTEMPT_TABLE, ORCHESTRATION_ATTEMPT_SCHEMA, [
                        run_id, name, attempt, attempt_start, attempt_end,
                        "SUCCESS", None,
                        (attempt_end - attempt_start).total_seconds(),
                        res.get("batch_id"),
                    ])
                    ok = True
                    break
                except Exception as e:
                    attempt_end = datetime.now()
                    watchdog_stop = stop_flag.is_set()
                    _append_row(ATTEMPT_TABLE, ORCHESTRATION_ATTEMPT_SCHEMA, [
                        run_id, name, attempt, attempt_start, attempt_end,
                        "FAILED",
                        ("WATCHDOG_STOP: " if watchdog_stop else "") + str(e),
                        (attempt_end - attempt_start).total_seconds(),
                        None,
                    ])
                    # Sequential: release what the failed attempt left cached
                    # (as v4). Parallel: no clearCache() -- it would wipe the
                    # other running pipelines' data.
                    if sequential:
                        spark.catalog.clearCache()
                    if watchdog_stop:
                        print(f"{name}: stopped by the watchdog / round stop "
                              f"(runs again in the next round)")
                        break
                    non_transient = isinstance(e, NON_TRANSIENT_ERRORS)
                    retry_fits = fits(exp) and not stop_flag.is_set()
                    can_retry = attempt < max_attempts and retry_fits and (
                        retry_non_transient or not non_transient
                    )
                    if can_retry:
                        wait = inter_attempt_wait_seconds
                        if busy_retry_wait_seconds and _BUSY_ERROR.search(str(e)):
                            wait = max(wait, busy_retry_wait_seconds)
                            print(f"{name}: storage reported 'busy' -- waiting longer.")
                        print(f"Attempt {attempt} failed for {name}: {e}")
                        print(f"Waiting {wait} seconds before retry...")
                        with state:
                            sleeping.add(idx)
                        time.sleep(wait)
                        with state:
                            sleeping.discard(idx)
                        attempt += 1
                    else:
                        if non_transient and attempt < max_attempts:
                            why = "non-transient error, not retrying"
                        elif not retry_fits and attempt < max_attempts:
                            why = "no time left in this session for a retry"
                        else:
                            why = "giving up on this pipeline"
                        print(f"Attempt {attempt} failed for {name}: {e} -- {why}")
                        break
        except BaseException as e:            # e.g. a log write failed
            print(f"{name}: pipeline thread stopped: {e}")
            ok = False
        finally:
            if sequential:
                try:
                    spark.catalog.clearCache()   # as v4, before the next pipeline
                except Exception:
                    pass
            with state:
                events.append((idx, ok, res if ok else None))
                last_event[0] = time.time()

    def names(idxs):
        return [to_run[i]["pipeline_name"] for i in idxs]

    def collect():
        with state:
            done = events[:]
            events.clear()
        out = []
        for idx, ok, res in done:
            t0 = running.pop(idx)
            finished.add(idx)
            last_end[0] = time.time()
            name = to_run[idx]["pipeline_name"]
            out.append((idx, ok, res))
            print(f"<<< END {name}: {'SUCCESS' if ok else 'FAILED'} "
                  f"({_fmt_min(time.time() - t0)}) | session up {_fmt_min(elapsed())}",
                  flush=True)
        return out

    last_job = time.time()
    last_beat = time.time()
    while waiting or running:
        # ---- start what is ready, within the time box -----------------------
        # Sequential: config order; the first one that does not fit ends the
        # round (v5). Parallel (header M): longest chain first; one that
        # does not fit is skipped, shorter ones may still start.
        pause = (sequential and inter_pipeline_wait_seconds and last_end[0] is not None
                 and time.time() - last_end[0] < inter_pipeline_wait_seconds)
        started_now = False
        if not stop_new and not pause:
            ready = [i for i in waiting if deps[i] <= finished]
            if not sequential:
                ready.sort(key=lambda i: -prio[i])
            for idx in ready:
                if len(running) >= max_parallel:
                    break
                name = to_run[idx]["pipeline_name"]
                if (not sequential and name in heavy and any(
                        to_run[j]["pipeline_name"] in heavy for j in running)):
                    continue      # header P: not next to another heavy pipeline
                exp = expected[name]
                first_in_fresh_session = (
                    first_start and elapsed() < fresh_session_minutes * 60
                )
                if not first_in_fresh_session and not fits(exp):
                    if not sequential:
                        if name not in time_skipped:
                            time_skipped.append(name)
                            print(f"TIME LIMIT: {name} (expected {_fmt_min(exp)}) does not fit "
                                  f"any more (session up {_fmt_min(elapsed())}, start cutoff "
                                  f"{_fmt_min(cutoff_seconds)}, must end by "
                                  f"{_fmt_min(budget_seconds)}); it runs in the next round.",
                                  flush=True)
                        continue
                    stop_new = True
                    print("=============================================")
                    print(f"TIME LIMIT: elapsed {_fmt_min(elapsed())}, {name} expected "
                          f"{_fmt_min(exp)}, start cutoff {_fmt_min(cutoff_seconds)}, "
                          f"must end by {_fmt_min(budget_seconds)}.")
                    if running:
                        print("No new pipeline starts; waiting for the running ones: "
                              f"{names(running)}")
                    else:
                        print("Stopping cleanly. Not run (next run resumes here): "
                              f"{names(waiting)}")
                    print("=============================================")
                    break
                waiting.remove(idx)
                first_start = False
                caps[idx] = overrun_cap(name, first_in_fresh_session)
                now0 = time.time()
                running[idx] = now0
                with state:
                    attempt_started[idx] = now0
                cap_txt = f" | watchdog cap {_fmt_min(caps[idx])}" if caps[idx] else ""
                print(f">>> START {name} | session up {_fmt_min(elapsed())} | "
                      f"expected {_fmt_min(exp)}{cap_txt}"
                      + (f" | running: {names(running)}" if not sequential else ""),
                      flush=True)
                _WorkerThread(target=worker, args=(idx,), daemon=True,
                              name=f"pipeline-{name}").start()
                started_now = True
        if stop_new and not running:
            break
        if not sequential and waiting and not running and not started_now:
            # Parallel: nothing runs and nothing more can start this session.
            print("=============================================")
            print(f"TIME LIMIT: nothing more fits this session (up {_fmt_min(elapsed())}). "
                  f"Not run (next run resumes here): {names(waiting)}")
            print("=============================================")
            break

        time.sleep(2)

        # ---- collect finished pipelines -----------------------------------
        for idx, ok, res in collect():
            name = to_run[idx]["pipeline_name"]
            if ok:
                results[name] = res
            else:
                failed_pipelines.append(name)

        # ---- watchdog --------------------------------------------------------
        now = time.time()
        try:
            active_jobs = list(sc.statusTracker().getActiveJobsIds())
        except Exception:
            active_jobs = [-1]                 # unknown -> treat as progress
        if active_jobs:
            last_job = now
        with state:
            busy = [i for i in running if i not in sleeping]
            quiet_since = max(last_job, last_event[0])
            over = [i for i in busy
                    if caps.get(i) and now - attempt_started.get(i, running[i]) > caps[i]]
        watched = [i for i in busy if to_run[i]["pipeline_name"] not in exempt]
        if heartbeat_minutes and now - last_beat >= heartbeat_minutes * 60 and running:
            last_beat = now
            print(f"... {datetime.now():%H:%M:%S} running: "
                  + ", ".join(f"{to_run[i]['pipeline_name']} ({_fmt_min(now - t)})"
                              for i, t in running.items())
                  + f" | active Spark jobs: {len(active_jobs)} | done {len(finished)}"
                  f"/{len(to_run)} | waiting {len(waiting)}", flush=True)
        stall = bool(watched) and bool(stall_minutes) and now - quiet_since > stall_minutes * 60
        if stall or over:
            kind = "STALL" if stall else "OVERRUN"
            stopped = names(running)
            print("=============================================")
            if stall:
                print(f"WATCHDOG (STALL): {stopped} running but no Spark job for "
                      f"{_fmt_min(now - quiet_since)}.")
            for i in over:
                print(f"WATCHDOG (OVERRUN): {to_run[i]['pipeline_name']} attempt running "
                      f"{_fmt_min(now - attempt_started.get(i, running[i]))}, cap "
                      f"{_fmt_min(caps[i])} (expected {_fmt_min(expected[to_run[i]['pipeline_name']])}).")
            print("Stopping this round cleanly; the next round (fresh session) runs "
                  f"{stopped} again" + (" SEQUENTIALLY" if not sequential else "")
                  + ", without the watchdog for them.")
            print("=============================================")
            _dump_threads()
            stop_flag.set()
            try:
                sc.cancelAllJobs()
            except Exception:
                pass
            # Give the workers time to close their batch rows (FAILED) and log
            # the stopped attempt. A worker stuck outside Spark is left behind;
            # the next round's cleanup closes its batch row.
            deadline = time.time() + cancel_wait_seconds
            while running and time.time() < deadline:
                time.sleep(2)
                for idx, ok, res in collect():
                    name = to_run[idx]["pipeline_name"]
                    if ok:                      # finished just in time
                        results[name] = res
                        stopped.remove(name)
            if running:
                print(f"Still running after {cancel_wait_seconds}s (left behind): "
                      f"{names(running)}")
            break

    # Stopped pipelines are not failures: the next round runs them again.
    pending = stopped + names(waiting)
    return pending, stopped, kind


# ============================================================
# Weekly maintenance (NOT called by run_orchestrator)
# ============================================================

def optimize_tables(pipeline_configs, include_logs=True):
    """OPTIMIZE (compact small files) every target table, the batch table(s)
    and the two log tables. Data is not changed; reads of the history (latest
    version window, guards, max(BATCH_ID)) get faster because every run
    appends small files. Run it in a separate notebook / schedule, e.g. once a
    week -- not inside the time-boxed loop (it takes time itself)."""
    tables = [c["target_table"] for c in pipeline_configs]
    if include_logs:
        tables += sorted({c["batch_table"] for c in pipeline_configs})
        tables += [RUN_TABLE, ATTEMPT_TABLE]
    for t in dict.fromkeys(tables):
        if not spark.catalog.tableExists(t):
            continue
        t0 = time.time()
        spark.sql(f"OPTIMIZE {t}")
        print(f"OPTIMIZE {t}: {time.time() - t0:.0f}s")


# ============================================================
# Orchestrator entry point
# ============================================================

def run_orchestrator(
    pipeline_configs,
    triggered_by="Scheduled",
    max_attempts=2,
    inter_attempt_wait_seconds=15,
    inter_pipeline_wait_seconds=0,
    allow_run_with_stale_running_run=False,
    retry_non_transient=False,
    stale_after_hours="auto",
    raise_on_failure=True,
    tune_spark=True,
    session_limit_hours=4.0,
    start_cutoff_hours=3.0,
    safety_margin_minutes=10,
    duration_safety_factor=1.25,
    unknown_duration_minutes=90,
    fresh_session_minutes=30,
    resume=True,
    resume_gap_minutes=60,
    resume_window_hours=24,
    max_parallel=1,
    stall_minutes=20,
    parallel_duration_factor=1.3,
    heartbeat_minutes=10,
    watchdog=True,
    overrun_factor=2.0,
    overrun_min_minutes=30,
    overrun_min_minutes_parallel=90,
    busy_retry_wait_seconds=180,
    duration_history=3,
    heavy_minutes=30,
):
    """
    Runs every config through run_batch_tracked_merge(), one at a time, with
    retry, logging:
      - one RUN_TABLE row for the whole notebook execution
      - one ATTEMPT_TABLE row per attempt per pipeline, linked to the
        pipeline's own batch_table.BATCH_ID on success

    session_limit_hours: the Spark session's max lifetime (the "configured N
    hours lifetime" in JOB_REACHED_MAX_LIFETIME). Keep it equal to the real
    lifetime. None disables the time box. See header A for the start rules.

    resume=True: continue the previous run chain (header B).

    stale_after_hours="auto" = session_limit_hours: cleanup of killed
    sessions (header C). None turns the cleanup off.

    STALE-RUN GUARD: refuses to start if another RUN_TABLE row is still
    STATUS = 'RUNNING' (after the cleanup). Override with
    allow_run_with_stale_running_run=True.

    max_parallel: 1 = sequential (one pipeline at a time, config order).
    2..4 = independent pipelines run together (header F). A round that follows
    a parallel watchdog stop in the same resume chain runs sequentially.

    watchdog (header I): True = each pipeline runs in a worker thread and the
    round stops cleanly when it stalls (no Spark job for stall_minutes) or
    overruns (attempt longer than max(overrun_factor x expected, expected +
    overrun_min_minutes); overrun_factor=None turns that part off).
    watchdog=False with max_parallel=1 = the v4 sequential loop. Parallel
    mode always has the stall watchdog; its overrun margin is
    overrun_min_minutes_parallel instead of overrun_min_minutes (header N).

    heavy_minutes (header P): in parallel mode, pipelines whose recent time
    is at least this many minutes (or that have no history) never run at the
    same time as each other. None = no such rule.

    duration_history: how many recent successful runs set the expected time
    (header J). busy_retry_wait_seconds: wait before retrying a storage
    "server busy" error (header K).
    """
    # Count from when the Spark session started (the lifetime clock), not from
    # this call: %run MERGE_NB / CONFIG_NB and earlier cells already used some.
    try:
        session_start = datetime.fromtimestamp(spark.sparkContext.startTime / 1000.0)
    except Exception:
        session_start = datetime.now()

    budget_seconds = (
        None if session_limit_hours is None
        else session_limit_hours * 3600 - safety_margin_minutes * 60
    )
    cutoff_seconds = (
        None if session_limit_hours is None or start_cutoff_hours is None
        else start_cutoff_hours * 3600
    )

    def elapsed():
        return (datetime.now() - session_start).total_seconds()

    def fits(expected_seconds):
        if budget_seconds is None:
            return True
        if cutoff_seconds is not None and elapsed() >= cutoff_seconds:
            return False
        return elapsed() + expected_seconds <= budget_seconds

    if stale_after_hours == "auto":
        stale_after_hours = session_limit_hours

    if tune_spark:
        configure_spark_for_efficiency()   # defined in MERGE_NB

    _ensure_table(RUN_TABLE, ORCHESTRATION_RUN_SCHEMA)
    _ensure_table(ATTEMPT_TABLE, ORCHESTRATION_ATTEMPT_SCHEMA)

    batch_tables = sorted({c["batch_table"] for c in pipeline_configs})
    all_names = [c["pipeline_name"] for c in pipeline_configs]

    # Parallel: create missing batch tables here, once, so pipelines running
    # together do not race to create the same table (first run only).
    if max_parallel > 1:
        for bt in batch_tables:
            try:
                _ensure_batch_table(bt)          # defined in MERGE_NB
            except NameError:
                break

    # ---- Cleanup of killed runs, then stale-run guard ----
    if stale_after_hours is not None:
        _close_dead_runs(stale_after_hours)

    stale_running = (
        spark.table(RUN_TABLE)
        .filter(col("STATUS") == "RUNNING")
        .count()
    )
    if stale_running > 0 and not allow_run_with_stale_running_run:
        raise RuntimeError(
            f"Found {stale_running} orchestrator run(s) already RUNNING in "
            f"{RUN_TABLE}. Refusing to start a new run to avoid a RUN_ID "
            f"collision / interleaved attempt rows with that run. "
            f"Investigate {RUN_TABLE}, or pass "
            f"allow_run_with_stale_running_run=True."
        )

    # No orchestrator run is alive, so RUNNING batch rows are leftovers of a
    # killed session (they would trip run_batch_tracked_merge's own guard).
    if stale_after_hours is not None and stale_running == 0:
        _close_dead_batches(batch_tables, all_names, stale_after_hours)

    # ---- Resume: which pipelines are already done ----
    run_start = datetime.now()
    done_info, resumed_from = (
        _already_done_pipelines(resume_gap_minutes, resume_window_hours,
                                stale_after_hours, run_start)
        if resume else ({}, [])
    )
    # A done pipeline must run again (after its upstream, in config order) if a
    # pipeline it depends on runs again now, or succeeded again after it did --
    # so nothing keeps data built on an old input.
    redo = set()
    if done_info:
        deps = _depends_on_earlier(pipeline_configs)
        rerun_idx = set()
        for j, c in enumerate(pipeline_configs):
            n = c["pipeline_name"]
            stale = False
            if n in done_info:
                for i in deps[j]:
                    ni = pipeline_configs[i]["pipeline_name"]
                    if i in rerun_idx or (
                        ni in done_info and done_info[ni][1] > done_info[n][0]
                    ):
                        stale = True
                        break
            if n not in done_info or stale:
                rerun_idx.add(j)
                if n in done_info:
                    redo.add(n)
    # Pipelines the watchdog stopped earlier in this chain run without it now
    # (header I), and a parallel watchdog stop makes the rest of the chain
    # sequential (header G).
    exempt = set()
    if resumed_from:
        notes = {r["RUN_ID"]: r.get("RUN_NOTE") for r in _recent_runs(limit=50)}
        parallel_stops = []
        for rid in resumed_from:
            note = notes.get(rid) or ""
            note_kind, _, who = note.partition(": ")
            if note_kind in ("STALL", "OVERRUN", "PARALLEL_STALL", "PARALLEL_OVERRUN"):
                exempt.update(n.strip() for n in who.split(",") if n.strip())
                if note_kind.startswith("PARALLEL_"):
                    parallel_stops.append(rid)
        if max_parallel > 1 and parallel_stops:
            print(f"Run(s) {parallel_stops} of this chain were stopped by the watchdog in "
                  f"parallel mode -> this round runs SEQUENTIALLY (max_parallel=1).")
            max_parallel = 1
        if exempt:
            print(f"Watchdog off for {sorted(exempt)} in this round "
                  f"(the watchdog stopped them earlier in this chain).")
    use_threads = max_parallel > 1 or watchdog
    done_names = set(done_info) - redo
    to_run = [c for c in pipeline_configs if c["pipeline_name"] not in done_names]
    skipped_done = [c["pipeline_name"] for c in pipeline_configs
                    if c["pipeline_name"] in done_names]

    # ---- Expected time per pipeline ----
    history = (
        _recent_durations([c["pipeline_name"] for c in to_run], batch_tables,
                          history=duration_history)
        if to_run and (budget_seconds is not None or use_threads) else {}
    )
    expected = {
        c["pipeline_name"]: (
            history[c["pipeline_name"]] * duration_safety_factor
            if c["pipeline_name"] in history
            else unknown_duration_minutes * 60
        ) * (parallel_duration_factor if max_parallel > 1 else 1.0)
        for c in to_run
    }

    # Heavy pipelines (header P): never two of them at the same time.
    heavy = frozenset(
        c["pipeline_name"] for c in to_run
        if max_parallel > 1 and heavy_minutes
        and history.get(c["pipeline_name"], float("inf")) >= heavy_minutes * 60
    )

    def overrun_cap(name, first_in_fresh_session):
        """Seconds an attempt may run before the watchdog stops it (header I),
        or None (no cap)."""
        if (not watchdog or not overrun_factor or name in exempt
                or name not in history or first_in_fresh_session):
            return None
        exp = expected[name]
        margin = (overrun_min_minutes if max_parallel == 1         # v6, header N
                  else overrun_min_minutes_parallel)
        return max(overrun_factor * exp, exp + margin * 60)

    run_id = _next_run_id()

    print("=============================================")
    print("STARTING ORCHESTRATOR RUN")
    print("Run ID       :", run_id)
    print("Run Start    :", run_start)
    print("Pipelines    :", len(pipeline_configs))
    if budget_seconds is not None:
        print("Session up   :", _fmt_min(elapsed()), "(since", session_start, ")")
        print("New starts   : until", _fmt_min(cutoff_seconds),
              f"| must end by {_fmt_min(budget_seconds)} "
              f"(session limit {session_limit_hours}h - {safety_margin_minutes} min)")
    if skipped_done:
        print(f"Resuming     : runs {resumed_from} -- skipping {len(skipped_done)} "
              f"already done: {skipped_done}")
    if redo:
        print(f"Run again    : {sorted(redo)} (they depend on a pipeline that runs again)")
    print("To run       :", len(to_run))
    print("Parallel     :", max_parallel if max_parallel > 1 else "no (sequential)")
    if heavy:                                               # v6, header P
        print("Heavy        :", sorted(heavy), "(never two of them at the same time)")
    if use_threads:
        print("Watchdog     :", f"stall {stall_minutes} min" + (
            f", overrun max({overrun_factor:g} x expected, expected + "
            f"{overrun_min_minutes if max_parallel == 1 else overrun_min_minutes_parallel} min)"
            if watchdog and overrun_factor else ""))
    if max_parallel > 1:
        print("Start order  : longest expected chain first (of the pipelines that are ready)")
    try:                                                    # v6, header O
        print("Scheduler    :", spark.sparkContext.getConf().get("spark.scheduler.mode", "FIFO"))
    except Exception:
        pass
    if budget_seconds is not None:
        for c in to_run:
            n = c["pipeline_name"]
            src = "history x factor" if n in history else "no history yet"
            print(f"   {n:<40} expected {_fmt_min(expected[n])} ({src})")
    print("=============================================")

    _append_row(RUN_TABLE, ORCHESTRATION_RUN_SCHEMA, [
        run_id, run_start, None, "RUNNING",
        len(pipeline_configs), 0, 0, None,
        triggered_by, None,
        ",".join(skipped_done) if skipped_done else None,
        session_start,
        None,
    ])

    results = {}
    failed_pipelines = []
    pending = []          # not run because of the time limit
    stalled = []          # pipelines the watchdog stopped
    watchdog_kind = None  # 'STALL' / 'OVERRUN'
    stop_flag = threading.Event()

    try:
        if use_threads:
            pending, stalled, watchdog_kind = _run_round(
                to_run, expected, run_id, results, failed_pipelines, stop_flag,
                fits, elapsed, max_parallel, max_attempts, inter_attempt_wait_seconds,
                retry_non_transient, fresh_session_minutes, stall_minutes,
                heartbeat_minutes, cutoff_seconds, budget_seconds,
                overrun_cap, exempt, busy_retry_wait_seconds,
                inter_pipeline_wait_seconds, heavy=heavy,
            )
        else:
            for i, cfg in enumerate(to_run):
                name = cfg["pipeline_name"]
                exp = expected[name]

                # The first pipeline of a FRESH session always starts: stopping before
                # it would make no progress, and a new session would face the same
                # check. (In an old interactive session it is checked like the rest.)
                first_in_fresh_session = i == 0 and elapsed() < fresh_session_minutes * 60
                if not first_in_fresh_session and not fits(exp):
                    pending = [c["pipeline_name"] for c in to_run[i:]]
                    print("=============================================")
                    print(f"TIME LIMIT: elapsed {_fmt_min(elapsed())}, {name} expected "
                          f"{_fmt_min(exp)}, start cutoff {_fmt_min(cutoff_seconds)}, "
                          f"must end by {_fmt_min(budget_seconds)}.")
                    print(f"Stopping cleanly. Not run (next run resumes here): {pending}")
                    print("=============================================")
                    break

                print(f">>> {name} | session up {_fmt_min(elapsed())} | "
                      f"expected {_fmt_min(exp)}")
                attempt = 1

                while attempt <= max_attempts:
                    attempt_start = datetime.now()
                    try:
                        res = run_batch_tracked_merge(**_merge_args(cfg, run_id))
                        results[name] = res
                        attempt_end = datetime.now()

                        _append_row(ATTEMPT_TABLE, ORCHESTRATION_ATTEMPT_SCHEMA, [
                            run_id, name, attempt, attempt_start, attempt_end,
                            "SUCCESS", None,
                            (attempt_end - attempt_start).total_seconds(),
                            res.get("batch_id"),
                        ])
                        break

                    except Exception as e:
                        attempt_end = datetime.now()
                        _append_row(ATTEMPT_TABLE, ORCHESTRATION_ATTEMPT_SCHEMA, [
                            run_id, name, attempt, attempt_start, attempt_end,
                            "FAILED", str(e),
                            (attempt_end - attempt_start).total_seconds(),
                            None,
                        ])

                        # Release anything the failed attempt left cached.
                        spark.catalog.clearCache()

                        non_transient = isinstance(e, NON_TRANSIENT_ERRORS)
                        retry_fits = fits(exp)
                        can_retry = attempt < max_attempts and retry_fits and (
                            retry_non_transient or not non_transient
                        )

                        if can_retry:
                            print(f"Attempt {attempt} failed for {name}: {e}")
                            print(f"Waiting {inter_attempt_wait_seconds} seconds before retry...")
                            time.sleep(inter_attempt_wait_seconds)
                            attempt += 1
                        else:
                            if non_transient and attempt < max_attempts:
                                why = "non-transient error, not retrying"
                            elif not retry_fits and attempt < max_attempts:
                                why = "no time left in this session for a retry"
                            else:
                                why = "giving up on this pipeline"
                            print(f"Attempt {attempt} failed for {name}: {e} -- {why}")
                            failed_pipelines.append(name)
                            break

                # Free cached DataFrames before the next pipeline starts.
                spark.catalog.clearCache()

                if i < len(to_run) - 1 and inter_pipeline_wait_seconds:
                    print(f"Pausing {inter_pipeline_wait_seconds}s before next pipeline "
                          f"(session stays active; capacity remains allocated)...")
                    time.sleep(inter_pipeline_wait_seconds)

        run_end = datetime.now()
        # A round that stops for time must have finished at least one pipeline
        # that was not done before; otherwise the next round would be the same
        # (e.g. the first pipeline keeps failing) and the Until loop would never
        # end. Then it ends as a failure instead.
        progressed = any(n not in redo for n in results)
        no_progress = bool(pending) and bool(failed_pipelines) and not progressed
        # Nothing could even start: this Spark session is already old (Fabric
        # handed this round the previous round's session -- high concurrency).
        # Ending quickly is right: that session dies at its lifetime limit at
        # the latest, and the next round then gets a fresh one.
        old_session = (bool(pending) and not results and not failed_pipelines
                       and not stalled)
        if pending and not no_progress:
            status = "STOPPED_TIME_LIMIT"
        elif not failed_pipelines:
            status = "SUCCESS"
        else:
            status = "PARTIAL_FAILURE" if (results or skipped_done) else "FAILED"

        _update_run_row(run_id, {
            "RUN_END_DTTM": run_end,
            "STATUS": status,
            "SUCCEEDED_COUNT": len(results),
            "FAILED_COUNT": len(failed_pipelines),
            "FAILED_PIPELINE_NAMES": ",".join(failed_pipelines) if failed_pipelines else None,
            "PENDING_PIPELINE_NAMES": ",".join(pending) if pending else None,
            "RUN_NOTE": (
                ("PARALLEL_" if max_parallel > 1 else "") + f"{watchdog_kind}: "
                + ",".join(stalled)
            )[:1000] if stalled else None,
        }, lock_timeout=120 if stalled else None)

        print("=============================================")
        print(f"Run ID: {run_id} | Status: {status} | "
              f"Completed this run: {len(results)} | Already done: {len(skipped_done)} | "
              f"Total: {len(pipeline_configs)} | Session up: {_fmt_min(elapsed())}")
        if failed_pipelines:
            print("FAILED :", failed_pipelines)
        if pending:
            print("PENDING (next round continues here):", pending)
            if failed_pipelines:
                print("The FAILED pipelines above are retried first in the next round.")
        print("=============================================")

        outcome = {
            "run_id": run_id,
            "status": status,
            "results": results,
            "failed_pipelines": failed_pipelines,
            "pending_pipelines": pending,
            "skipped_done_pipelines": skipped_done,
            "stalled_pipelines": stalled,
            "watchdog": watchdog_kind,
        }

        if old_session:
            print(f"OLD SESSION: this Spark session started at {session_start} "
                  f"({_fmt_min(elapsed())} ago), it was reused from an earlier round. "
                  f"Nothing fits, so this round ends now; a later round gets a "
                  f"new session.")
        if no_progress:
            print("No pipeline finished in this round and the first one failed: "
                  "stopping the loop instead of repeating the same round.")
        if failed_pipelines and raise_on_failure and (not pending or no_progress):
            # Run row is already closed above; this only surfaces the failure
            # to the Fabric schedule / pipeline activity. Not raised while
            # pipelines are pending: the next round retries the failed ones.
            raise RuntimeError(
                f"Orchestrator run {run_id} finished with status {status}. "
                f"Failed pipelines: {failed_pipelines}"
            )

        return outcome

    except BaseException as e:
        # Worker threads: start no retries, cancel the running Spark jobs.
        stop_flag.set()
        if use_threads:
            try:
                spark.sparkContext.cancelAllJobs()
            except Exception:
                pass
        # Only close the run row here if it is still RUNNING (i.e. the failure
        # came from outside the normal completion path, or the cell was
        # interrupted) -- otherwise keep the accurate status written above.
        still_running = (
            spark.table(RUN_TABLE)
            .filter((col("RUN_ID") == run_id) & (col("STATUS") == "RUNNING"))
            .count() > 0
        )
        if still_running:
            _update_run_row(run_id, {
                "RUN_END_DTTM": datetime.now(),
                "STATUS": "FAILED",
                "SUCCEEDED_COUNT": len(results),
                "FAILED_COUNT": len(to_run) - len(results),
                "FAILED_PIPELINE_NAMES": (
                    ",".join(failed_pipelines) if failed_pipelines else str(e)[:1000]
                ),
            }, lock_timeout=120 if use_threads else None)
        raise


# ============================================================
# Run it
# ============================================================

if __name__ == "__main__":
    # v6 default: two pipelines at a time (header L). Options, e.g.:
    #   outcome = run_orchestrator(pipeline_configs, max_parallel=1)   # = v5 sequential
    #   outcome = run_orchestrator(pipeline_configs, max_parallel=3)   # three at a time
    outcome = run_orchestrator(pipeline_configs, max_parallel=2)

    # Hand the status to the Data pipeline (Until loop checks for
    # 'STOPPED_TIME_LIMIT' and starts a fresh session to continue).
    notebookutils.notebook.exit(outcome["status"])
