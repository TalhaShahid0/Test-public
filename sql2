Variant 3


WITH note_dates AS
( SELECT 
		NOTE_ID,
		CONTACT_DATE,
		CONTACT_DATE_REAL,
		LINE,
		NOTE_TEXT
	FROM 
		CLARITY.HNO_NOTE_TEXT
    WHERE CONTACT_DATE >= TO_DATE('06/15/2026','mm/dd/yyyy')
    AND   CONTACT_DATE <= TO_DATE('06/30/2026','mm/dd/yyyy')
),
smartpharse_notes AS
( SELECT 
		DISTINCT NOTE_ID
		FROM 
			CLARITY.NOTE_SMARTPHRASE_IDS
		WHERE SMARTPHRASES_ID IN(592203,592204,481086,573124)
),
ranked AS
(
SELECT  DISTINCT
        PT.PAT_MRN_ID "mrn",
        TBL.PERSON_ID "personid",
        ENC.PAT_ENC_CSN_ID "encounter_id",
        EMP.NAME "author_name",
        HNT.CONTACT_DATE "interviewdate",
        HNT.LINE "line",
        HNT.NOTE_TEXT "note_text",
        RANK ()OVER (PARTITION BY HNT.NOTE_ID ORDER BY HNT.CONTACT_DATE_REAL DESC) RN
FROM TBL_PERSON_ID_1585 TBL
JOIN CLARITY.PATIENT PT				ON 		PT.PAT_ID = TBL.PAT_ID    
JOIN CLARITY.PAT_ENC ENC    		ON 		ENC.PAT_ID = PT.PAT_ID    
JOIN CLARITY.HNO_INFO HN    		ON 		ENC.PAT_ENC_CSN_ID = HN.PAT_ENC_CSN_ID    
JOIN CLARITY.NOTE_ENC_INFO HNO  	ON  	HN.NOTE_ID = HNO.NOTE_ID
JOIN note_dates HNT				    ON		HNT.NOTE_ID = HNO.NOTE_ID	AND 	UPPER(HNT.NOTE_TEXT) LIKE '%BIRT%'
JOIN smartpharse_notes SMRT         ON 		HNO.NOTE_ID = SMRT.NOTE_ID 	
LEFT JOIN CLARITY.CLARITY_EMP EMP 	ON 		HNO.AUTHOR_USER_ID = EMP.USER_ID	
)
SELECT "mrn",
        "personid",
        "encounter_id",
        "author_name",
        "interviewdate",
        "line",
        "note_text"
FROM 
	ranked
WHERE RN = 1
ORDER BY "mrn", "encounter_id", "line";
