# ============================================================================
# CHECK_NATIVE_ENGINE (2026-11-12). READ ONLY: writes nothing, changes no table.
#
# Question: if the Fabric Native Execution Engine is switched on, do the
# pipelines still give exactly the same rows and the same ROW_HASH? And how
# much faster are their source queries with it?
#
# For each pipeline of the chosen GROUP it runs the source query twice in the
# same session, first with the native engine ON, then OFF (normal Spark), and
# compares a fingerprint of the result:
#   - number of rows
#   - ROW_HASH exactly as MERGE computes it (MERGE's own _sync_spec)
#   - a second hash over ALL business columns, so every value is compared
#     (for the 3 tables with primary keys, ROW_HASH covers only the keys)
# "SAME" = same row count and the same set of hashes. Any "DIFFERENT" means
# the native engine must NOT be switched on for the pipeline.
#
# HOW TO RUN (a NEW notebook, 4 cells, in the same workspace as the pipeline):
#   CELL 1 (its own cell, must be the FIRST cell):
#       %%configure -f
#       {
#           "conf": {
#               "spark.native.enabled": "true"
#           }
#       }
#   CELL 2:  %run MERGE_NB        (the same MERGE notebook the pipeline uses)
#   CELL 3:  %run CONFIG_NB       (the same CONFIG notebook the pipeline uses)
#   CELL 4:  this file, from the line "GROUP = 3" down.
# Run it in the daytime, NOT while the nightly pipeline or a Clarity load
# runs (the data must not change between the two runs of a query).
# Each group fits easily in one session. Start with GROUP = 3 (NOTES_C, where
# native should help most), send the whole output of cell 4, then GROUP = 4,
# 2 and 1 (change GROUP and run cell 4 again; same session is fine):
#   1 = the 20 light pipelines (~1 h)   2 = LABS, LABS_POP, FLWSHT (~1-1.5 h)
#   3 = NOTES_C (~1 h)                  4 = MEDS (~1.5-2 h)
# ============================================================================

GROUP = 3

import time
from pyspark.sql import functions as F

_GROUPS = {
    2: ["TBL_ALLERGY_LABS", "TBL_ALLERGY_LABS_POP", "TBL_ALLERGY_FLWSHT"],
    3: ["TBL_ALLERGY_NOTES_C"],
    4: ["TBL_ALLERGY_MEDS"],
}
_heavy = {n for names in _GROUPS.values() for n in names}
if GROUP == 1:
    _names = [c["pipeline_name"] for c in pipeline_configs if c["pipeline_name"] not in _heavy]
else:
    _names = _GROUPS[GROUP]
_by_name = {c["pipeline_name"]: c for c in pipeline_configs}

configure_spark_for_efficiency()          # the same Spark settings as a pipeline run


def _hash_exprs(cfg):
    spec = _sync_spec(cfg["target_table"], cfg.get("primary_keys", ""),
                      cfg.get("non_key_columns", ""), cfg.get("identity_column"))
    cols = [c for c in spec["allColsList"] if c != spec["identityLower"]]
    all_cols = ", ".join(f"coalesce(cast({c} as string), '')" for c in cols)
    return spec["rowHashExpr"], f"sha2(concat_ws('||', {all_cols}), 256)"


def _native_ops(df):
    try:
        p = df._jdf.queryExecution().executedPlan().toString()
        return p.count("Transformer") + p.count("NativeFileScan")
    except Exception:
        return -1


def _fingerprint(cfg, native):
    spark.conf.set("spark.native.enabled", "true" if native else "false")
    row_hash, all_hash = _hash_exprs(cfg)
    df = (spark.sql(cfg["source_query"])
          .selectExpr(f"{row_hash} AS rh", f"{all_hash} AS ah")
          .agg(F.count(F.lit(1)).alias("n"),
               F.expr("bit_xor(xxhash64(rh))").alias("rh_x"),
               F.expr("sum(cast(conv(substr(rh, 1, 7), 16, 10) AS BIGINT))").alias("rh_s"),
               F.expr("bit_xor(xxhash64(ah))").alias("ah_x"),
               F.expr("sum(cast(conv(substr(ah, 1, 7), 16, 10) AS BIGINT))").alias("ah_s")))
    t = time.time()
    r = df.collect()[0]
    return tuple(r), (time.time() - t) / 60, _native_ops(df)


try:
    _native_start = spark.conf.get("spark.native.enabled")
except Exception:
    _native_start = "not set"
print(f"GROUP {GROUP}: {len(_names)} pipelines | Spark {spark.version} | "
      f"native at start: {_native_start}", flush=True)
_results = []
for name in _names:
    cfg = _by_name[name]
    try:
        fp_on, min_on, ops_on = _fingerprint(cfg, True)
        fp_off, min_off, ops_off = _fingerprint(cfg, False)
        same = fp_on == fp_off
        _results.append((name, same, min_on, min_off, ops_on))
        print(f"{name}: {'SAME' if same else 'DIFFERENT'} | rows {fp_on[0]:,} vs {fp_off[0]:,} | "
              f"native {min_on:.1f} min vs normal {min_off:.1f} min | native operators {ops_on} vs {ops_off}",
              flush=True)
        if not same:
            print(f"   native: {fp_on}\n   normal: {fp_off}", flush=True)
    except Exception as e:
        _results.append((name, None, 0, 0, 0))
        print(f"{name}: ERROR {type(e).__name__}: {str(e)[:300]}", flush=True)
spark.conf.set("spark.native.enabled", "true")

_ok = [r for r in _results if r[1] is True]
_bad = [r[0] for r in _results if r[1] is False]
_err = [r[0] for r in _results if r[1] is None]
print("=" * 70)
print(f"SAME {len(_ok)} | DIFFERENT {len(_bad)} {_bad} | ERROR {len(_err)} {_err}")
if _ok:
    print(f"source queries: native {sum(r[2] for r in _ok):.1f} min vs normal {sum(r[3] for r in _ok):.1f} min "
          f"(native ran first, so the normal runs had the warmer file cache)")
if any(r[4] == 0 for r in _ok):
    print("WARNING: some 'native' runs had no native operators, so the engine was not really on. "
          "Check that cell 1 (%%configure) is the first cell and ran.")
