# ============================================================================
# MERGE_NB -- Oracle MV -> Fabric Delta sync framework  (resource-optimized)
# ============================================================================
#
# SAME LOGIC AS BEFORE (two modes, keyed on whether primary_keys is empty):
#   A. primary_keys = ""            -> row_hash over whole row (grain = row version)
#   B. primary_keys = "COL_A, ..."  -> row_hash over PKs, non-key columns compared
#                                      with <=> to detect updates (grain = entity)
#   identity_column is excluded from row_hash but still written. Metrics are
#   keyed on BATCH_ID semantics. All guards are kept.
#
# WHAT CHANGED (performance / resource only, no change to sync semantics)
#
#   1. Source is evaluated ONCE per pipeline. The heavy multi-join source query
#      is persisted (MEMORY_AND_DISK) and every later step (PK validation, key
#      assignment, count, hash, insert) reads that cached copy instead of
#      re-running the joins 4-6 times.
#   2. latest-version-per-row_hash of the target is computed ONCE per run
#      (was: twice inside the INSERT, again in the key lookup, again in
#      _active_target_count x2, again in _measure_sync_metrics).
#   3. Inserted / updated / deleted counts come from a change_type tag on the
#      rows being appended (I / U / D), so there is no post-hoc scan of the
#      target history. Result is identical to the old BATCH_ID classification.
#   4. Surrogate keys are generated in parallel (partition offsets) instead of a
#      single-partition row_number(). Still sequential-with-gaps-free per run.
#   5. Mode B: the joined key DataFrame is cached because it is consumed twice.
#   6. Spark conf tuning (AQE, skew join, broadcast, optimize write).
#   7. run_all_pipelines(): sequential runner, one pipeline at a time, cache
#      cleared between pipelines, optional pause and optional OPTIMIZE, and
#      per-pipeline failure isolation.
#
# SPEED PASS (optimized/ copy, 2026-10-02) -- sync logic, row_hash, soft
# deletes, keys and every ALLERGY_BATCHES value are unchanged:
#   8. Fewer cached copies of the source. The keyed source is no longer a
#      separate persisted copy (and neither is the _pid/_mid "base"): keys are
#      a fixed projection of the already-cached source, so they come out the
#      same every time it is read. Mode A: 3 cached copies -> 1. Mode B: 4 -> 2.
#   9. Partition offsets for the surrogate key are collected to the driver
#      (a few hundred numbers) instead of re-running a window on every read.
#  10. SOURCE_RECORD_COUNT for identity pipelines comes from the counts the key
#      step already computed -- no extra count() pass.
#  11. PK validation: NULL check and duplicate check in ONE pass (was two).
#  12. Stale-RUNNING guard and next BATCH_ID read in ONE query (was two), and
#      the batch-table existence/schema check runs once per session.
#  13. Thread-safe for parallel runs in one Spark session (ORCHESTRATOR_NB
#      max_parallel): BATCH_ID allocation + RUNNING row, and every write to the
#      batch table, happen under one lock, so two pipelines can never get the
#      same BATCH_ID or collide on a Delta commit to ALLERGY_BATCHES.
#
# ---- PUT THIS IN THE VERY FIRST CELL (its own cell) TO CAP SESSION SIZE -----
# %%configure
# {
#   "driverCores": 4, "driverMemory": "28g",
#   "executorCores": 4, "executorMemory": "28g",
#   "numExecutors": 4,
#   "conf": {
#     "spark.dynamicAllocation.enabled": "true",
#     "spark.dynamicAllocation.minExecutors": "1",
#     "spark.dynamicAllocation.maxExecutors": "4",
#     "spark.native.enabled": "true"
#   }
# }
# Lower numExecutors / maxExecutors to lower consumption. Native execution
# engine (Runtime 1.3) must be enabled at session start, not at runtime.
#
# IF YOU ARE SEEING ExitCode 137 (OOM-killed executor / container):
#   137 means the container used more memory than it was allocated, not a
#   code bug -- it happens to whichever executor is holding the largest task
#   or cached partition at the time. Two independent levers:
#     1. Fewer cores per executor for the SAME memory, i.e. more memory per
#        core (a wide join/window on a skewed key needs headroom per task):
#          "executorCores": 2, "executorMemory": "28g", "numExecutors": 6
#     2. Partition counts are now sized automatically from the data (AQE +
#        REBALANCE, ~128 MB per partition), so big tables get more partitions
#        and small ones fewer with no per-table setting. Only if 137 keeps
#        happening, lower advisory_partition_mb in
#        configure_spark_for_efficiency (e.g. 64) for smaller partitions.
# ============================================================================

import time
import threading
from functools import reduce

from pyspark import StorageLevel
from pyspark.sql.functions import (
    col, lit, max as spark_max, coalesce, row_number, desc, broadcast,
    spark_partition_id, monotonically_increasing_id,
    sum as spark_sum, count as spark_count, when,
)
from pyspark.sql.types import (
    StructType, StructField, StringType, LongType, TimestampType
)
from pyspark.sql.window import Window
from delta.tables import DeltaTable
from datetime import datetime


SYSTEM_COLS = {"is_deleted", "row_hash", "dw_updated_at", "batch_id",
               "payload_hash", "entity_key"}

_PERSIST = StorageLevel.MEMORY_AND_DISK   # spill to disk instead of evicting

# Internal I/U/D tag added to the rows being appended. Deliberately an
# unlikely name so it can never collide with a business column (a real column
# called CHANGE_TYPE broke the first version). It is never written to the target.
CHG_TAG = "__sync_chg__"

# One lock for everything that reads-then-writes the batch table (BATCH_ID
# allocation) or commits to it. These are tiny, so serialising them costs
# nothing, and it is what makes parallel pipelines in one session safe.
_BATCH_LOCK = threading.RLock()
_ENSURED_BATCH_TABLES = set()


# ============================================================================
# Spark configuration for lower CPU / shuffle pressure
# ============================================================================

def configure_spark_for_efficiency(broadcast_mb=100, shuffle_partitions=2000,
                                   advisory_partition_mb=128):
    """
    Runtime-settable tuning. Anything the runtime refuses is skipped quietly.
    (Executor count / cores / memory / native engine must be set in %%configure
    -- see the header. shuffle_partitions controls how finely a big shuffle is
    split; too few partitions on skewed/large data is a common cause of a
    single task outgrowing executor memory and getting OOM-killed (exit 137).)

    AUTO-SIZING: shuffle_partitions is only the STARTING count. AQE coalesces
    each shuffle down to ~advisory_partition_mb per partition, so a 300M-row
    table keeps many partitions and a 10k-row table ends up with a handful.
    Start high (2000) so big tables are never under-partitioned.
    """
    settings = {
        "spark.sql.adaptive.enabled": "true",
        "spark.sql.adaptive.coalescePartitions.enabled": "true",
        "spark.sql.adaptive.skewJoin.enabled": "true",
        # Split a partition once it exceeds this size OR is this many times
        # the median partition -- lower than the 256m/5x defaults so skew is
        # caught before a task grows large enough to OOM.
        "spark.sql.adaptive.skewJoin.skewedPartitionThresholdInBytes": "128m",
        "spark.sql.adaptive.skewJoin.skewedPartitionFactor": "3",
        "spark.sql.adaptive.advisoryPartitionSizeInBytes": f"{advisory_partition_mb}m",
        "spark.sql.adaptive.coalescePartitions.parallelismFirst": "false",
        # Let AQE resize partitions of plans that are cached (persist) too.
        "spark.sql.optimizer.canChangeCachedPlanOutputPartitioning": "true",
        "spark.sql.autoBroadcastJoinThreshold": str(broadcast_mb * 1024 * 1024),
        "spark.microsoft.delta.optimizeWrite.enabled": "true",
        "spark.sql.files.maxPartitionBytes": "134217728",
        # More, smaller shuffle partitions -> each task holds less data in
        # memory. AQE coalesces small ones back down, so this mainly helps
        # the skewed/large end rather than adding overhead on the small end.
        "spark.sql.shuffle.partitions": str(shuffle_partitions),
        # Spill aggressively to disk instead of holding it all in memory.
        "spark.sql.adaptive.forceOptimizeSkewedJoin": "true",
        # Clarity has placeholder dates before 1582-10-15 / timestamps before
        # 1900-01-01. CORRECTED writes/reads them exactly as-is (no value
        # change); without it the Parquet write fails with WRITE_ANCIENT_DATETIME.
        "spark.sql.parquet.datetimeRebaseModeInWrite": "CORRECTED",
        "spark.sql.parquet.int96RebaseModeInWrite": "CORRECTED",
        "spark.sql.parquet.datetimeRebaseModeInRead": "CORRECTED",
        "spark.sql.parquet.int96RebaseModeInRead": "CORRECTED",
    }
    for k, v in settings.items():
        try:
            spark.conf.set(k, v)
        except Exception as e:
            print(f"   (skipped conf {k}: {str(e)[:80]})")


def _repartition_for_size(df, target_partitions=None):
    """
    Repartitions before persisting so one task doesn't hold a disproportionate
    share of the data -- the direct fix for a single OOM-killed (exit 137)
    task on skewed input. Called on the staged source and on the target's
    latest-version DataFrame, the two large DataFrames this script caches.

    AUTO-SIZED: with no target_partitions, a REBALANCE hint is used instead of
    a fixed repartition(n). AQE then picks the partition count from the actual
    data size (~advisoryPartitionSizeInBytes each) and splits skewed ones, so
    no per-table partition setting is needed. Row content/order semantics are
    unchanged (it is still a plain round-robin redistribution).
    """
    if target_partitions:
        return df.repartition(target_partitions)
    return df.hint("rebalance")


def _split_cols(s):
    return [c.strip() for c in s.split(",") if c.strip()] if s and s.strip() else []


def _safe_name(prefix, table):
    return prefix + "".join(ch if ch.isalnum() else "_" for ch in table)


def _resolve_cols(df, names, context):
    """Map config-supplied column names onto the DataFrame's actual casing."""
    lookup = {c.lower(): c for c in df.columns}
    resolved = []
    for n in names:
        key = n.strip().lower()
        if key not in lookup:
            raise ValueError(
                f"{context}: column '{n}' is not present in the source query. "
                f"Available: {sorted(df.columns)}"
            )
        resolved.append(lookup[key])
    return resolved


# ============================================================================
# Shared helpers: source staging, latest-version, parallel sequential keys
# ============================================================================

def _stage_source(source_query, target_table):
    """
    Evaluate the (expensive) source query once and keep it. Everything after
    this reads the persisted copy through a temp view. Repartitioned before
    persisting so a skewed source (a hot key concentrating rows into a few
    partitions) doesn't leave one cached partition large enough to OOM-kill
    the executor holding it (exit code 137).
    """
    df = _repartition_for_size(spark.sql(source_query)).persist(_PERSIST)
    view = _safe_name("_src_", target_table)
    df.createOrReplaceTempView(view)
    return f"SELECT * FROM {view}", view, df


def _latest_target_df(target_table):
    """
    Latest version per ROW_HASH (including soft-deleted). Persisted; the caller
    unpersists. Computed once per run and shared by key lookup + sync.
    """
    df = spark.table(target_table)
    w = Window.partitionBy("ROW_HASH").orderBy(desc("DW_UPDATED_AT"), desc("BATCH_ID"))
    latest = (
        df.withColumn("_rn", row_number().over(w))
          .filter(col("_rn") == 1)
          .drop("_rn")
    )
    latest = _repartition_for_size(latest).persist(_PERSIST)
    return latest


def _add_sequential_key(df, name, start):
    """
    Adds `name` = start+1 .. start+N, in parallel (no single-partition window).
    Per-partition counts give each partition an offset; monotonically_increasing_id
    gives the index inside the partition. Returns (keyed_df, row_count).

    `df` MUST be read from a persisted DataFrame (the staged source, or the
    cached Mode B join). Its partitions and row order are then fixed, so
    _pid/_mid -- and therefore the keys -- are identical on every read, and no
    separate persisted copy is needed to "freeze" them. The per-partition
    counts (one number per partition) are collected to the driver once.
    """
    base = (
        df.withColumn("_pid", spark_partition_id())
          .withColumn("_mid", monotonically_increasing_id())
    )

    counts = sorted(
        (r["_pid"], r["_cnt"])
        for r in base.groupBy("_pid").agg(spark_count(lit(1)).alias("_cnt")).collect()
    )
    offset_rows, running = [], 0
    for pid, cnt in counts:
        offset_rows.append((int(pid), int(running)))
        running += cnt
    offsets = spark.createDataFrame(offset_rows, "_pid INT, _off LONG")

    keyed = (
        base.join(broadcast(offsets), "_pid")
            .withColumn(
                name,
                lit(int(start)) + col("_off")
                + (col("_mid") - col("_pid").cast("long") * lit(1 << 33))
                + lit(1),
            )
            .drop("_pid", "_mid", "_off")
    )
    return keyed, running


def _active_target_count(target_table):
    """
    Exact active count (latest version per row_hash, not soft-deleted).
    Only used when exact_target_count=True; the normal path derives it from
    the change counts without rescanning history.
    """
    if not spark.catalog.tableExists(target_table):
        return 0

    df = spark.table(target_table)
    if "ROW_HASH" not in df.columns or "DW_UPDATED_AT" not in df.columns:
        return df.count()

    return (
        df.withColumn(
            "_rn",
            row_number().over(
                Window.partitionBy("ROW_HASH")
                      .orderBy(desc("DW_UPDATED_AT"), desc("BATCH_ID"))
            ),
        )
        .filter((col("_rn") == 1) & (coalesce(col("IS_DELETED"), lit(0)) == 0))
        .count()
    )


# ============================================================================
# deltaUpsertAndSync
# ============================================================================

def deltaUpsertAndSync(
    targetTable,
    sourceQuery,
    primaryKeys="",
    nonKeyColumns="",
    identityColumn=None,
    batchId=None,
    latestDf=None,
):
    """
    Appends new records, updates and soft deletes to a Delta table. Never
    removes rows.

    primaryKeys empty  -> row_hash over all business columns (mode A).
    primaryKeys given  -> row_hash over the PKs only, non-key columns compared
                          to detect updates (mode B).

    latestDf, if given, is the already-persisted latest-version-per-hash of the
    target (owned and unpersisted by the caller). Otherwise it is built here.

    Returns dict: inserted, updated, deleted, before_active, after_active.
    """
    # --- 1. Clean input parameters & strip system columns --------------------
    pkList = [k.lower() for k in _split_cols(primaryKeys)]
    nonPkList = [k.lower() for k in _split_cols(nonKeyColumns)]

    pkList = [c for c in pkList if c not in SYSTEM_COLS]
    nonPkList = [c for c in nonPkList if c not in SYSTEM_COLS]

    allColsList = list(dict.fromkeys(pkList + nonPkList))

    if not allColsList:
        raise ValueError(
            f"deltaUpsertAndSync: no columns to load for {targetTable}. "
            f"Pass primaryKeys and/or nonKeyColumns."
        )

    if CHG_TAG.lower() in allColsList:
        raise ValueError(
            f"deltaUpsertAndSync: {targetTable} has a column named '{CHG_TAG}', "
            f"which is reserved for internal change tracking. Rename it."
        )

    allColsStr = ", ".join(allColsList)
    identityLower = identityColumn.strip().lower() if identityColumn else None

    # --- 2. row_hash expression & attribute comparison -----------------------
    if pkList:
        if identityLower in pkList:
            raise ValueError(
                f"deltaUpsertAndSync: identity column '{identityColumn}' must not "
                f"be part of primaryKeys for {targetTable}."
            )

        pkConcat = ", ".join([f"coalesce(cast({c} as string), '')" for c in pkList])
        rowHashExpr = f"sha2(concat_ws('||', {pkConcat}), 256)"

        # <=> not <>: a single NULL must not silently disable update detection.
        nonPkCompares = [
            f"src.{c} <=> tgt.{c}" for c in nonPkList if c != identityLower
        ]
        attrChangeCheck = (
            f"OR NOT ({' AND '.join(nonPkCompares)})" if nonPkCompares else ""
        )
    else:
        hashCols = [c for c in allColsList if c != identityLower]
        if not hashCols:
            raise ValueError(
                f"deltaUpsertAndSync: {targetTable} has no business columns left "
                f"after excluding the identity column from the hash."
            )
        allConcat = ", ".join([f"coalesce(cast({c} as string), '')" for c in hashCols])
        rowHashExpr = f"sha2(concat_ws('||', {allConcat}), 256)"
        attrChangeCheck = ""

    srcSelectCols = ", ".join([f"src.{c}" for c in allColsList]) + ", src.row_hash"
    tgtSelectCols = ", ".join([f"tgt.{c}" for c in allColsList]) + ", tgt.row_hash"
    insertColsList = allColsList + ["row_hash", "is_deleted", "dw_updated_at", "batch_id"]
    insertCols = ", ".join(insertColsList)

    batchIdLiteral = "CAST(NULL AS BIGINT)" if batchId is None else str(batchId)

    # --- 3. Latest target version: computed once, shared ---------------------
    owns_latest = latestDf is None
    latest_df = _latest_target_df(targetTable) if owns_latest else latestDf
    latest_view = _safe_name("_latest_", targetTable)
    latest_df.createOrReplaceTempView(latest_view)

    changes_view = _safe_name("_chg_", targetTable)
    changes_df = None

    try:
        before_active = latest_df.filter(
            coalesce(col("is_deleted"), lit(0)) == 0
        ).count()

        # change_type: I = insert/revival, U = update of active entity, D = soft delete
        selectSql = f"""
    WITH staged_source AS (
        SELECT *,
            {rowHashExpr} AS row_hash
        FROM ({sourceQuery})
    ),
    latest_tgt AS (
        SELECT * FROM {latest_view}
    ),
    upserts AS (
        SELECT
            {srcSelectCols},
            0 AS is_deleted,
            current_timestamp() AS dw_updated_at,
            {batchIdLiteral} AS batch_id,
            CASE WHEN tgt.row_hash IS NOT NULL AND coalesce(tgt.is_deleted, 0) = 0
                 THEN 'U' ELSE 'I' END AS {CHG_TAG}
        FROM staged_source src
        LEFT JOIN latest_tgt tgt ON src.row_hash <=> tgt.row_hash
        WHERE tgt.row_hash IS NULL
           OR tgt.is_deleted = 1
           {attrChangeCheck}
    ),
    soft_deletes AS (
        SELECT
            {tgtSelectCols},
            1 AS is_deleted,
            current_timestamp() AS dw_updated_at,
            {batchIdLiteral} AS batch_id,
            'D' AS {CHG_TAG}
        FROM latest_tgt tgt
        LEFT JOIN staged_source src ON src.row_hash <=> tgt.row_hash
        WHERE src.row_hash IS NULL
          AND tgt.is_deleted = 0
    )
    SELECT * FROM upserts
    UNION ALL
    SELECT * FROM soft_deletes
    """

        mode = "natural-key" if pkList else "full-row-hash"
        print(f"Running sync for target table: {targetTable} [{mode} mode]...")

        # Evaluate the diff once, keep it, count it, then append it.
        changes_df = _repartition_for_size(spark.sql(selectSql)).persist(_PERSIST)
        counts = {
            r[CHG_TAG]: r["count"]
            for r in changes_df.groupBy(CHG_TAG).count().collect()
        }
        inserted = counts.get("I", 0)
        updated = counts.get("U", 0)
        deleted = counts.get("D", 0)

        if inserted + updated + deleted > 0:
            changes_df.createOrReplaceTempView(changes_view)
            # Explicit column list: same by-name behaviour as the original INSERT.
            spark.sql(
                f"INSERT INTO {targetTable} ({insertCols}) "
                f"SELECT {insertCols} FROM {changes_view}"
            )
        else:
            print("   No changes detected; nothing appended.")

        # Updates replace an active row, so they net to zero.
        after_active = before_active + inserted - deleted

        print("   --> Success!")
        print("-" * 75)

        return {
            "inserted": inserted,
            "updated": updated,
            "deleted": deleted,
            "before_active": before_active,
            "after_active": after_active,
        }
    finally:
        for v in (latest_view, changes_view):
            try:
                spark.catalog.dropTempView(v)
            except Exception:
                pass
        if changes_df is not None:
            changes_df.unpersist()
        if owns_latest:
            latest_df.unpersist()


# ============================================================================
# Generic Batch Control Table Schema
# ============================================================================

BATCH_SCHEMA = StructType([
    StructField("BATCH_ID", LongType(), True),
    StructField("PIPELINE_NAME", StringType(), False),
    StructField("TARGET_TABLE", StringType(), False),
    StructField("LOAD_TYPE", StringType(), True),
    StructField("BATCH_START_DTTM", TimestampType(), True),
    StructField("BATCH_END_DTTM", TimestampType(), True),
    StructField("STATUS", StringType(), True),
    StructField("SOURCE_RECORD_COUNT", LongType(), True),
    StructField("INSERTED_RECORD_COUNT", LongType(), True),
    StructField("UPDATED_RECORD_COUNT", LongType(), True),
    StructField("DELETED_RECORD_COUNT", LongType(), True),
    StructField("TOTAL_TARGET_COUNT", LongType(), True),
    StructField("ERROR_MESSAGE", StringType(), True),
    StructField("CREATED_BY", StringType(), True),
])


def _ensure_batch_table(batch_table):
    with _BATCH_LOCK:
        if batch_table in _ENSURED_BATCH_TABLES:
            return
        _ensure_batch_table_once(batch_table)
        _ENSURED_BATCH_TABLES.add(batch_table)


def _ensure_batch_table_once(batch_table):
    if not spark.catalog.tableExists(batch_table):
        print("Batch table does not exist. Creating:", batch_table)
        spark.createDataFrame([], BATCH_SCHEMA) \
            .write.format("delta").mode("overwrite").saveAsTable(batch_table)
        print("Batch table created successfully.")
        return

    existing_cols = {f.name for f in spark.table(batch_table).schema.fields}
    missing_fields = [f for f in BATCH_SCHEMA.fields if f.name not in existing_cols]

    if missing_fields:
        add_cols_ddl = ", ".join(
            f"{f.name} {f.dataType.simpleString()}" for f in missing_fields
        )
        print(f"Batch table is missing columns [{add_cols_ddl}]. Altering:", batch_table)
        spark.sql(f"ALTER TABLE {batch_table} ADD COLUMNS ({add_cols_ddl})")


def _write_batch_row(batch_table, row_values):
    df = spark.createDataFrame([row_values], schema=BATCH_SCHEMA)
    with _BATCH_LOCK:
        df.write.format("delta").mode("append") \
            .option("mergeSchema", "true").saveAsTable(batch_table)


def _update_batch_row(batch_table, batch_id, updates: dict):
    updates_with_id = dict(updates)
    updates_with_id["BATCH_ID"] = batch_id
    cols = list(updates_with_id.keys())

    # Schema built in the SAME order as `cols` so values zip to the right type.
    field_lookup = {f.name: f for f in BATCH_SCHEMA.fields}
    row_schema = StructType([field_lookup[c] for c in cols])

    row = spark.createDataFrame(
        [[updates_with_id[c] for c in cols]],
        schema=row_schema,
    )
    set_clause = {c: f"S.{c}" for c in cols if c != "BATCH_ID"}
    with _BATCH_LOCK:
        (
            DeltaTable.forName(spark, batch_table)
            .alias("T")
            .merge(row.alias("S"), "T.BATCH_ID = S.BATCH_ID")
            .whenMatchedUpdate(set=set_clause)
            .execute()
        )


# ============================================================================
# Generic Target Table Creation
# ============================================================================

def _create_target_table_if_missing(target_table, source_query):
    """
    Infers business columns from source_query's schema. Call AFTER
    _assign_surrogate_keys so the identity column is already in the schema.

    NOTE: skipped if target_table already exists with a different schema (legacy
    naming, or one predating IS_DELETED / BATCH_ID) -- reconcile by hand first.
    """
    if spark.catalog.tableExists(target_table):
        print(f"Target table already exists: {target_table}")
        return

    print(f"Target table does not exist. Creating: {target_table}")

    sample_df = spark.sql(source_query)   # schema only, no data scan
    business_cols_ddl = ",\n        ".join(
        f"{f.name} {f.dataType.simpleString()}" for f in sample_df.schema.fields
    )

    create_sql = f"""
    CREATE TABLE {target_table} (
        {business_cols_ddl},
        ROW_HASH STRING,
        IS_DELETED INT,
        DW_UPDATED_AT TIMESTAMP,
        BATCH_ID BIGINT
    )
    USING DELTA
    """
    spark.sql(create_sql)
    print(f"Target table created successfully: {target_table}")


# ============================================================================
# Primary key validation (runs against the cached source)
# ============================================================================

def _validate_primary_keys(source_query, pk_cols, target_table):
    """
    NULL keys collide with '' in the hash; duplicate keys share a row_hash and
    are appended every run. Both break mode B silently, so fail loudly.
    Source is already persisted, so these passes are cheap.
    """
    src = spark.sql(source_query)
    resolved = _resolve_cols(src, pk_cols, f"primary_keys for {target_table}")

    null_cond = reduce(lambda a, b: a | b, [col(c).isNull() for c in resolved])

    # One pass: group by the key once, then read both flags from the groups.
    # (NULL keys form their own group, so has_null is the same answer as the
    # old filter(...).limit(1) check, and max_cnt > 1 the same as the old
    # duplicate check. NULL is still reported first, as before.)
    chk = (
        src.groupBy(*resolved).count()
           .agg(
               spark_max(when(null_cond, 1).otherwise(0)).alias("has_null"),
               spark_max(col("count")).alias("max_cnt"),
           )
           .collect()[0]
    )
    if chk["has_null"] == 1:
        raise ValueError(
            f"{target_table}: primary_keys {resolved} contain NULLs in the source. "
            f"A NULL key cannot identify a row -- fix the source query or choose "
            f"a different key."
        )

    if (chk["max_cnt"] or 0) > 1:
        raise ValueError(
            f"{target_table}: primary_keys {resolved} are not unique in the source. "
            f"Run a GROUP BY ... HAVING COUNT(*) > 1 on the source query to see the "
            f"duplicates."
        )

    return resolved


# ============================================================================
# Surrogate Key Generation -- mode-aware
# ============================================================================

def _assign_surrogate_keys(source_query, target_table, identity_column, pk_cols):
    """
    Returns (effective_source_query, temp_view_name, cached_dfs, latest_df,
             source_count).

    Mode A (pk_cols empty) -- AUTO-INCREMENT
        Every source row gets a fresh key after the target's current max.
        Key identifies a row version, not an entity.

    Mode B (pk_cols given) -- LOOKUP THEN INCREMENT
        Rows whose PK already exists keep their key (stable across changes and
        soft-delete / revival). Only new PKs get new sequential values.

    Fabric's Spark SQL rejects GENERATED ALWAYS AS IDENTITY, so this is PySpark.
    Key generation is now parallel (partition offsets) rather than a single
    partition window.

    source_count is the exact row count of the returned source (same number
    the old separate count() gave), taken from counts this step already does.

    CONCURRENCY: the max-key read is racy; the stale / concurrent batch guard in
    run_batch_tracked_merge is what prevents two runs allocating the same range.

    latest_df is the persisted latest-version-per-hash of the target when it was
    built here (mode B, target has the key); the caller passes it to the sync and
    unpersists it. Otherwise None.
    """
    src_df = spark.sql(source_query)
    cached = []
    latest_df = None

    if identity_column in src_df.columns:
        raise ValueError(
            f"_assign_surrogate_keys: '{identity_column}' is already a column in "
            f"source_query for {target_table}. The identity column is generated "
            f"here and must not be selected by the source query."
        )

    target_has_key = (
        spark.catalog.tableExists(target_table)
        and identity_column in [f.name for f in spark.table(target_table).schema.fields]
    )

    max_key = 0
    if target_has_key:
        max_key = (
            spark.table(target_table)
            .agg(coalesce(spark_max(col(identity_column)), lit(0)).alias("m"))
            .collect()[0]["m"]
        )

    if not pk_cols:
        # ---- Mode A -----------------------------------------------------------
        # src_df reads the persisted staged source, so keys are stable.
        result_df, source_count = _add_sequential_key(src_df, identity_column, max_key)
    else:
        # ---- Mode B -----------------------------------------------------------
        resolved_pks = _resolve_cols(
            src_df, pk_cols, f"primary_keys for {target_table}"
        )

        if target_has_key:
            latest_df = _latest_target_df(target_table)
            existing_keys_df = (
                latest_df
                .select(*resolved_pks, identity_column)
                # A NULL identity (partial backfill) would duplicate the source row.
                .filter(col(identity_column).isNotNull())
                .distinct()
            )
        else:
            key_schema = StructType(
                [src_df.schema[p] for p in resolved_pks]
                + [StructField(identity_column, LongType(), True)]
            )
            existing_keys_df = spark.createDataFrame([], key_schema)

        # PKs validated non-NULL upstream, so the name-list equi-join is safe
        # and collapses the duplicated key columns.
        joined_df = (
            src_df.join(existing_keys_df, resolved_pks, "left")
        )
        joined_df = _repartition_for_size(joined_df).persist(_PERSIST)     # consumed twice below
        cached.append(joined_df)

        existing_rows_df = joined_df.filter(col(identity_column).isNotNull())
        new_raw_df = joined_df.filter(col(identity_column).isNull()).drop(identity_column)

        # new_raw_df reads the persisted joined_df, so keys are stable.
        new_rows_df, _ = _add_sequential_key(new_raw_df, identity_column, max_key)

        result_df = existing_rows_df.unionByName(new_rows_df)
        # existing + new = every row of joined_df (cached; cheap count).
        source_count = joined_df.count()

    # result_df is NOT persisted again: it is a fixed projection of cached data
    # (staged source / joined_df) plus a tiny broadcast offsets table, so each
    # read gives the same rows and keys without a third full copy in memory.

    view_name = _safe_name("_stg_", target_table)
    result_df.createOrReplaceTempView(view_name)

    return f"SELECT * FROM {view_name}", view_name, cached, latest_df, source_count


# ============================================================================
# Generic Batch-Tracked Pipeline Runner
# ============================================================================

def run_batch_tracked_merge(
    pipeline_name,
    target_table,
    batch_table,
    source_query,
    primary_keys,
    non_key_columns,
    identity_column=None,
    load_type="FULL",
    created_by="Fabric Notebook",
    allow_run_with_stale_running_batch=False,
    validate_primary_keys=True,
    exact_target_count=False,
):
    """
    Generic batch-tracked wrapper around deltaUpsertAndSync(). Call once per
    table. Works in both modes -- see the header.

    WARNING: deltaUpsertAndSync() soft-deletes, on every run, any entity absent
    from source_query. Only point this at a target whose source_query is the
    full, authoritative population every time it runs.

    identity_column, if given, is generated in PySpark by _assign_surrogate_keys.
    Do NOT include it in primary_keys or non_key_columns -- it is appended
    automatically and excluded from row_hash.

    exact_target_count=True recomputes TOTAL_TARGET_COUNT with a full window over
    history (old behaviour, expensive). Default derives it from the change counts,
    which is identical unless the SOURCE contains duplicate rows in mode A.
    """
    if load_type != "FULL":
        raise ValueError(
            f"{pipeline_name}: deltaUpsertAndSync soft-deletes rows absent from "
            f"source_query on every run, so only load_type='FULL' is supported. "
            f"Got '{load_type}'."
        )

    pk_cols = _split_cols(primary_keys)

    if identity_column:
        declared = {
            c.lower() for c in _split_cols(primary_keys + "," + non_key_columns)
        }
        if identity_column.strip().lower() in declared:
            raise ValueError(
                f"{pipeline_name}: identity_column '{identity_column}' must not "
                f"appear in primary_keys or non_key_columns; it is appended "
                f"automatically."
            )

    _ensure_batch_table(batch_table)

    batch_id = None
    temp_views = []
    cached_dfs = []
    latest_df = None

    try:
        # ---- Step 0 + 1: stale guard and next batch id, ONE query ---------
        # Held under _BATCH_LOCK together with the RUNNING row write below, so
        # parallel pipelines can never be handed the same BATCH_ID.
        _BATCH_LOCK.acquire()
        try:
            chk = (
                spark.table(batch_table)
                .agg(
                    spark_sum(
                        when((col("PIPELINE_NAME") == pipeline_name)
                             & (col("STATUS") == "RUNNING"), 1).otherwise(0)
                    ).alias("STALE_RUNNING"),
                    coalesce(spark_max(col("BATCH_ID")), lit(0)).alias("MAX_BATCH_ID"),
                )
                .collect()[0]
            )
            stale_running = chk["STALE_RUNNING"] or 0
            if stale_running > 0 and not allow_run_with_stale_running_batch:
                raise RuntimeError(
                    f"Found {stale_running} batch(es) already RUNNING for pipeline "
                    f"'{pipeline_name}'. Refusing to start a new run. Investigate "
                    f"{batch_table}, or pass allow_run_with_stale_running_batch=True."
                )

            batch_id = chk["MAX_BATCH_ID"] + 1
            batch_start = datetime.now()

            mode = "natural-key" if pk_cols else "full-row-hash"

            print("=" * 60)
            print("STARTING PIPELINE:", pipeline_name)
            print("Batch ID     :", batch_id)
            print("Target Table :", target_table)
            print("Match Mode   :", mode)
            print("Batch Start  :", batch_start)
            print("=" * 60)

            # ---- Step 2: RUNNING batch row ----------------------------------
            _write_batch_row(batch_table, [
                batch_id, pipeline_name, target_table, load_type,
                batch_start, None, "RUNNING",
                None, None, None, None, None, None,
                created_by,
            ])
        finally:
            _BATCH_LOCK.release()

        # ---- Step 3a: stage the source ONCE ---------------------------------
        staged_query, src_view, src_df = _stage_source(source_query, target_table)
        temp_views.append(src_view)
        cached_dfs.append(src_df)

        # ---- Step 3b: validate key, assign surrogate key, create target ------
        if pk_cols and validate_primary_keys:
            _validate_primary_keys(staged_query, pk_cols, target_table)

        effective_source_query = staged_query
        effective_non_key_columns = non_key_columns
        source_count = None

        if identity_column:
            (effective_source_query, key_view, key_cached, latest_df,
             source_count) = _assign_surrogate_keys(
                staged_query, target_table, identity_column, pk_cols
            )
            temp_views.append(key_view)
            cached_dfs.extend(key_cached)
            effective_non_key_columns = f"{non_key_columns}, {identity_column}"

        # Declared columns must cover the source query (a column-list INSERT
        # silently NULL-fills anything omitted).
        source_cols = {c.lower() for c in spark.sql(effective_source_query).columns}
        declared_cols = {
            c.lower()
            for c in _split_cols(primary_keys + "," + effective_non_key_columns)
        }
        undeclared = source_cols - declared_cols - SYSTEM_COLS
        if undeclared:
            raise ValueError(
                f"{pipeline_name}: columns present in source_query but not declared "
                f"in primary_keys / non_key_columns would be NULL-filled on insert: "
                f"{sorted(undeclared)}"
            )

        _create_target_table_if_missing(target_table, effective_source_query)

        # ---- Step 4: source count -----------------------------------------
        # Identity pipelines already have it from the key step (same number).
        if source_count is None:
            source_count = spark.sql(effective_source_query).count()
        print("Source Record Count:", source_count)

        # ---- Step 5: execute the sync ---------------------------------------
        result = deltaUpsertAndSync(
            targetTable=target_table,
            sourceQuery=effective_source_query,
            primaryKeys=primary_keys,
            nonKeyColumns=effective_non_key_columns,
            identityColumn=identity_column,
            batchId=batch_id,
            latestDf=latest_df,
        )

        inserted_count = result["inserted"]
        updated_count = result["updated"]
        deleted_count = result["deleted"]
        target_before_active = result["before_active"]
        target_after_active = (
            _active_target_count(target_table)
            if exact_target_count else result["after_active"]
        )

        print("=" * 60)
        print("SYNC COMPLETED")
        print("Source Records :", source_count)
        print("Inserted       :", inserted_count)
        print("Updated        :", updated_count)
        print("Deleted        :", deleted_count)
        print("Target After   :", target_after_active)
        print("=" * 60)

        # ---- Step 6: SUCCESS batch row --------------------------------------
        _update_batch_row(batch_table, batch_id, {
            "BATCH_END_DTTM": datetime.now(),
            "STATUS": "SUCCESS",
            "SOURCE_RECORD_COUNT": source_count,
            "INSERTED_RECORD_COUNT": inserted_count,
            "UPDATED_RECORD_COUNT": updated_count,
            "DELETED_RECORD_COUNT": deleted_count,
            "TOTAL_TARGET_COUNT": target_after_active,
            "ERROR_MESSAGE": None,
        })

        return {
            "batch_id": batch_id,
            "num_inserted_rows": inserted_count,
            "num_updated_rows": updated_count,
            "num_deleted_rows": deleted_count,
            "target_before_active": target_before_active,
            "target_after_active": target_after_active,
        }

    except Exception as e:
        print("PIPELINE FAILED:", pipeline_name, "-", str(e))

        if batch_id is not None:
            _update_batch_row(batch_table, batch_id, {
                "BATCH_END_DTTM": datetime.now(),
                "STATUS": "FAILED",
                "ERROR_MESSAGE": str(e),
            })
        else:
            print("Pipeline failed before batch record was created:", str(e))

        raise

    finally:
        for v in temp_views:
            try:
                spark.catalog.dropTempView(v)
            except Exception:
                pass
        for d in cached_dfs:
            try:
                d.unpersist()
            except Exception:
                pass
        if latest_df is not None:
            try:
                latest_df.unpersist()
            except Exception:
                pass


# ============================================================================
# Sequential runner -- one pipeline at a time, bounded resource use
# ============================================================================

def run_all_pipelines(
    pipeline_configs,
    continue_on_error=True,
    pause_seconds=0,
    optimize_after=False,
    clear_cache_between=True,
    tune_spark=True,
):
    """
    Runs the configs strictly one after another in this single Spark session, so
    total consumption is one session's worth instead of N overlapping ones.
    (Deliberately not threaded: concurrent runs would race on BATCH_ID and on
    surrogate-key max().)

    continue_on_error : a failed pipeline is logged and the loop moves on.
    pause_seconds     : idle gap between pipelines to smooth capacity spikes.
    optimize_after    : run OPTIMIZE on the target after a successful load
                        (extra compute; better done as a separate weekly job).
    """
    if tune_spark:
        configure_spark_for_efficiency()

    summary = {}
    total = len(pipeline_configs)

    for i, cfg in enumerate(pipeline_configs, start=1):
        name = cfg["pipeline_name"]
        print(f"\n##### [{i}/{total}] {name} #####")
        t0 = time.time()
        try:
            res = run_batch_tracked_merge(**cfg)
            summary[name] = {"status": "SUCCESS", **res,
                             "seconds": round(time.time() - t0, 1)}
            if optimize_after:
                print("Optimizing:", cfg["target_table"])
                spark.sql(f"OPTIMIZE {cfg['target_table']}")
        except Exception as e:
            summary[name] = {"status": "FAILED", "error": str(e),
                             "seconds": round(time.time() - t0, 1)}
            if not continue_on_error:
                raise
        finally:
            if clear_cache_between:
                spark.catalog.clearCache()

        if pause_seconds and i < total:
            time.sleep(pause_seconds)

    print("\n" + "=" * 60)
    print("RUN SUMMARY")
    for n, s in summary.items():
        print(f"  {n}: {s['status']} ({s['seconds']}s)")
    print("=" * 60)

    failed = [n for n, s in summary.items() if s["status"] == "FAILED"]
    if failed:
        print("Failed pipelines:", failed)

    return summary


